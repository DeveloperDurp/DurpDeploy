package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

// ScheduledDeploymentListItem carries the schedule row plus the display
// names the table needs (release version + environment name). Mirrors
// DeploymentListItem in deployments.templ.
type ScheduledDeploymentListItem struct {
	Schedule        db.ScheduledDeployment
	ReleaseVersion  string
	EnvironmentName string
	Offset          int64
}

templ ScheduledDeploymentsListPage(project db.Project, page ScheduleListPage, currentPath string) {
	@layouts.Base("Schedules - "+project.Name, currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
			{Label: "Schedules"},
		})
		@ScheduledDeploymentsContent(project, page)
	}
}

templ ScheduledDeploymentsContent(project db.Project, page ScheduleListPage) {
	<div class="space-y-6">
		<div class="page-header">
			<h1 class="text-3xl font-bold">Schedules — { project.Name }</h1>
			<div class="flex gap-2 ml-auto">
				if CanWrite(ctx) {
					<a href={ fmt.Sprintf("/projects/%d/schedules/new?offset=%d", project.ID, page.Offset) } class="btn btn-primary btn-sm">New Schedule</a>
				}
				<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
		</div>
		@ScheduledDeploymentsList(project, page)
	</div>
}

templ ScheduledDeploymentsList(project db.Project, page ScheduleListPage) {
	<div id="schedules-content" data-schedule-offset={ strconv.FormatInt(page.Offset, 10) }>
		if len(page.Items) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				<p class="text-gray-400">No schedules yet. Create one to run a release on a cron.</p>
			</div>
		} else {
			<table class="hidden! md:table! table table-zebra table-fixed w-full">
				<thead>
					<tr>
						<th class="w-auto">Schedule</th>
						<th class="w-1/6">Cron</th>
						<th class="hidden md:table-cell w-1/4">Next run</th>
						<th class="w-20">Enabled</th>
						<th class="w-48">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, item := range page.Items {
						@ScheduledDeploymentRow(project.ID, item)
					}
				</tbody>
			</table>
			<ul class="space-y-3 md:hidden" aria-label="Schedules" data-mobile-schedule-list>
				for _, item := range page.Items {
					@ScheduledDeploymentMobileRecord(project.ID, item)
				}
			</ul>
		}
		if page.Total > page.Limit {
			<nav class="flex flex-wrap items-center gap-4 mt-4" aria-label="Schedule pages">
				<span class="text-sm">{ fmt.Sprintf("%d–%d of %d", page.Offset+1, page.Offset+int64(len(page.Items)), page.Total) }</span>
				if page.Offset > 0 {
					<a class="link" href={ ScheduleListURL(project.ID, max(0, page.Offset-page.Limit)) }>Previous</a>
				}
				if page.Offset+int64(len(page.Items)) < page.Total {
					<a class="link" href={ ScheduleListURL(project.ID, page.Offset+page.Limit) }>Next</a>
				}
			</nav>
		}
	</div>
}

templ ScheduledDeploymentRow(projectID int64, item ScheduledDeploymentListItem) {
	<tr id={ fmt.Sprintf("schedule-row-%d", item.Schedule.ID) } x-data="{ editing: false }">
		<td class="truncate">
			<span class="font-medium">{ item.ReleaseVersion }</span>
			<span class="text-gray-500"> → </span>
			{ item.EnvironmentName }
		</td>
		<td class="truncate font-mono text-sm">{ item.Schedule.Cron }</td>
		<td class="hidden md:table-cell whitespace-nowrap">{ formatUnixTime(item.Schedule.NextRunAt) }</td>
		<td>
			if item.Schedule.Enabled == 1 {
				<span class="badge badge-success">On</span>
			} else {
				<span class="badge badge-ghost">Off</span>
			}
		</td>
		<td>
			<div class="flex flex-wrap gap-2">
				if CanWrite(ctx) {
					<button
						class="btn btn-xs btn-ghost"
						data-schedule-action="edit"
						x-on:click.capture="editing = true; $event.stopImmediatePropagation()"
						hx-get={ fmt.Sprintf("/projects/%d/schedules/%d/edit?offset=%d", projectID, item.Schedule.ID, item.Offset) }
						hx-target={ fmt.Sprintf("#schedule-row-%d", item.Schedule.ID) }
						hx-swap="outerHTML"
					>
						Edit
					</button>
					<button
						class="btn btn-xs btn-primary"
						data-schedule-action="toggle"
						hx-post={ fmt.Sprintf("/projects/%d/schedules/%d/toggle?offset=%d", projectID, item.Schedule.ID, item.Offset) }
						hx-target="#schedules-content"
						hx-swap="outerHTML"
						data-toast-success="Schedule toggled"
						data-toast-error="Failed to toggle schedule"
					>
						if item.Schedule.Enabled == 1 {
							Disable
						} else {
							Enable
						}
					</button>
					<button
						class="btn btn-xs btn-error"
						data-schedule-action="delete"
						hx-delete={ fmt.Sprintf("/projects/%d/schedules/%d?offset=%d", projectID, item.Schedule.ID, item.Offset) }
						hx-target="#schedules-content"
						hx-swap="outerHTML"
						hx-confirm="Delete this schedule?"
						data-toast-success="Schedule deleted"
						data-toast-error="Failed to delete schedule"
					>
						Delete
					</button>
				}
				if CanWrite(ctx) {
					<div x-cloak x-show="editing" data-desktop-schedule-edit={ strconv.FormatInt(item.Schedule.ID, 10) } class="basis-full mt-2">
						@ScheduledDeploymentQuickEditForm(projectID, item)
					</div>
				}
			</div>
		</td>
	</tr>
	if item.Schedule.Enabled == 0 && item.Schedule.LastError != "" {
		<tr data-schedule-last-error={ strconv.FormatInt(item.Schedule.ID, 10) }>
			<td colspan="5" class="bg-base-300/60 px-2 py-2">
				<div class="alert alert-warning text-sm" role="alert">
					<span>Disabled — { item.Schedule.LastError }</span>
				</div>
			</td>
		</tr>
	}
}

templ ScheduledDeploymentQuickEditForm(projectID int64, item ScheduledDeploymentListItem) {
	<form
		hx-put={ fmt.Sprintf("/projects/%d/schedules/%d?offset=%d", projectID, item.Schedule.ID, item.Offset) }
		hx-target="#schedules-content"
		hx-swap="outerHTML"
		data-toast-success="Schedule updated"
		data-toast-error="Failed to update schedule"
		class="space-y-3"
	>
		<input type="hidden" name="release_id" value={ strconv.FormatInt(item.Schedule.ReleaseID, 10) }/>
		<input type="hidden" name="environment_id" value={ strconv.FormatInt(item.Schedule.EnvironmentID, 10) }/>
		<input type="hidden" name="note" value={ item.Schedule.Note.String }/>
		<div class="form-control">
			<label class="label"><span class="label-text">Cron</span></label>
			<input type="text" name="cron" class="input input-bordered input-sm w-full" required value={ item.Schedule.Cron }/>
		</div>
		<label class="cursor-pointer flex items-center gap-2">
			if item.Schedule.Enabled == 1 {
				<input type="checkbox" name="enabled" class="checkbox checkbox-sm" value="true" checked/>
			} else {
				<input type="checkbox" name="enabled" class="checkbox checkbox-sm" value="true"/>
			}
			<span class="text-sm">Enabled</span>
		</label>
		<div class="flex flex-wrap gap-2">
			<button type="button" class="btn btn-ghost btn-xs" x-on:click="editing = false">Cancel</button>
			<button type="submit" class="btn btn-primary btn-xs">Save</button>
		</div>
	</form>
}

templ ScheduledDeploymentMobileRecord(projectID int64, item ScheduledDeploymentListItem) {
	<li class="card bg-base-200 p-4 space-y-3" data-mobile-schedule={ strconv.FormatInt(item.Schedule.ID, 10) } x-data="{ editing: false }">
		<div class="min-w-0">
			<p class="text-sm text-gray-400">Schedule</p>
			<h2 class="font-medium break-words">{ item.ReleaseVersion } → { item.EnvironmentName }</h2>
		</div>
		<dl class="space-y-2 text-sm">
			<div>
				<dt class="text-gray-400">Cron</dt>
				<dd class="font-mono break-all">{ item.Schedule.Cron }</dd>
			</div>
			<div>
				<dt class="text-gray-400">Next run</dt>
				<dd>{ formatUnixTime(item.Schedule.NextRunAt) }</dd>
			</div>
			<div>
				<dt class="text-gray-400">Enabled</dt>
				<dd>
					if item.Schedule.Enabled == 1 {
						<span class="badge badge-success">On</span>
					} else {
						<span class="badge badge-ghost">Off</span>
					}
				</dd>
			</div>
		</dl>
		if CanWrite(ctx) {
			<div class="flex flex-wrap gap-2">
				<button
					type="button"
					class="btn btn-xs btn-ghost"
					data-schedule-action="edit"
					x-on:click.capture="editing = true; $event.stopImmediatePropagation()"
					hx-get={ fmt.Sprintf("/projects/%d/schedules/%d/edit?offset=%d", projectID, item.Schedule.ID, item.Offset) }
					hx-target={ fmt.Sprintf("#schedule-row-%d", item.Schedule.ID) }
					hx-swap="outerHTML"
				>
					Edit
				</button>
				<button
					class="btn btn-xs btn-primary"
					data-schedule-action="toggle"
					hx-post={ fmt.Sprintf("/projects/%d/schedules/%d/toggle?offset=%d", projectID, item.Schedule.ID, item.Offset) }
					hx-target="#schedules-content"
					hx-swap="outerHTML"
					data-toast-success="Schedule toggled"
					data-toast-error="Failed to toggle schedule"
				>
					if item.Schedule.Enabled == 1 {
						Disable
					} else {
						Enable
					}
				</button>
				<button
					class="btn btn-xs btn-error"
					data-schedule-action="delete"
					hx-delete={ fmt.Sprintf("/projects/%d/schedules/%d?offset=%d", projectID, item.Schedule.ID, item.Offset) }
					hx-target="#schedules-content"
					hx-swap="outerHTML"
					hx-confirm="Delete this schedule?"
					data-toast-success="Schedule deleted"
					data-toast-error="Failed to delete schedule"
				>
					Delete
				</button>
			</div>
			<div x-cloak x-show="editing" data-mobile-schedule-edit={ strconv.FormatInt(item.Schedule.ID, 10) } class="card bg-base-100 p-3">
				@ScheduledDeploymentQuickEditForm(projectID, item)
			</div>
		}
		if item.Schedule.Enabled == 0 && item.Schedule.LastError != "" {
			<div class="alert alert-warning text-sm" role="alert" data-schedule-last-error={ strconv.FormatInt(item.Schedule.ID, 10) }>
				<span>Disabled — { item.Schedule.LastError }</span>
			</div>
		}
	</li>
}

templ ScheduledDeploymentFormPage(project db.Project, releases []db.Release, envs []AvailableEnv, schedule *db.ScheduledDeployment, errorMsg string, offset int64, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			scheduleFormPageTitle(schedule),
			scheduleFormPageVerb(schedule),
			"a schedule",
			ScheduleListURL(project.ID, offset),
			currentPath,
		)
	} else {
		@layouts.Base("Schedule - "+project.Name, currentPath) {
			@components.Breadcrumbs([]components.Crumb{
				{Label: "Home", Href: "/"},
				{Label: "Projects", Href: "/projects"},
				{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
				{Label: "Schedules", Href: ScheduleListURL(project.ID, offset)},
				{Label: scheduleLabel(schedule)},
			})
			@ScheduledDeploymentForm(project, releases, envs, schedule, errorMsg, offset)
		}
	}
}

func scheduleFormPageTitle(schedule *db.ScheduledDeployment) string {
	if !isEditingSchedule(schedule) {
		return "New schedule"
	}
	return "Edit schedule"
}

func scheduleFormPageVerb(schedule *db.ScheduledDeployment) string {
	if !isEditingSchedule(schedule) {
		return "create"
	}
	return "edit"
}

templ ScheduledDeploymentForm(project db.Project, releases []db.Release, envs []AvailableEnv, schedule *db.ScheduledDeployment, errorMsg string, offset int64) {
	<div id="form-container" class="card bg-base-200 p-4">
		<h3 class="text-lg font-bold mb-4">{ scheduleHeading(schedule) }</h3>
		if errorMsg != "" {
			<div class="alert alert-error mb-4">{ errorMsg }</div>
		}
		<form method="post" action={ fmt.Sprintf("%s?offset=%d", scheduleFormAction(project, schedule), offset) } class="space-y-4">
			<div class="form-control">
				<label class="label"><span class="label-text">Release</span></label>
				<select name="release_id" class="select select-bordered" required>
					<option value="">Select release</option>
					for _, rel := range releases {
						<option
							value={ strconv.FormatInt(rel.ID, 10) }
							if schedule != nil && rel.ID == schedule.ReleaseID {
								selected
							}
						>
							{ rel.Version }
						</option>
					}
				</select>
			</div>
			<div class="form-control">
				<label class="label"><span class="label-text">Environment</span></label>
				<select name="environment_id" class="select select-bordered" required>
					<option value="">Select env</option>
					for _, e := range envs {
						<option
							value={ strconv.FormatInt(e.Environment.ID, 10) }
							if schedule != nil && e.Environment.ID == schedule.EnvironmentID {
								selected
							}
						>
							{ e.Environment.Name }
						</option>
					}
				</select>
			</div>
			<div class="form-control">
				<label class="label"><span class="label-text">Cron</span></label>
				if schedule != nil {
					<input type="text" name="cron" class="input input-bordered" placeholder="0 0 * * *" required value={ schedule.Cron }/>
				} else {
					<input type="text" name="cron" class="input input-bordered" placeholder="0 0 * * *" required/>
				}
				<label class="label"><span class="label-text-alt">5-field standard cron (minute hour day month weekday). No descriptors, no TZ prefix.</span></label>
			</div>
			<div class="form-control">
				<label class="label"><span class="label-text">Note (optional)</span></label>
				<textarea name="note" class="textarea textarea-bordered" rows="2">{ scheduleNoteValue(schedule) }</textarea>
			</div>
			<div class="form-control">
				<label class="label cursor-pointer gap-2 justify-start">
					if schedule == nil || schedule.Enabled == 1 {
						<input type="checkbox" name="enabled" class="checkbox checkbox-sm" value="true" checked/>
					} else {
						<input type="checkbox" name="enabled" class="checkbox checkbox-sm" value="true"/>
					}
					<span class="label-text">Enabled</span>
				</label>
			</div>
			<div class="flex gap-2 justify-end">
				<a href={ ScheduleListURL(project.ID, offset) } class="btn btn-ghost">Cancel</a>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	</div>
}

func scheduleLabel(schedule *db.ScheduledDeployment) string {
	if isEditingSchedule(schedule) {
		return "Edit"
	}
	return "New"
}

func scheduleHeading(schedule *db.ScheduledDeployment) string {
	if isEditingSchedule(schedule) {
		return "Edit Schedule"
	}
	return "New Schedule"
}

func scheduleFormAction(project db.Project, schedule *db.ScheduledDeployment) string {
	if isEditingSchedule(schedule) {
		return fmt.Sprintf("/projects/%d/schedules/%d", project.ID, schedule.ID)
	}
	return fmt.Sprintf("/projects/%d/schedules", project.ID)
}

func isEditingSchedule(schedule *db.ScheduledDeployment) bool {
	return schedule != nil && schedule.ID != 0
}

func scheduleNoteValue(schedule *db.ScheduledDeployment) string {
	if schedule != nil && schedule.Note.Valid {
		return schedule.Note.String
	}
	return ""
}

type ScheduleListPage struct {
	Items  []ScheduledDeploymentListItem
	Offset int64
	Limit  int64
	Total  int64
}

func ScheduleListURL(projectID, offset int64) string {
	if offset == 0 {
		return fmt.Sprintf("/projects/%d/schedules", projectID)
	}
	return fmt.Sprintf("/projects/%d/schedules?offset=%d", projectID, offset)
}
