package pages

import (
	"database/sql"
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
	"net/url"
	"strconv"
	"time"
)

type DeploymentListItem struct {
	Deployment      db.Deployment
	ProjectName     string
	ReleaseVersion  string
	EnvironmentName string
}

// DeploymentsView is the full state the deployments page needs to render the
// filter bar, table, and "Load more" affordance. Handler builds this once.
type DeploymentsView struct {
	Items         []DeploymentListItem
	Total         int64
	Limit         int64
	Offset        int64
	FilterProject sql.NullInt64
	FilterEnv     sql.NullInt64
	FilterStatus  sql.NullString
	FilterFrom    sql.NullInt64
	FilterTo      sql.NullInt64
	Projects      []db.Project
	Envs          []db.Environment
}

templ DeploymentsListPage(view DeploymentsView, currentPath string) {
	@layouts.Base("Deployments", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Deployments"},
		})
		@DeploymentsContent(view)
	}
}

templ DeploymentsContent(view DeploymentsView) {
	<div class="space-y-6">
		<div class="page-header">
			<h1 class="text-3xl font-bold">Deployments</h1>
		</div>
		@DeploymentsFilterBar(view)
		@DeploymentsList(view, false)
	</div>
}

templ DeploymentsFilterBar(view DeploymentsView) {
	<div x-data="{ open: false }" class="space-y-2">
		<button type="button" class="btn btn-ghost md:hidden" @click="open = !open" aria-expanded="false" :aria-expanded="open" aria-controls="deployment-filters">
			<span x-text="open ? 'Hide filters' : 'Filters'">Filters</span>
			if view.FilterProject.Valid || view.FilterEnv.Valid || view.FilterStatus.Valid || view.FilterFrom.Valid || view.FilterTo.Valid {
				<span class="badge badge-primary">Active</span>
			}
		</button>
	<form id="deployment-filters" method="get" action="/deployments" class="hidden grid grid-cols-2 md:!flex md:flex-wrap gap-2 items-end" :class="{ hidden: !open }">
		<label class="form-control min-w-0 col-span-2 md:col-span-1">
			<span class="label-text">Project</span>
			<select name="project_id" class="select select-bordered md:select-sm w-full">
				<option value="">All</option>
				for _, p := range view.Projects {
					<option
						value={ strconv.FormatInt(p.ID, 10) }
						if view.FilterProject.Valid && view.FilterProject.Int64 == p.ID {
							selected
						}
					>{ p.Name }</option>
				}
			</select>
		</label>
		<label class="form-control min-w-0 col-span-2 md:col-span-1">
			<span class="label-text">Environment</span>
			<select name="env_id" class="select select-bordered md:select-sm w-full">
				<option value="">All</option>
				for _, e := range view.Envs {
					<option
						value={ strconv.FormatInt(e.ID, 10) }
						if view.FilterEnv.Valid && view.FilterEnv.Int64 == e.ID {
							selected
						}
					>{ e.Name }</option>
				}
			</select>
		</label>
		<label class="form-control min-w-0 col-span-2 md:col-span-1">
			<span class="label-text">Status</span>
			<select name="status" class="select select-bordered md:select-sm w-full">
				<option value="">All</option>
				<option value="queued" selected?={ view.FilterStatus.String == "queued" }>queued</option>
				<option value="pending" if view.FilterStatus.String == "pending" { selected }>pending</option>
				<option value="pending_approval" selected?={ view.FilterStatus.String == "pending_approval" }>pending_approval</option>
				<option value="running" if view.FilterStatus.String == "running" { selected }>running</option>
				<option value="succeeded" if view.FilterStatus.String == "succeeded" { selected }>succeeded</option>
				<option value="failed" if view.FilterStatus.String == "failed" { selected }>failed</option>
				<option value="cancelled" if view.FilterStatus.String == "cancelled" { selected }>cancelled</option>
				<option value="publishing_artifact" selected?={ view.FilterStatus.String == "publishing_artifact" }>publishing_artifact</option>
				<option value="awaiting_artifact_approval" selected?={ view.FilterStatus.String == "awaiting_artifact_approval" }>awaiting_artifact_approval</option>
				<option value="rejected" selected?={ view.FilterStatus.String == "rejected" }>rejected</option>
				<option value="expired" selected?={ view.FilterStatus.String == "expired" }>expired</option>
			</select>
		</label>
		<label class="form-control min-w-0">
			<span class="label-text">From</span>
			<input type="date" name="from" value={ filterFromDate(view.FilterFrom) } class="input input-bordered md:input-sm w-full min-w-0"/>
		</label>
		<label class="form-control min-w-0">
			<span class="label-text">To</span>
			<input type="date" name="to" value={ filterToDate(view.FilterTo) } class="input input-bordered md:input-sm w-full min-w-0"/>
		</label>
		<button type="submit" class="btn md:btn-sm btn-primary">Filter</button>
		<a href="/deployments" class="btn md:btn-sm btn-ghost">Clear</a>
	</form>
	</div>
}

templ DeploymentsList(view DeploymentsView, appendRows bool) {
	if appendRows {
		for _, item := range view.Items {
			@DeploymentListRow(item)
		}
		@LoadMoreRegionOOB(view)
	} else {
		<div id="deployments-content">
			if len(view.Items) == 0 {
				<div class="card bg-base-200 p-8 text-center">
					<p class="text-gray-400">No deployments yet. Deploy a release to see results here.</p>
				</div>
			} else {
				@DeploymentListCards(view)
			}
		</div>
	}
}

templ DeploymentListCards(view DeploymentsView) {
	<div id="deployments-tbody" class="space-y-3">
		for _, item := range view.Items {
			@DeploymentListRow(item)
		}
	</div>
	<div id="load-more-region">
		if hasMoreDeployments(view) {
			@LoadMoreButton(loadMoreURL(view))
		}
	</div>
}

templ DeploymentListRow(item DeploymentListItem) {
	<div data-deployment-id={ strconv.FormatInt(item.Deployment.ID, 10) }>
		@ResourceCard(item.ProjectName, fmt.Sprintf("/deployments/%d", item.Deployment.ID)) {
			<dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
				<div class="min-w-0"><dt class="text-xs opacity-70 mb-1">Version</dt><dd>{ item.ReleaseVersion }</dd></div>
				<div class="min-w-0"><dt class="text-xs opacity-70 mb-1">Environment</dt><dd>{ item.EnvironmentName }</dd></div>
				<div class="min-w-0"><dt class="text-xs opacity-70 mb-1">Status</dt><dd>@StatusBadge(item.Deployment)</dd></div>
				<div class="min-w-0"><dt class="text-xs opacity-70 mb-1">Date</dt><dd>{ formatUnixTime(item.Deployment.CreatedAt) }</dd></div>
			</dl>
		}
	</div>
}

templ LoadMoreButton(url string) {
	<button
		class="btn md:btn-sm btn-ghost mt-2"
		hx-get={ templ.URL(url) }
		hx-target="#deployments-tbody"
		hx-swap="beforeend"
		hx-trigger="click"
		hx-indicator="#load-more-spinner"
	>
		Load more
	</button>
	<span id="load-more-spinner" class="loading loading-spinner loading-sm ml-2 htmx-indicator"></span>
}

templ LoadMoreRegionOOB(view DeploymentsView) {
	<div id="load-more-region" hx-swap-oob="outerHTML">
		if hasMoreDeployments(view) {
			@LoadMoreButton(loadMoreURL(view))
		}
	</div>
}

func hasMoreDeployments(view DeploymentsView) bool {
	return view.Offset+int64(len(view.Items)) < view.Total
}

func loadMoreURL(view DeploymentsView) string {
	v := url.Values{}
	if view.FilterProject.Valid {
		v.Set("project_id", strconv.FormatInt(view.FilterProject.Int64, 10))
	}
	if view.FilterEnv.Valid {
		v.Set("env_id", strconv.FormatInt(view.FilterEnv.Int64, 10))
	}
	if view.FilterStatus.Valid {
		v.Set("status", view.FilterStatus.String)
	}
	if view.FilterFrom.Valid {
		v.Set("from", unixToDate(view.FilterFrom.Int64))
	}
	if view.FilterTo.Valid {
		v.Set("to", unixToDate(view.FilterTo.Int64))
	}
	v.Set("limit", strconv.FormatInt(view.Limit, 10))
	v.Set("offset", strconv.FormatInt(view.Offset+view.Limit, 10))
	return "/deployments?" + v.Encode()
}

func filterFromDate(v sql.NullInt64) string {
	if !v.Valid {
		return ""
	}
	return time.Unix(v.Int64, 0).UTC().Format("2006-01-02")
}

func filterToDate(v sql.NullInt64) string {
	if !v.Valid {
		return ""
	}
	// Stored as end-of-day; render the calendar day it covers.
	return time.Unix(v.Int64, 0).UTC().Format("2006-01-02")
}

func unixToDate(t int64) string {
	return time.Unix(t, 0).UTC().Format("2006-01-02")
}

func statusBadgeClass(status string) string {
	switch status {
	case "pending", "queued":
		return "badge-primary"
	case "awaiting_artifact_approval", "publishing_artifact":
return "badge-warning"
case "rejected", "expired":
return "badge-error"
case "pending_approval":
		return "badge-info"
	case "running":
		return "badge-warning"
	case "succeeded":
		return "badge-success"
	case "failed":
		return "badge-error"
	case "cancelled":
		return "badge-ghost"
	default:
		return "badge-ghost"
	}
}

func isTerminalStatus(status string) bool {
	switch status {
	case "succeeded", "failed", "cancelled", "rejected", "expired", "cleanup_unconfirmed":
		return true
	default:
		return false
	}
}

templ StatusBadge(deployment db.Deployment) {
	<span class={ fmt.Sprintf("badge max-w-full h-auto whitespace-normal break-all %s", statusBadgeClass(deployment.Status)) }>
		{ deployment.Status }
	</span>
}

templ StatusBadgeContainer(deployment db.Deployment, waitingForAgents bool) {
	<div
		id="status-badge"
		data-deployment-status={ deployment.Status }
		class="flex flex-wrap items-center gap-2"
		hx-get={ fmt.Sprintf("/deployments/%d/status", deployment.ID) }
		if isTerminalStatus(deployment.Status) {
			hx-trigger="none"
		} else {
			hx-trigger="every 3s"
		}
		hx-swap="outerHTML"
		aria-live="polite"
	>
		if isTerminalStatus(deployment.Status) {
			<span id="deployment-cancel" hx-swap-oob="delete"></span>
		}
		if waitingForAgents {
			<span class="badge badge-warning">Waiting for agents</span>
		} else {
			@StatusBadge(deployment)
		}
		@DeploymentQueueStatus()
	</div>
}

templ DeploymentActions(deployment db.Deployment, outOfBand bool) {
	<div
		id="deployment-actions"
		class="flex flex-wrap items-center gap-2"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		if CanWrite(ctx) {
			if isTerminalStatus(deployment.Status) {
				<button
					class="btn btn-primary sm:btn-sm"
					hx-post={ fmt.Sprintf("/deployments/%d/redeploy", deployment.ID) }
					hx-confirm="Re-run this deployment with the same release and environment?"
					hx-disable-elt
					data-toast-success="Re-run started"
					data-toast-error="Failed to re-run"
				>
					Re-run
				</button>
			}
			if deployment.Status == "pending_approval" {
				<button
					class="btn btn-success sm:btn-sm"
					hx-post={ fmt.Sprintf("/deployments/%d/approve", deployment.ID) }
					hx-confirm="Approve this deployment and start the runner?"
					hx-disable-elt
					data-toast-success="Deployment approved"
					data-toast-error="Failed to approve"
				>
					Approve
				</button>
			}
			if deployment.Status == "running" || deployment.Status == "publishing_artifact" || deployment.Status == "awaiting_artifact_approval" || deployment.Status == "pending_approval" || deployment.Status == "queued" || deployment.Status == "pending" {
				<button
					id="deployment-cancel"
					class="btn btn-error sm:btn-sm"
					hx-post={ fmt.Sprintf("/deployments/%d/cancel", deployment.ID) }
					hx-target="#status-badge"
					hx-swap="outerHTML"
					data-toast-success="Cancellation requested"
					data-toast-error="Failed to cancel deployment"
				>
					Cancel
				</button>
			}
		}
		<details class="dropdown dropdown-end ml-auto" data-focus-menu @click.outside="$el.open = false">
			<summary class="btn btn-ghost sm:btn-sm">More</summary>
			<ul class="dropdown-content menu bg-base-200 rounded-box z-[1] w-44 p-2 shadow">
				<li><a href={ fmt.Sprintf("/deployments/%d/logs.txt", deployment.ID) } class="min-h-12 sm:min-h-0">Export logs</a></li>
				if CanWrite(ctx) && (deployment.Status == "succeeded" || deployment.Status == "failed" || deployment.Status == "cancelled") {
					<li><a href={ fmt.Sprintf("/deployments/%d/rollback", deployment.ID) } class="min-h-12 sm:min-h-0">Rollback</a></li>
				}
			</ul>
		</details>
	</div>
}

templ DeploymentStatusUpdate(deployment db.Deployment, waitingForAgents bool) {
	@StatusBadgeContainer(deployment, waitingForAgents)
	@DeploymentActions(deployment, true)
}

templ DeploymentDetailPage(project db.Project, release db.Release, environment db.Environment, deployment db.Deployment, logs []db.DeploymentLog, waitingForAgents bool, currentPath string) {
	@layouts.Base(fmt.Sprintf("Deployment %d", deployment.ID), currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Deployments", Href: "/deployments"},
			{Label: fmt.Sprintf("#%d", deployment.ID)},
		})
		@DeploymentDetail(project, release, environment, deployment, logs, waitingForAgents)
	}
}

templ DeploymentDetail(project db.Project, release db.Release, environment db.Environment, deployment db.Deployment, logs []db.DeploymentLog, waitingForAgents bool) {
	{{ logView := deploymentLogPanels(release, deployment, logs) }}
	<div class="space-y-6" x-data={ fmt.Sprintf("deploymentStepLogs({ url: '/deployments/%d/logs/stream?format=structured', status: %q, view: %s })", deployment.ID, deployment.Status, deploymentLogConfig(logView)) } x-on:htmx:after-swap.camel.window="statusChanged($event)">
		if warning := artifactDecisionWarning(ctx); warning != "" {
			<div class="alert alert-warning" role="alert" data-artifact-decision-warning>{ warning }</div>
		}
		<div class="space-y-4">
			<div class="page-header">
				<div class="flex flex-wrap items-center gap-2 min-w-0">
					<h1 class="text-3xl font-bold break-words">Deployment #{ strconv.FormatInt(deployment.ID, 10) }</h1>
					@StatusBadgeContainer(deployment, waitingForAgents)
				</div>
				<a href={ fmt.Sprintf("/projects/%d/releases/%d", project.ID, release.ID) } class="btn btn-ghost sm:btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
			<p class="font-medium break-words" role="status" x-text="activeStepText()">{ deploymentActiveStepLabel(logView, deployment.Status) }</p>
			<dl class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 text-sm">
				<div class="flex gap-2 sm:block min-w-0">
					<dt class="w-24 shrink-0 sm:w-auto opacity-70">Project</dt>
					<dd class="min-w-0 break-all">{ project.Name }</dd>
				</div>
				<div class="flex gap-2 sm:block min-w-0">
					<dt class="w-24 shrink-0 sm:w-auto opacity-70">Release</dt>
					<dd class="min-w-0 break-all">{ release.Version }</dd>
				</div>
				<div class="flex gap-2 sm:block min-w-0">
					<dt class="w-24 shrink-0 sm:w-auto opacity-70">Environment</dt>
					<dd class="min-w-0 break-all">{ environment.Name }</dd>
				</div>
			</dl>
			if deployment.Note.Valid {
				<blockquote class="bg-base-200 rounded-box p-4 text-sm break-words italic">
					{ deployment.Note.String }
				</blockquote>
			}
			@DeploymentActions(deployment, false)
		</div>
		<div hx-get={ fmt.Sprintf("/deployments/%d/artifact-gates", deployment.ID) } hx-trigger="load" hx-swap="outerHTML" data-artifact-gates aria-live="polite"></div>
		<section class="space-y-4" aria-label="Step logs">
			<h2 class="text-xl font-bold">Step logs</h2>
			for position, panel := range logView.Panels {
				<details
					class="bg-base-200 rounded-box p-4"
					data-step-index={ strconv.Itoa(panel.Index) }
					open?={ panel.Open }
					if panel.Index == -1 {
						if len(panel.Logs) == 0 {
							style="display:none"
						}
						x-show={ fmt.Sprintf("panels[%d].live.length > 0 || %t", position, len(panel.Logs) > 0) }
					}
				>
					<summary class="cursor-pointer font-medium break-words min-h-12 sm:min-h-0">
						if panel.Index >= 0 {
							<span>Step { strconv.Itoa(panel.Index+1) }: </span>
						}
						{ panel.Name }
						if panel.Index >= 0 {
							<span class="badge badge-outline ml-2" x-text={ fmt.Sprintf("stateLabel(panels[%d].state)", position) } x-bind:class={ fmt.Sprintf("{ 'badge-info': panels[%d].state === 'running', 'badge-error': panels[%d].state === 'failed' }", position, position) }>{ deploymentStepStateLabel(panel.State) }</span>
						}
					</summary>
					<div class="mt-4 space-y-1 overflow-x-auto">
						for _, log := range panel.Logs {
							<div class="font-mono text-sm whitespace-pre-wrap break-words" data-log-id={ strconv.FormatInt(log.ID, 10) }>
								<span class="text-gray-500">[{ formatUnixTime(log.CreatedAt) }] </span>
								if log.StepName.Valid && log.StepName.String != panel.Name {
									<span class="text-accent">[{ log.StepName.String }] </span>
								}
								<span x-init="renderLogLine($el)">
									{ log.Line }
								</span>
							</div>
						}
						<template x-for={ fmt.Sprintf("entry in panels[%d].live", position) } x-bind:key="entry.id">
							<div class="font-mono text-sm whitespace-pre-wrap break-words" x-bind:data-log-id="entry.id" x-effect="renderEntry($el, entry)"></div>
						</template>
						if len(panel.Logs) == 0 {
							<p class="text-gray-500 italic" x-show={ fmt.Sprintf("panels[%d].live.length === 0", position) }>No output yet.</p>
						}
					</div>
				</details>
			}
		</section>
		<div hx-get={ fmt.Sprintf("/deployments/%d/verification", deployment.ID) } hx-trigger="load" hx-swap="outerHTML" aria-live="polite"></div>
	</div>
}
