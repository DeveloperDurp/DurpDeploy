package pages

import "durpdeploy/views/layouts"
import "durpdeploy/internal/auth"

// ViewerForbiddenMessage is the standard "viewers can't do this"
// page. Rendered in place of a form when a viewer navigates to a
// write URL by hand (the New / Edit buttons that would normally
// lead here are already hidden by CanWrite, so this is the
// "you typed the URL" path). action is the verb the viewer tried
// ("create", "edit"), what is the noun ("a project", "a step"),
// backHref is the parent-page fallback when no browser history exists.
//
// ponytail: one component instead of one-per-form so the message
// wording stays consistent and the "Go back" affordance is uniform.
templ ViewerForbiddenMessage(title string, action string, what string, backHref string, currentPath string) {
	@RoleForbiddenMessage(title, action, what, backHref, currentPath, "maintainer") {
		{ children... }
	}
}

templ RoleForbiddenMessage(title string, action string, what string, backHref string, currentPath string, requiredRole string) {
	@layouts.Base(title, currentPath) {
		<div class="max-w-xl">
			<div class="card bg-base-200 shadow">
				<div class="card-body">
					<h1 class="card-title text-2xl">{ title }</h1>
					<p>
						if auth.RoleFromContext(ctx) == "viewer" {
							Viewers cannot { action } { what }.
						} else {
							Your role cannot { action } { what }.
						}
					</p>
					@PermissionHelp(requiredRole)
					<div class="card-actions justify-end">
						<a href={ templ.SafeURL(backHref) } class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Go back</a>
					</div>
				</div>
			</div>
		</div>
		{ children... }
	}
}

templ PermissionHelp(requiredRole string) {
	for _, help := range auth.RoleRecoveryHelp(ctx, requiredRole) {
		<p class="text-sm">
			{ help.Message } <a class="link" href={ templ.SafeURL(help.Href) }>{ help.Label }</a>.
		</p>
	}
}

templ ProjectPermissionSummary() {
	if user := auth.UserFromContext(ctx); user != nil {
		<div class="text-sm space-y-2 mb-4" data-project-permissions>
			<p>Effective project role: <strong>{ auth.ProjectRoleFromContext(ctx) }</strong>.</p>
			<p>
				Global role: { user.Role }.
				if member := auth.MembershipRoleFromContext(ctx); member != "" {
					Project role: { member }. The lower role sets your project permissions.
				} else if user.Role == "admin" {
					Global administrators bypass project membership.
				}
			</p>
			if !CanWrite(ctx) {
				<p>Content authoring and project settings require Maintainer or Admin access at both levels.</p>
				@PermissionHelp("maintainer")
			}
		</div>
	}
}
