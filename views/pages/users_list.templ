package pages

import (
	"durpdeploy/internal/auth"
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"fmt"
)

templ UsersListPage(
	users []db.ListUsersRow,
	currentUser *db.User,
	currentPath string,
) {
	@layouts.Base("Users", currentPath) {
		<div class="flex justify-between items-center mb-4">
			<h1 class="text-3xl font-bold">Users</h1>
			if CanWrite(ctx) {
				<a href="/admin/users/new" class="btn btn-primary btn-sm">New user</a>
			}
		</div>
		if len(users) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				<p class="text-gray-400">No users yet.</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="table table-zebra table-fixed w-full">
					<thead>
						<tr>
							<th class="w-1/4">Email</th>
							<th class="w-1/5">Name</th>
							<th class="w-1/6">Role</th>
							<th class="w-1/6 hidden sm:table-cell">Created</th>
							<th class="w-1/6 hidden md:table-cell">Last login</th>
							<th class="w-48">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							@usersListRow(u, currentUser)
						}
					</tbody>
				</table>
			</div>
			if CanWrite(ctx) {
				for _, u := range users {
					if currentUser == nil || currentUser.ID != u.ID {
						@MFAResetConfirmationDialog(u)
					}
				}
			}
		}
	}
}

templ usersListRow(u db.ListUsersRow, currentUser *db.User) {
	<tr>
		<td class="truncate font-mono text-sm">{ u.Email }</td>
		<td class="truncate">{ u.Name }</td>
		<td>
			<span class="badge badge-outline">{ u.Role }</span>
		</td>
		<td class="whitespace-nowrap text-sm hidden sm:table-cell">
			{ formatUnixTime(u.CreatedAt) }
		</td>
		<td class="whitespace-nowrap text-sm hidden md:table-cell">
			if u.LastLoginAt.Valid {
				{ formatUnixTime(u.LastLoginAt.Int64) }
			} else {
				<span class="text-gray-500">never</span>
			}
		</td>
		<td class="whitespace-nowrap">
			if CanWrite(ctx) {
				<a href={ fmt.Sprintf("/admin/users/%d/edit", u.ID) } class="btn btn-ghost btn-xs">Edit</a>
				if currentUser == nil || currentUser.ID != u.ID {
					<form
						method="post"
						action={ fmt.Sprintf("/admin/users/%d/mfa-reset", u.ID) }
						class="inline"
						data-mfa-reset-dialog={ fmt.Sprintf("mfa-reset-dialog-%d", u.ID) }
					>
						if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
							<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
						}
						<input type="hidden" name="reason" value="administrative_reset"/>
						<button
							type="submit"
							class="btn btn-warning btn-xs"
							data-mfa-reset-opener
						>
							Reset MFA
						</button>
					</form>
					<button
						class="btn btn-error btn-xs"
						hx-delete={ fmt.Sprintf("/admin/users/%d", u.ID) }
						hx-confirm={ fmt.Sprintf("Delete user %s? They will be unable to log in.", u.Email) }
						data-toast-success="User deleted"
						data-toast-error="Failed to delete user"
					>
						Delete
					</button>
				}
			}
		</td>
	</tr>
}

templ MFAResetConfirmationDialog(u db.ListUsersRow) {
	<dialog
		id={ fmt.Sprintf("mfa-reset-dialog-%d", u.ID) }
		class="modal"
		aria-labelledby={ fmt.Sprintf("mfa-reset-title-%d", u.ID) }
		aria-describedby={ fmt.Sprintf("mfa-reset-description-%d", u.ID) }
		data-mfa-reset-confirmation-dialog
	>
		<div class="modal-box w-11/12 max-w-lg bg-base-200">
			<h2 id={ fmt.Sprintf("mfa-reset-title-%d", u.ID) } class="text-lg font-bold">
				Reset MFA for { u.Name }
			</h2>
			<p id={ fmt.Sprintf("mfa-reset-description-%d", u.ID) } class="mt-2 text-sm opacity-70">
				This removes the user's authenticator factors and recovery codes. They will need to enroll MFA again.
			</p>
			<p class="mt-4 text-sm">
				Target: <span class="font-mono">{ u.Email }</span>
			</p>
			<form
				id={ fmt.Sprintf("mfa-reset-confirm-form-%d", u.ID) }
				method="post"
				action={ fmt.Sprintf("/admin/users/%d/mfa-reset", u.ID) }
				data-mfa-reset-confirmation
			>
				if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
					<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
				}
				<input type="hidden" name="reason" value="administrative_reset"/>
			</form>
			<div class="modal-action">
				<form method="dialog">
					<button type="submit" class="btn btn-ghost" autofocus>Cancel</button>
				</form>
				<button
					type="submit"
					form={ fmt.Sprintf("mfa-reset-confirm-form-%d", u.ID) }
					class="btn btn-error"
					data-mfa-reset-confirm
				>
					Confirm reset
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit" aria-label="Cancel MFA reset"></button>
		</form>
	</dialog>
}
