package components

import (
	"context"

	"durpdeploy/internal/auth"
	"durpdeploy/internal/db"
	"fmt"
	"strconv"
)

// canWrite mirrors views/pages.CanWrite but lives in this package.
// False for viewers. The context.Context is passed in by the caller
// (templ component body) because Go helper functions don't share the
// implicit `ctx` that templ injects into component scope.
func canWrite(ctx context.Context) bool {
	u := auth.UserFromContext(ctx)
	return u == nil || u.Role != "viewer"
}

func stepExecutionTarget(step db.Step) string {
	if step.ExecutionTarget == "agent" {
		return "agent"
	}
	return "local"
}

func stepInputID(step db.Step, isNew bool, field string) string {
	if isNew {
		return "new-step-" + field
	}
	return fmt.Sprintf("step-%d-%s", step.ID, field)
}

func stepPlacementData(step db.Step, selectedLabel string) string {
	return fmt.Sprintf(
		"stepPlacement(%s, %s)",
		strconv.Quote(stepExecutionTarget(step)),
		strconv.Quote(selectedLabel),
	)
}

// ViewerStepFormMessage is the inline "viewers can't edit steps"
// fragment. Rendered in place of StepForm when a viewer hits a
// direct URL that the Add Step / Edit buttons would have produced.
// (The Add Step / Edit buttons are already hidden by views/pages'
// CanWrite guards; this is the typed-URL fallback.)
//
// ponytail: inline fragment, not a full page — StepForm is rendered
// into a #add-step-form or #step-row-{id} div via HTMX swap, not as
// a standalone page.
templ ViewerStepFormMessage() {
	<div class="p-4 border border-base-300 rounded bg-base-200 text-sm text-gray-400 italic">
		Viewers cannot create or edit steps.
	</div>
}

templ StepForm(step db.Step, projectID int64, isNew bool, labels []string, selectedLabel string, errorMsg string) {
	if !canWrite(ctx) {
		@ViewerStepFormMessage()
	} else {
	<div class="p-4 border border-base-300 rounded bg-base-200">
		<form
			x-data={ stepPlacementData(step, selectedLabel) }
			if isNew {
				hx-post={ fmt.Sprintf("/projects/%d/steps", projectID) }
			} else {
				hx-put={ fmt.Sprintf("/projects/%d/steps/%d", projectID, step.ID) }
			}
			hx-target="#step-list"
			hx-swap="innerHTML"
			if isNew {
				data-step-add-form
				data-toast-success="Step added"
			} else {
				data-toast-success="Step updated"
			}
			data-toast-error="Failed to save step"
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label" for={ stepInputID(step, isNew, "name") }>
					<span class="label-text">Name</span>
				</label>
				<input id={ stepInputID(step, isNew, "name") } type="text" name="name" value={ step.Name } class="input input-bordered"/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="grid min-w-0 gap-4 sm:grid-cols-2">
				<div class="form-control min-w-0">
					<label class="label" for={ stepInputID(step, isNew, "execution-target") }>
						<span class="label-text">Run step on</span>
					</label>
					<select id={ stepInputID(step, isNew, "execution-target") } name="execution_target" x-model="executionTarget" class="select select-bordered min-w-0 w-full">
						<option value="local">Local</option>
						<option value="agent">Agent</option>
					</select>
				</div>
				<div class="form-control min-w-0" x-cloak x-show="executionTarget === 'agent'">
					<label class="label" for={ stepInputID(step, isNew, "agent-label") }>
						<span class="label-text">Agent label</span>
					</label>
					<select id={ stepInputID(step, isNew, "agent-label") } name="agent_label" x-on:change="agentLabel = $event.target.value" x-bind:required="executionTarget === 'agent'" x-bind:disabled="executionTarget !== 'agent'" class="select select-bordered min-w-0 w-full">
						<option value="">Select a label</option>
						for _, label := range labels {
							<option value={ label } selected?={ label == selectedLabel }>{ label }</option>
						}
					</select>
					<p x-cloak x-show="agentLabel" x-text="agentLabel" class="mt-1 break-all text-xs text-base-content/70"></p>
					<label class="label"><span class="label-text-alt">Runs on every matching agent assigned to the deployment environment.</span></label>
				</div>
			</div>
			<div x-data="stepEditor" class="form-control">
				<label class="label" for={ stepInputID(step, isNew, "script") }>
					<span class="label-text">Script Body (Bash)</span>
					<button type="button" class="btn btn-ghost btn-xs" x-on:click="fullscreen">Fullscreen</button>
				</label>
				<div class="flex font-mono text-sm border border-base-300 rounded bg-base-100 overflow-hidden">
					<pre x-ref="gutter" x-text="lineNumbers" class="select-none text-right px-2 py-2 text-gray-500 bg-base-200 overflow-hidden" rows="4" style="line-height:1.5rem"></pre>
					<textarea id={ stepInputID(step, isNew, "script") } x-model="script" x-ref="textarea" x-on:scroll="scroll" x-on:input="input" name="script_body" class="textarea textarea-bordered rounded-none border-0 flex-1 !bg-base-100 !text-base-content" style="line-height:1.5rem; color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; -webkit-text-fill-color: var(--fallback-bc, oklch(var(--bc) / 1)) !important" rows="4">{ step.ScriptBody }</textarea>
				</div>
				<dialog x-cloak x-show="modalOpen" x-ref="modal" x-on:close="modalOpen = false" class="fixed inset-0 z-50 bg-base-100 text-base-content p-4 flex flex-col gap-4 w-screen h-screen max-w-none max-h-none">
					<div class="flex items-center justify-between gap-4">
						<h3 class="text-lg font-semibold">Script Body (Bash)</h3>
						<button type="button" class="btn btn-sm" x-on:click="$refs.modal.close()">Close</button>
					</div>
					<div class="flex min-h-0 flex-1 font-mono text-sm border border-base-300 rounded bg-base-100 overflow-hidden">
						<pre x-ref="modalGutter" x-text="lineNumbers" class="select-none text-right px-3 py-3 text-base-content bg-base-200 overflow-hidden" style="line-height:1.5rem"></pre>
						<textarea x-model="script" x-ref="modalTextarea" x-on:scroll="scroll" x-on:input="input" class="textarea textarea-bordered rounded-none border-0 flex-1 h-full resize-none !bg-base-100 !text-base-content" style="line-height:1.5rem; color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; -webkit-text-fill-color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; background-color: var(--fallback-b1, oklch(var(--b1) / 1)) !important" spellcheck="false"></textarea>
					</div>
					<div class="max-h-40 overflow-y-auto text-xs space-y-1" x-show="diagnostics.length > 0">
						<template x-for="d in diagnostics">
							<div
								:class="{
									'text-error': d.level === 'error',
									'text-warning': d.level === 'warning',
									'text-info': d.level === 'info' || d.level === 'style'
								}"
							>
								<span class="font-semibold" x-text="'Line ' + d.line + ': '"></span>
								<span x-text="d.message"></span>
								<span class="opacity-75" x-text="' (SC' + d.code + ')'"></span>
							</div>
						</template>
					</div>
				</dialog>
				<div class="mt-2 text-xs space-y-1" x-show="diagnostics.length > 0">
					<template x-for="d in diagnostics">
						<div
							:class="{
								'text-error': d.level === 'error',
								'text-warning': d.level === 'warning',
								'text-info': d.level === 'info' || d.level === 'style'
							}"
						>
							<span class="font-semibold" x-text="'Line ' + d.line + ': '"></span>
							<span x-text="d.message"></span>
							<span class="opacity-75" x-text="' (SC' + d.code + ')'"></span>
						</div>
					</template>
				</div>
			</div>
			<div class="form-control">
				<label class="label" for={ stepInputID(step, isNew, "timeout") }>
					<span class="label-text">Timeout (seconds, 0 = 5 min default)</span>
				</label>
				<input id={ stepInputID(step, isNew, "timeout") } type="number" name="timeout_seconds" min="0" value={ strconv.FormatInt(step.TimeoutSeconds, 10) } class="input input-bordered"/>
			</div>
			<div class="form-control">
				<label class="label" for={ stepInputID(step, isNew, "retries") }>
					<span class="label-text">Max retries on failure (0 = no retry)</span>
			</label>
			<input id={ stepInputID(step, isNew, "retries") } type="number" name="max_retries" min="0" value={ strconv.FormatInt(step.MaxRetries, 10) } class="input input-bordered"/>
		</div>
		<input type="hidden" name="sort_order" value={ strconv.FormatInt(step.SortOrder, 10) }/>
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary btn-sm">
					if isNew {
						Add Step
					} else {
						Update
					}
				</button>
				if isNew {
					<button type="button" class="btn btn-ghost btn-sm" x-on:click="$dispatch('step-form-cancel')">Cancel</button>
				} else {
					<button type="button" class="btn btn-ghost btn-sm" x-on:click="$dispatch('step-form-cancel')" hx-get={ fmt.Sprintf("/projects/%d/steps", projectID) } hx-target="#step-list" hx-swap="innerHTML">Cancel</button>
				}
			</div>
		</form>
	</div>
	}
}

templ StepEditRow(step db.Step, projectID int64, labels []string, selectedLabel string, errorMsg string) {
	if !canWrite(ctx) {
		@ViewerStepFormMessage()
	} else {
	<tr id={ fmt.Sprintf("step-row-%d", step.ID) }>
		<td colspan="6" class="w-full p-4">
			<form
				x-data={ stepPlacementData(step, selectedLabel) }
				hx-put={ fmt.Sprintf("/projects/%d/steps/%d", projectID, step.ID) }
				hx-target="#step-list"
				hx-swap="innerHTML"
				data-toast-success="Step updated"
				data-toast-error="Failed to update step"
				class="grid w-full grid-cols-1 gap-4 items-start xl:grid-cols-6"
			>
				<div class="form-control flex-1">
					<label class="label" for={ fmt.Sprintf("step-%d-name", step.ID) }>
						<span class="label-text">Name</span>
					</label>
					<input id={ fmt.Sprintf("step-%d-name", step.ID) } type="text" name="name" value={ step.Name } class="input input-bordered input-sm"/>
					if errorMsg != "" {
						<span class="text-error text-sm mt-1">{ errorMsg }</span>
					}
				</div>
				<div class="form-control min-w-0">
					<label class="label" for={ fmt.Sprintf("step-%d-target", step.ID) }><span class="label-text">Run on</span></label>
					<select id={ fmt.Sprintf("step-%d-target", step.ID) } name="execution_target" x-model="executionTarget" class="select select-bordered select-sm min-w-0 w-full">
						<option value="local">Local</option>
						<option value="agent">Agent</option>
					</select>
					<label class="label" for={ fmt.Sprintf("step-%d-agent-label", step.ID) }><span class="label-text">Agent label</span></label>
					<select id={ fmt.Sprintf("step-%d-agent-label", step.ID) } name="agent_label" x-on:change="agentLabel = $event.target.value" x-cloak x-show="executionTarget === 'agent'" x-bind:required="executionTarget === 'agent'" x-bind:disabled="executionTarget !== 'agent'" class="select select-bordered select-sm min-w-0 w-full">
						<option value="">Select label</option>
						for _, label := range labels {
							<option value={ label } selected?={ label == selectedLabel }>{ label }</option>
						}
					</select>
					<p x-cloak x-show="agentLabel" x-text="agentLabel" class="mt-1 break-all text-xs text-base-content/70"></p>
				</div>
				<div x-data="stepEditor" class="form-control flex-1 xl:col-span-2">
					<label class="label" for={ fmt.Sprintf("step-%d-script", step.ID) }>
						<span class="label-text">Script Body (Bash)</span>
						<button type="button" class="btn btn-ghost btn-xs" x-on:click="fullscreen">Fullscreen</button>
					</label>
					<div class="flex font-mono text-xs border border-base-300 rounded bg-base-100 overflow-hidden">
						<pre x-ref="gutter" x-text="lineNumbers" class="select-none text-right px-2 py-2 text-gray-500 bg-base-200 overflow-hidden" style="line-height:1.25rem"></pre>
					<textarea id={ fmt.Sprintf("step-%d-script", step.ID) } x-model="script" x-ref="textarea" x-on:scroll="scroll" x-on:input="input" name="script_body" class="textarea textarea-bordered textarea-sm resize-y rounded-none border-0 flex-1 !bg-base-100 !text-base-content" style="line-height:1.25rem; color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; -webkit-text-fill-color: var(--fallback-bc, oklch(var(--bc) / 1)) !important" rows="2">{ step.ScriptBody }</textarea>
					</div>
					<dialog x-cloak x-show="modalOpen" x-ref="modal" x-on:close="modalOpen = false" class="fixed inset-0 z-50 bg-base-100 text-base-content p-4 flex flex-col gap-4 w-screen h-screen max-w-none max-h-none">
						<div class="flex items-center justify-between gap-4">
							<h3 class="text-lg font-semibold">Script Body (Bash)</h3>
							<button type="button" class="btn btn-sm" x-on:click="$refs.modal.close()">Close</button>
						</div>
						<div class="flex min-h-0 flex-1 font-mono text-sm border border-base-300 rounded bg-base-100 overflow-hidden">
							<pre x-ref="modalGutter" x-text="lineNumbers" class="select-none text-right px-3 py-3 text-base-content bg-base-200 overflow-hidden" style="line-height:1.5rem"></pre>
						<textarea x-model="script" x-ref="modalTextarea" x-on:scroll="scroll" x-on:input="input" class="textarea textarea-bordered rounded-none border-0 flex-1 h-full resize-none !bg-base-100 !text-base-content" style="line-height:1.5rem; color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; -webkit-text-fill-color: var(--fallback-bc, oklch(var(--bc) / 1)) !important; background-color: var(--fallback-b1, oklch(var(--b1) / 1)) !important" spellcheck="false"></textarea>
						</div>
						<div class="max-h-40 overflow-y-auto text-xs space-y-1" x-show="diagnostics.length > 0">
							<template x-for="d in diagnostics">
								<div
									:class="{
										'text-error': d.level === 'error',
										'text-warning': d.level === 'warning',
										'text-info': d.level === 'info' || d.level === 'style'
									}"
								>
									<span class="font-semibold" x-text="'Line ' + d.line + ': '"></span>
									<span x-text="d.message"></span>
									<span class="opacity-75" x-text="' (SC' + d.code + ')'"></span>
								</div>
							</template>
						</div>
					</dialog>
					<div class="mt-2 text-xs space-y-1" x-show="diagnostics.length > 0">
						<template x-for="d in diagnostics">
							<div
								:class="{
									'text-error': d.level === 'error',
									'text-warning': d.level === 'warning',
									'text-info': d.level === 'info' || d.level === 'style'
								}"
							>
								<span class="font-semibold" x-text="'Line ' + d.line + ': '"></span>
								<span x-text="d.message"></span>
								<span class="opacity-75" x-text="' (SC' + d.code + ')'"></span>
							</div>
						</template>
					</div>
				</div>
				<div class="form-control flex-1">
					<label class="label" for={ fmt.Sprintf("step-%d-retries", step.ID) }>
					<span class="label-text">Max retries</span>
				</label>
				<input id={ fmt.Sprintf("step-%d-retries", step.ID) } type="number" name="max_retries" min="0" value={ strconv.FormatInt(step.MaxRetries, 10) } class="input input-bordered input-sm"/>
			</div>
			<input type="hidden" name="sort_order" value={ strconv.FormatInt(step.SortOrder, 10) }/>
				<div class="flex gap-2 pt-9">
					<button type="submit" class="btn btn-primary btn-sm">Update</button>
					<button type="button" class="btn btn-ghost btn-sm" x-on:click="$dispatch('step-form-cancel')" hx-get={ fmt.Sprintf("/projects/%d/steps", projectID) } hx-target="#step-list" hx-swap="innerHTML">Cancel</button>
				</div>
			</form>
		</td>
	</tr>
	}
}
