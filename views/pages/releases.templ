package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"encoding/json"
	"fmt"
	"strconv"
	"time"
)

type ReleaseStep struct {
	Name            string   `json:"name"`
	ScriptBody      string   `json:"script_body"`
	Interpreter     string   `json:"interpreter"`
	SortOrder       int64    `json:"sort_order"`
	TimeoutSeconds  int64    `json:"timeout_seconds"`
	MaxRetries      int64    `json:"max_retries"`
	ExecutionTarget string   `json:"execution_target"`
	AgentSelectors  []string `json:"agent_selectors"`
	ContainerImage  string   `json:"container_image"`
	VariableNames   []string `json:"variable_names"`
}

func parseReleaseSteps(stepsJSON string) []ReleaseStep {
	var steps []ReleaseStep
	if err := json.Unmarshal([]byte(stepsJSON), &steps); err != nil {
		return nil
	}
	return steps
}

func releaseStepInterpreter(step ReleaseStep) string {
	if step.Interpreter == "" {
		return "bash"
	}
	return step.Interpreter
}

// releaseStepLegacyHost flags a snapshotted step that has no container
// image. The release cannot be deployed against any environment that
// would run it on the host — every legacy step must be recreated and
// re-snapshotted before the release is usable again. Old snapshots may
// omit execution_target entirely (the column was added later); treat
// the missing value the same as the explicit "local" it would have
// defaulted to.
func releaseStepLegacyHost(step ReleaseStep) bool {
	return (step.ExecutionTarget == "" ||
		step.ExecutionTarget == "local") && step.ContainerImage == ""
}

// releaseNeedsRecreation reports whether a release contains at least
// one step that the runner can no longer execute.
func releaseNeedsRecreation(steps []ReleaseStep) bool {
	for _, step := range steps {
		if releaseStepLegacyHost(step) {
			return true
		}
	}
	return false
}

func formatUnixTime(ts int64) string {
	return time.Unix(ts, 0).Format("2006-01-02 15:04:05")
}

// AvailableEnv is the per-env data the releases table needs. Exported so the
// handler can build the same shape.
type AvailableEnv struct {
	Environment db.Environment
	State       GateState
}

type GateState struct {
	Deployable       bool
	Reason           string
	Bypassable       bool
	AlreadyDeployed  bool // true = this env already has this release; caller hides the row
	RequiresApproval bool // true = the target lifecycle stage requires manual approval before running
}

// ReleaseView is the per-row data for the releases table.
type ReleaseView struct {
	Release db.Release
	Envs    []AvailableEnv
	Active  bool
}

templ ReleasesPage(project db.Project, releases []ReleaseView, errorMsg string, currentPath string) {
	@layouts.Base("Releases", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
			{Label: "Releases"},
		})
		@ReleasesContent(project, releases, errorMsg)
	}
}

templ ReleasesContent(project db.Project, releases []ReleaseView, errorMsg string) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<h1 class="text-3xl font-bold">Releases — { project.Name }</h1>
			<div class="flex gap-2">
				<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost btn-sm">Back</a>
			</div>
		</div>
		@ReleasesFragment(project, releases, errorMsg)
	</div>
}

templ ReleasesFragment(project db.Project, releases []ReleaseView, errorMsg string) {
	<div id="releases-content">
		if CanWrite(ctx) {
			@ReleaseForm(project.ID, errorMsg)
		}
		@ReleasesTable(project, releases)
	</div>
}

templ ReleaseForm(projectID int64, errorMsg string) {
	<div class="card bg-base-200 p-4 mb-6">
		<h3 class="text-lg font-bold mb-4">Create Release</h3>
		<form
			hx-post={ fmt.Sprintf("/projects/%d/releases", projectID) }
			hx-target="#releases-content"
			hx-swap="outerHTML"
			data-toast-success="Release created"
			data-toast-error="Failed to create release"
			class="flex flex-wrap gap-4 items-end"
		>
			<div class="form-control flex-1 min-w-[200px]">
				<label class="label">
					<span class="label-text">Version</span>
				</label>
				<input type="text" name="version" class="input input-bordered" placeholder="e.g. 1.0.0" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<button type="submit" class="btn btn-primary">Create Release</button>
		</form>
	</div>
}

templ ReleasesTable(project db.Project, releases []ReleaseView) {
	<table class="table table-zebra table-fixed w-full">
		<thead>
			<tr>
				<th class="w-1/5">Version</th>
				<th class="w-1/5">Created At</th>
				<th class="w-2/5">Deploy</th>
				<th class="w-1/5">Actions</th>
			</tr>
		</thead>
		<tbody>
			if len(releases) == 0 {
				<tr>
					<td colspan="4" class="text-gray-500 italic text-center py-4">No releases yet.</td>
				</tr>
			} else {
				for _, rv := range releases {
					@ReleaseRow(project.ID, rv)
				}
			}
		</tbody>
	</table>
}

templ ReleaseRow(projectID int64, rv ReleaseView) {
	<tr id={ fmt.Sprintf("release-row-%d", rv.Release.ID) }>
		<td class="font-medium truncate">
			<a href={ fmt.Sprintf("/projects/%d/releases/%d", projectID, rv.Release.ID) } class="link link-primary">{ rv.Release.Version }</a>
			if releaseNeedsRecreation(parseReleaseSteps(rv.Release.StepsJson)) {
				<span class="badge badge-warning badge-xs ml-1 align-middle" data-release-needs-recreation title="This release contains legacy local steps without a container image. Recreate those steps and snap a new release before deploying.">recreate</span>
			}
		</td>
		<td class="whitespace-nowrap">{ formatUnixTime(rv.Release.CreatedAt) }</td>
		<td>
			if len(rv.Envs) == 0 {
				<span class="text-gray-500 italic text-sm">No envs available</span>
			} else if CanWrite(ctx) {
				<form method="post" action={ fmt.Sprintf("/projects/%d/deploy", projectID) } class="flex flex-wrap gap-2 items-center" x-data="releaseDeployRow()">
					<input type="hidden" name="release_id" value={ strconv.FormatInt(rv.Release.ID, 10) }/>
					<input type="hidden" name="note" value=""/>
					<select name="environment_id" class="select select-bordered select-xs" required>
						<option value="">Select env</option>
						for _, e := range rv.Envs {
							if e.State.Deployable {
								<option value={ strconv.FormatInt(e.Environment.ID, 10) }>{ e.Environment.Name }</option>
							}
						}
						if hasForceableEnvs(rv.Envs) {
							<optgroup label="Needs force" data-gate-group="forceable" x-bind:hidden="!forceChecked">
								for _, e := range rv.Envs {
									if !e.State.Deployable && e.State.Bypassable {
										<option value={ strconv.FormatInt(e.Environment.ID, 10) } data-gate="forceable" title={ e.State.Reason } x-bind:disabled="!forceChecked">{ e.Environment.Name }</option>
									}
								}
							</optgroup>
						}
					</select>
					if hasForceableEnvs(rv.Envs) {
						<label class="label cursor-pointer gap-1">
							<input type="checkbox" name="force_check" value="true" class="checkbox checkbox-xs" x-model="forceChecked"/>
							<span class="label-text text-xs">Force</span>
						</label>
						<input type="hidden" name="force" value="true" :disabled="!forceChecked"/>
					}
					<button type="submit" class="btn btn-primary btn-xs">Deploy</button>
				</form>
			}
		</td>
		<td>
			if CanWrite(ctx) {
				@ReleaseDeleteControl(projectID, rv.Release, rv.Active, "btn-xs")
			}
		</td>
	</tr>
}

templ ReleaseDetailPage(project db.Project, release db.Release, variables []db.ReleaseVariable, environments []db.Environment, artifact db.ReleaseArtifact, active bool, currentPath string) {
	@layouts.Base(fmt.Sprintf("Release %s", release.Version), currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
			{Label: "Releases", Href: fmt.Sprintf("/projects/%d/releases", project.ID)},
			{Label: release.Version},
		})
		@ReleaseDetail(project, release, variables, environments,artifact,active)
	}
}

templ ReleaseDetail(project db.Project, release db.Release, variables []db.ReleaseVariable, environments []db.Environment, artifact db.ReleaseArtifact, active bool) {
	<div class="space-y-6">
		<div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center">
			<div class="min-w-0">
				<h1 class="text-3xl font-bold break-all">Release { release.Version }</h1>
				<p class="text-gray-400">Project: { project.Name }</p>
			</div>
			<div class="flex flex-wrap shrink-0 gap-2">
				if CanWrite(ctx) && release.SnapshotLocked == 0 {
					<form
						method="post"
						action={ fmt.Sprintf("/projects/%d/releases/%d/refresh", project.ID, release.ID) }
						hx-boost="true"
						hx-confirm="Refresh this release with the latest steps and variables?"
					>
						<button type="submit" class="btn btn-outline btn-warning btn-sm">Refresh</button>
					</form>
				}
				<a href={ fmt.Sprintf("/projects/%d/releases", project.ID) } class="btn btn-ghost btn-sm">Back</a>
				if CanWrite(ctx) {
					@ReleaseDeleteControl(project.ID, release, active, "btn-sm")
				}
			</div>
		</div>
		if release.SnapshotLocked != 0 {
			<p class="alert alert-info text-sm">This release has been deployed. Its snapshot is immutable; create a new release to change steps or variables.</p>
		}
		if artifact.ReleaseID!=0 {
			<div class="card bg-base-200 p-4 space-y-3"><h2 class="text-xl font-bold">Pinned ZIP package</h2><p class="break-all">{ artifact.Url }</p><p>Version: { artifact.Version }</p><p class="font-mono break-all">SHA-256: { artifact.Sha256 }</p><p>Size: { strconv.FormatInt(artifact.Size,10) } bytes</p><p class="text-sm opacity-70">Steps receive ARTIFACT_PATH. Files are read-only; direct execution is blocked.</p></div>
		}
		<div class="card bg-base-200 p-4">
			<h2 class="text-xl font-bold mb-4">Snapshotted Steps</h2>
			if releaseNeedsRecreation(parseReleaseSteps(release.StepsJson)) {
				<div class="alert alert-warning text-sm mb-4" data-release-needs-recreation>
					<span>
						This release contains legacy local steps without a container image. The runner will refuse to start them, so recreate those steps with a container image and snap a new release before deploying.
					</span>
				</div>
			}
			<table class="table table-zebra table-fixed w-full">
				<thead>
					<tr>
						<th class="w-16">Order</th>
						<th class="w-1/4">Name</th>
						<th class="w-24">Interpreter</th>
						<th class="w-auto">Script</th>
					</tr>
				</thead>
				<tbody>
					if len(parseReleaseSteps(release.StepsJson)) == 0 {
						<tr>
							<td colspan="4" class="text-gray-500 italic text-center py-4">No steps in this release.</td>
						</tr>
					} else {
						for _, step := range parseReleaseSteps(release.StepsJson) {
							<tr>
								<td>{ strconv.FormatInt(step.SortOrder, 10) }</td>
								<td class="font-medium truncate">
									{ step.Name }
									if releaseStepLegacyHost(step) {
										<span class="badge badge-warning badge-xs ml-1 align-middle" data-release-step-legacy title="Legacy local step without a container image. Recreate with a container image before it can run again.">legacy</span>
									}
								</td>
								<td class="whitespace-nowrap">{ releaseStepInterpreter(step) }</td>
								<td class="truncate">
									<code class="text-sm bg-base-300 px-2 py-1 rounded">
										if len(step.ScriptBody) > 60 {
											{ step.ScriptBody[:60] + "..." }
										} else {
											{ step.ScriptBody }
										}
									</code>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		<div class="card bg-base-200 p-4">
			<h2 class="text-xl font-bold mb-4">Snapshotted Variables</h2>
			<table class="table table-zebra table-fixed w-full">
				<thead>
					<tr>
						<th class="w-1/3">Name</th>
						<th class="w-1/3">Value</th>
						<th class="w-1/3">Environment</th>
					</tr>
				</thead>
				<tbody>
					if len(variables) == 0 {
						<tr>
							<td colspan="3" class="text-gray-500 italic text-center py-4">No variables in this release.</td>
						</tr>
					} else {
						for _, v := range variables {
							<tr>
								<td class="font-medium truncate">{ v.Name }</td>
								<td class="truncate">
									if v.Secret != 0 {
										<span class="text-gray-500 italic">••••••••</span>
									} else if v.Value.Valid {
										{ v.Value.String }
									} else {
										<span class="text-gray-500 italic">(empty)</span>
									}
								</td>
								<td class="truncate">
									if v.EnvironmentID.Valid {
										for _, env := range environments {
											if env.ID == v.EnvironmentID.Int64 {
												{ env.Name }
											}
										}
									} else {
										<span class="text-gray-500">Unscoped</span>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ReleaseDeleteControl(projectID int64, release db.Release, active bool, size string) {
	<div x-data>
		<button type="button" class={ "btn btn-error whitespace-nowrap " + size } x-on:click="$refs.confirmDelete.showModal()">Delete</button>
		<dialog x-ref="confirmDelete" class="modal" aria-labelledby={ fmt.Sprintf("release-delete-%d-title", release.ID) } aria-describedby={ fmt.Sprintf("release-delete-%d-description", release.ID) }>
			<div class="modal-box bg-base-200">
				<h2 id={ fmt.Sprintf("release-delete-%d-title", release.ID) } class="text-lg font-bold">Delete release { release.Version }?</h2>
				<p id={ fmt.Sprintf("release-delete-%d-description", release.ID) } class="mt-2 text-sm">This permanently deletes the release, its schedules, deployment history, and logs.</p>
				if active {
					<p class="alert alert-warning mt-4 text-sm">This release has an active or unconfirmed deployment. Active deployments must finish or be cancelled. Unconfirmed outcomes require operator inspection and recovery before deletion.</p>
				}
				<div class="modal-action">
					<form method="dialog"><button type="submit" class="btn btn-ghost" autofocus>Cancel</button></form>
					if !active {
						<button type="button" class="btn btn-error" hx-delete={ fmt.Sprintf("/projects/%d/releases/%d", projectID, release.ID) } data-toast-success="Release deleted" data-toast-error="Failed to delete release">Confirm delete</button>
					}
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button type="submit" aria-label="Cancel release deletion"></button></form>
		</dialog>
	</div>
}
