package pages

import (
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

type HomeDeploymentsView struct {
	Attention, Running             []DeploymentListItem
	AttentionCapped, RunningCapped bool
}

templ IndexPage(
	currentPath string,
	projectCount int,
	envCount int,
	data HomeDeploymentsView,
) {
	@layouts.Base("DurpDeploy", currentPath) {
		if projectCount == 0 && envCount == 0 && len(data.Attention) == 0 && len(data.Running) == 0 {
			<div class="hero min-h-[50vh]">
				<div class="hero-content min-w-0 text-center">
					<div class="min-w-0 max-w-md">
						<h1 class="text-3xl sm:text-4xl font-bold break-words">Deployment overview</h1>
						<p class="py-6 text-gray-400">Manage releases, automate operations, and track deployments across environments.</p>
					</div>
				</div>
			</div>
		} else {
			<div class="space-y-6">
				<h1 class="sr-only">Dashboard</h1>
				@HomeDeploymentSections(data)
			</div>
		}
	}
}

templ HomeDeploymentSections(data HomeDeploymentsView) {
	<div id="home-deployments" class="space-y-6" hx-get="/dashboard/deployments" hx-trigger="every 5s, home-deployments-refreshed from:body" hx-swap="outerHTML transition:true">
		if len(data.Attention) == 0 && len(data.Running) == 0 {
			<div class="card bg-base-200">
				<div class="card-body p-4 sm:p-6">
					<h2 class="text-xl font-bold"><span class="text-success">&#10003;</span> All clear</h2>
					<p class="text-gray-400">Nothing needs your attention and no deployments are running.</p>
				</div>
			</div>
		} else {
			<section id="home-attention" aria-label="Needs attention">
				<h2 class="text-xl font-bold mb-4">Needs attention</h2>
				if len(data.Attention) == 0 {
					<p class="text-gray-500 italic">Nothing needs your attention.</p>
				} else {
					@HomeDeploymentTable(data.Attention, true)
					if data.AttentionCapped {
						<p class="text-sm text-gray-400 mt-3">More than 15 items. <a href="/deployments" class="link">View all deployments</a>.</p>
					}
				}
			</section>
			<section id="home-running" aria-label="Running">
				<h2 class="text-xl font-bold mb-4">Running</h2>
				if len(data.Running) == 0 {
					<p class="text-gray-500 italic">No deployments in progress.</p>
				} else {
					@HomeDeploymentTable(data.Running, false)
					if data.RunningCapped {
						<p class="text-sm text-gray-400 mt-3">More than 15 items. <a href="/deployments" class="link">View all deployments</a>.</p>
					}
				}
			</section>
		}
	</div>
}

templ HomeDeploymentTable(items []DeploymentListItem, withActions bool) {
	<table class="table table-zebra table-fixed w-full block! md:table!" data-home-deployments>
		<thead class="hidden md:table-header-group">
			<tr>
				<th class="w-1/6">Project</th>
				<th class="w-1/6">Version</th>
				<th class="w-1/6">Environment</th>
				<th class="w-1/6">Status</th>
				<th class="w-1/6">Date</th>
				if withActions {
					<th class="w-40"></th>
				}
			</tr>
		</thead>
		<tbody class="block md:table-row-group">
			for _, item := range items {
				<tr
					data-deployment-id={ strconv.FormatInt(item.Deployment.ID, 10) }
					data-deployment-status={ item.Deployment.Status }
					class="home-deployment-row relative grid grid-cols-2 gap-3 md:table-row max-md:p-4 max-md:mb-3 max-md:rounded-box max-md:bg-base-200 md:border-b border-base-300"
				>
					<td class="col-span-2 min-w-0 break-all">
						<span class="block md:hidden text-xs opacity-70 mb-1">Project</span>
						<span class="block font-semibold md:font-normal md:truncate">{ item.ProjectName }</span>
						<a
							href={ "/deployments/" + strconv.FormatInt(item.Deployment.ID, 10) }
							class="absolute inset-0 max-md:rounded-box focus-visible:outline-2 focus-visible:outline-primary focus-visible:-outline-offset-2"
							aria-label={ "Open deployment #" + strconv.FormatInt(item.Deployment.ID, 10) + ": " + item.ProjectName + " / " + item.ReleaseVersion + " / " + item.EnvironmentName }
						>
							<span class="sr-only">Open deployment #{ strconv.FormatInt(item.Deployment.ID, 10) }</span>
						</a>
					</td>
					<td class="col-span-2 min-w-0 break-all md:truncate">
						<span class="block md:hidden text-xs opacity-70 mb-1">Version</span>
						{ item.ReleaseVersion }
						if item.Deployment.Note.Valid && item.Deployment.Note.String != "" {
							<span class="block text-xs text-gray-400 break-all max-md:whitespace-normal">{ item.Deployment.Note.String }</span>
						}
					</td>
					<td class="col-span-2 min-w-0 break-all md:truncate">
						<span class="block md:hidden text-xs opacity-70 mb-1">Environment</span>
						{ item.EnvironmentName }
					</td>
					<td class="col-span-2 min-w-0">
						<span class="block md:hidden text-xs opacity-70 mb-1">Status</span>
						@StatusBadge(item.Deployment)
					</td>
					<td class="col-span-2 min-w-0 md:truncate md:whitespace-nowrap">
						<span class="block md:hidden text-xs opacity-70 mb-1">Date</span>
						{ formatUnixTime(item.Deployment.CreatedAt) }
					</td>
					if withActions {
						<td class="col-span-2 min-w-0 relative z-10 max-md:relative">
							@HomeDeploymentActions(item)
						</td>
					}
				</tr>
			}
		</tbody>
	</table>
}

templ HomeDeploymentActions(item DeploymentListItem) {
	<div class="text-right max-md:text-left max-md:mt-1">
		if item.Deployment.Status == "pending_approval" && CanManageAgents(ctx) {
			<button
				class="btn btn-xs btn-success whitespace-nowrap"
				hx-post={ fmt.Sprintf("/deployments/%d/approve", item.Deployment.ID) }
				hx-vals={ `{"stay":1}` }
				hx-confirm="Approve this deployment and start the runner?"
				hx-disable-elt
				data-toast-success="Deployment approved"
				data-toast-error="Failed to approve"
			>
				Approve
			</button>
		}
		if (item.Deployment.Status == "failed" || item.Deployment.Status == "expired") && CanDeploy(ctx) {
			<button
				class="btn btn-xs btn-primary whitespace-nowrap"
				hx-post={ fmt.Sprintf("/deployments/%d/redeploy", item.Deployment.ID) }
				hx-vals={ `{"stay":1}` }
				hx-confirm="Re-run this release in the same environment? Uses the original steps with current release and lifecycle variables. Refreshing the release can change its variables. Original logs stay unchanged."
				hx-disable-elt
				data-toast-success="Re-run started"
				data-toast-error="Failed to re-run"
			>
				Re-run
			</button>
		}
	</div>
}
