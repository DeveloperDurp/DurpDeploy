package pages

// ResourceCard keeps navigation outside the content so the name is plain text.
templ ResourceCard(name, href string) {
	<article class="relative rounded-box border border-base-300 bg-base-200 p-4 sm:p-5" data-resource-card>
		<div class="flex items-start justify-between gap-4 mb-2">
			<h2 class="min-w-0 text-lg font-semibold break-all">{ name }</h2>
			if href != "" {
				<span class="shrink-0 rounded-full bg-base-300 p-2" aria-hidden="true">
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 5 7 7-7 7"></path></svg>
				</span>
			}
		</div>
		<div class="min-w-0 space-y-2 text-sm break-all">{ children... }</div>
		if href != "" {
			<a href={ templ.SafeURL(href) } class="absolute inset-0 rounded-box hover:ring-1 hover:ring-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2" aria-label={ "Open " + name }><span class="sr-only">{ "Open " + name }</span></a>
		}
	</article>
}
