package components

import (
	"durpdeploy/internal/db"
	"fmt"
	"strconv"
	"time"
)

func stepReorderLabel(step db.Step, direction string) string {
	if step.Name == "" {
		return fmt.Sprintf("Move step ID %d %s", step.ID, direction)
	}
	return fmt.Sprintf("Move step %s (ID %d) %s", step.Name, step.ID, direction)
}

// stepListLegacyHostStep mirrors the form's legacy check so the table
// can render the "needs recreation" badge without round-tripping the
// form re-render through the server.
func stepListLegacyHostStep(step db.Step) bool {
	return step.ExecutionTarget == "local" && step.ContainerImage == ""
}

templ StepList(steps []db.Step, projectID int64) {
	<div id="step-list">
		<table class="hidden md:table table-zebra table-fixed w-full">
			<thead>
				<tr>
					<th class="w-16">Order</th>
					<th class="w-1/5">Name</th>
					<th class="hidden md:table-cell w-24">Interpreter</th>
					<th class="hidden md:table-cell w-auto">Script</th>
					<th class="hidden md:table-cell w-20">Timeout</th>
					<th class="hidden md:table-cell w-20">Retries</th>
					<th class="w-1/2 md:w-96">Actions</th>
				</tr>
			</thead>
			<tbody>
				for i, step := range steps {
					@StepRow(step, projectID, i == 0, i == len(steps)-1)
				}
			</tbody>
		</table>
		<ol class="space-y-3 md:hidden" aria-label="Deployment steps" data-mobile-step-list>
			for i, step := range steps {
				@StepMobileRecord(step, projectID, i == 0, i == len(steps)-1)
			}
		</ol>
	</div>
}

templ StepRow(step db.Step, projectID int64, isFirst bool, isLast bool) {
	<tr id={ fmt.Sprintf("step-row-%d", step.ID) }>
		<td>{ strconv.FormatInt(step.SortOrder, 10) }</td>
		<td class="font-medium truncate">
			{ step.Name }
			if stepListLegacyHostStep(step) {
				<span class="badge badge-warning badge-xs ml-1 align-middle" data-step-legacy-badge title="Legacy local step without a container image. Recreate it with a container image before it can run again.">legacy</span>
			}
		</td>
		<td class="hidden md:table-cell whitespace-nowrap">{ step.Interpreter }</td>
		<td class="hidden md:table-cell truncate">
			<code class="text-sm bg-base-200 px-2 py-1 rounded">
				if len(step.ScriptBody) > 60 {
					{ step.ScriptBody[:60] + "..." }
				} else {
					{ step.ScriptBody }
				}
			</code>
		</td>
		<td class="hidden md:table-cell whitespace-nowrap text-sm">
			@timeoutCell(step.TimeoutSeconds)
		</td>
		<td class="hidden md:table-cell whitespace-nowrap text-sm">
			@retriesCell(step.MaxRetries)
		</td>
		<td class="flex flex-wrap gap-1">
			if canWrite(ctx) {
				if isFirst {
					<span class="btn btn-xs btn-ghost invisible" aria-hidden="true">↑</span>
				} else {
					<button
						class="btn btn-xs btn-ghost"
						data-step-action="move-up"
						aria-label={ stepReorderLabel(step, "up") }
						hx-patch={ fmt.Sprintf("/projects/%d/steps/reorder", projectID) }
						hx-vals={ fmt.Sprintf("{\"step_id\":%d,\"new_order\":%d}", step.ID, step.SortOrder-1) }
						hx-target="#step-list"
						hx-swap="innerHTML"
					>
						↑
					</button>
				}
				if isLast {
					<span class="btn btn-xs btn-ghost invisible" aria-hidden="true">↓</span>
				} else {
					<button
						class="btn btn-xs btn-ghost"
						data-step-action="move-down"
						aria-label={ stepReorderLabel(step, "down") }
						hx-patch={ fmt.Sprintf("/projects/%d/steps/reorder", projectID) }
						hx-vals={ fmt.Sprintf("{\"step_id\":%d,\"new_order\":%d}", step.ID, step.SortOrder+1) }
						hx-target="#step-list"
						hx-swap="innerHTML"
					>
						↓
					</button>
				}
				<button
					class="btn btn-xs btn-secondary"
					data-step-action="edit"
					hx-get={ fmt.Sprintf("/projects/%d/steps/%d/edit?dialog=1", projectID, step.ID) }
					hx-target="#step-edit-content"
					hx-swap="innerHTML"
					x-on:click="$dispatch('step-form-edit')"
				>
					Edit
				</button>
				<button
					class="btn btn-xs btn-outline"
					data-step-action="save-template"
					hx-post={ fmt.Sprintf("/projects/%d/steps/%d/save-as-template", projectID, step.ID) }
					hx-target="#step-list"
					hx-swap="innerHTML"
					hx-confirm="Save this step as template?"
				>
					Save Template
				</button>
			}
		</td>
	</tr>
}

templ StepMobileRecord(step db.Step, projectID int64, isFirst bool, isLast bool) {
	<li class="card bg-base-200 p-4 space-y-3" data-mobile-step={ strconv.FormatInt(step.ID, 10) }>
		if stepListLegacyHostStep(step) {
			<div class="alert alert-warning text-xs" data-step-legacy-badge>
				Legacy local step without a container image. Recreate it with a container image before it can run again.
			</div>
		}
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="text-sm text-gray-400">Step { strconv.FormatInt(step.SortOrder, 10) }</p>
				<h3 class="font-medium break-words">{ step.Name }</h3>
				<p class="text-xs text-gray-400">{ "Interpreter: " + step.Interpreter }</p>
			</div>
			<dl class="shrink-0 text-right text-xs text-gray-400">
				<div><dt class="sr-only">Timeout</dt><dd>@timeoutCell(step.TimeoutSeconds)</dd></div>
				<div><dt class="sr-only">Retries</dt><dd>{ "Retries: " }@retriesCell(step.MaxRetries)</dd></div>
			</dl>
		</div>
		<details class="text-sm">
			<summary class="cursor-pointer text-primary">View script</summary>
			<pre class="mt-2 whitespace-pre-wrap break-words rounded bg-base-100 p-3 text-xs"><code>{ step.ScriptBody }</code></pre>
		</details>
		if canWrite(ctx) {
			<div class="flex flex-wrap gap-2">
				if !isFirst {
					<button
						class="btn btn-xs btn-ghost"
						data-step-action="move-up"
						aria-label={ stepReorderLabel(step, "up") }
						hx-patch={ fmt.Sprintf("/projects/%d/steps/reorder", projectID) }
						hx-vals={ fmt.Sprintf("{\"step_id\":%d,\"new_order\":%d}", step.ID, step.SortOrder-1) }
						hx-target="#step-list"
						hx-swap="innerHTML"
					>
						↑
					</button>
				}
				if !isLast {
					<button
						class="btn btn-xs btn-ghost"
						data-step-action="move-down"
						aria-label={ stepReorderLabel(step, "down") }
						hx-patch={ fmt.Sprintf("/projects/%d/steps/reorder", projectID) }
						hx-vals={ fmt.Sprintf("{\"step_id\":%d,\"new_order\":%d}", step.ID, step.SortOrder+1) }
						hx-target="#step-list"
						hx-swap="innerHTML"
					>
						↓
					</button>
				}
				<button
					type="button"
					class="btn btn-xs btn-secondary"
					data-step-action="edit"
					hx-get={ fmt.Sprintf("/projects/%d/steps/%d/edit?dialog=1", projectID, step.ID) }
					hx-target="#step-edit-content"
					hx-swap="innerHTML"
					x-on:click="$dispatch('step-form-edit')"
				>
					Edit
				</button>
				<button
					class="btn btn-xs btn-outline"
					data-step-action="save-template"
					hx-post={ fmt.Sprintf("/projects/%d/steps/%d/save-as-template", projectID, step.ID) }
					hx-target="#step-list"
					hx-swap="innerHTML"
					hx-confirm="Save this step as template?"
				>
					Save Template
				</button>
			</div>
		}
	</li>
}

templ timeoutCell(sec int64) {
	if sec <= 0 {
		default
	} else {
		{ (time.Duration(sec) * time.Second).String() }
	}
}

templ retriesCell(n int64) {
	if n <= 0 {
		default
	} else {
		{ strconv.FormatInt(n, 10) }
	}
}
