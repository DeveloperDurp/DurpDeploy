# DurpDeploy systemd unit.
#
# Install: sudo install -m 0644 systemd/durpdeploy.service /etc/systemd/system/
# Then:   sudo systemctl daemon-reload && sudo systemctl enable --now durpdeploy
#
# See docs/deploy.md for the full provisioning runbook, and
# docs/backup-restore.md + systemd/litestream.service for continuous backup
# of the SQLite database this service writes to.

[Unit]
Description=DurpDeploy — bash deployment tool
Documentation=https://gitlab.example.com/durpdeploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=durpdeploy
Group=durpdeploy
WorkingDirectory=/var/lib/durpdeploy
Environment=DURPDEPLOY_DB=/var/lib/durpdeploy/durpdeploy.db
Environment=DURPDEPLOY_URL=https://durpdeploy.example.com
# Optional OIDC SSO settings. Create /etc/durpdeploy/durpdeploy.env as root,
# mode 0600, with all required values together. The exact callback URI is
# https://durpdeploy.example.com/login/oidc/callback and scopes are fixed to
# openid profile email.
#
# DURPDEPLOY_OIDC_ISSUER=https://idp.example.com/realms/example
# DURPDEPLOY_OIDC_CLIENT_ID=durpdeploy-example
# DURPDEPLOY_OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# DURPDEPLOY_OIDC_ADMIN_GROUP=durpdeploy-admin
# DURPDEPLOY_OIDC_DEPLOYER_GROUP=durpdeploy-deployer
# DURPDEPLOY_OIDC_VIEWER_GROUP=durpdeploy-viewer
# DURPDEPLOY_OIDC_DISPLAY_NAME=SSO
# DURPDEPLOY_OIDC_GROUP_CLAIM=groups
#   Security exception: set false to accept a present literal boolean
#   email_verified=true or false claim. Missing or malformed claims remain
#   rejected; this weakens identity assurance.
#   DURPDEPLOY_OIDC_REQUIRE_EMAIL_VERIFIED=false
EnvironmentFile=-/etc/durpdeploy/durpdeploy.env
ExecStart=/usr/local/bin/durpdeploy
Restart=on-failure
RestartSec=5s

# The server WRITES to the SQLite database under /var/lib/durpdeploy
# (deploys, audit_log inserts, WAL/SHM sidecars). ProtectSystem=strict
# makes the entire filesystem read-only, so /var/lib/durpdeploy must be
# explicitly carved out as writable. Same pattern as the audit-prune
# service; see systemd/durpdeploy-audit-prune.service.
ReadWritePaths=/var/lib/durpdeploy
# Let the process manage its own cgroup sub-tree under
# /sys/fs/cgroup/durpdeploy — required so the runner sandbox (P1-4) can
# create a per-deployment cgroup and apply cpu/memory/pids limits.
Delegate=yes
# Grant just enough capabilities for the runner sandbox (P1-4) to switch
# step processes to the low-privileged durpdeploy-runner user and to
# bind-mount/chroot the step's scratch filesystem. NoNewPrivileges below
# still blocks privilege gain via execve, it does not block these syscalls.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_SYS_ADMIN

# --- Hardening ---
# Make most of the filesystem read-only to the process. Writes are still
# allowed under /var/lib/durpdeploy (WorkingDirectory) via the explicit bind
# exception, plus /var/log if litestream logging is added later.
ProtectSystem=strict
# Hide /home, /root, /run/user — the service has no business reading user data.
ProtectHome=true
# Drop setuid/setgid capability gains; a compromised process cannot escalate.
NoNewPrivileges=true
# Private /tmp — the process sees its own fresh tmpfs, isolated from host /tmp.
PrivateTmp=true
# Block writes to kernel tunables (sysctl) and kernel module loading.
ProtectKernelTunables=true
ProtectKernelModules=true
# NOTE: ProtectControlGroups is intentionally omitted (P1-4) — the runner
# sandbox needs write access under /sys/fs/cgroup/durpdeploy to create and
# manage per-deployment cgroups (see docs/deploy.md for directory setup).
# Restrict to the socket families the binary actually needs: unix sockets
# (SQLite in some configs), IPv4/IPv6 for the HTTP listener. No AF_PACKET,
# no AF_NETLINK — the process cannot do raw sockets or netlink trickery.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NOTE: RestrictNamespaces is intentionally omitted (P1-4) — the runner
# sandbox bind-mounts and chroots each step's scratch directory, which
# requires mount namespace operations.
# Block realtime scheduling — not needed, blocks a class of priority attacks.
RestrictRealtime=true
# Lock the process personality (prevents 32-bit-on-64-bit ABI tricks).
LockPersonality=true
# Block writable+executable memory. Go does not use JIT, so this is safe and
# blocks a large class of code-injection attacks.
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
