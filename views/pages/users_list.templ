package pages

import (
	"durpdeploy/internal/auth"
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"fmt"
)

templ UsersListPage(
	users []db.ListUsersRow,
	currentUser *db.User,
	currentPath string,
) {
	@layouts.Base("Users", currentPath) {
		<div x-data="formDialogHost" x-on:htmx:after-settle.camel="afterSettle" x-on:htmx:before-swap.camel="beforeSwap">
			<div class="flex justify-between items-center mb-4">
				<h1 class="text-3xl font-bold">Users</h1>
				if CanWrite(ctx) {
					<a href="/admin/users/new" hx-get="/admin/users/new" hx-target="#project-edit-content" hx-select="[data-user-form]" hx-swap="innerHTML" hx-push-url="false" hx-boost="false" x-on:click="rememberOpener" class="btn btn-primary btn-sm">New user</a>
				}
			</div>
			if len(users) == 0 {
				<div class="card bg-base-200 p-8 text-center">
					<p class="text-gray-400">No users yet.</p>
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-zebra table-fixed w-full block! lg:table!">
						<thead class="hidden lg:table-header-group">
							<tr>
								<th class="w-1/4">Email</th>
								<th class="w-1/8">Name</th>
								<th class="w-1/8">Role</th>
								<th class="w-1/8">Created</th>
								<th class="w-1/8">Last login</th>
								<th class="w-1/4">Actions</th>
							</tr>
						</thead>
						<tbody class="block lg:table-row-group">
							for _, u := range users {
								@usersListRow(u, currentUser)
							}
						</tbody>
					</table>
				</div>
				if CanWrite(ctx) {
					for _, u := range users {
						if currentUser == nil || currentUser.ID != u.ID {
							@MFAResetConfirmationDialog(u)
						}
					}
				}
			}
			if CanWrite(ctx) {
				@UserFormDialog()
			}
		</div>
	}
}

templ usersListRow(u db.ListUsersRow, currentUser *db.User) {
	<tr data-user-id={ fmt.Sprint(u.ID) } class="grid grid-cols-2 gap-3 lg:table-row max-lg:p-4 max-lg:mb-3 max-lg:rounded-box max-lg:bg-base-200">
		<td class="col-span-2 min-w-0 break-all lg:truncate font-mono text-sm" title={ u.Email } data-user-email>
			<span class="block lg:hidden font-sans text-xs opacity-70 mb-1">Email</span>
			{ u.Email }
		</td>
		<td class="col-span-2 min-w-0 break-all lg:truncate" title={ u.Name } data-user-name>
			<span class="block lg:hidden text-xs opacity-70 mb-1">Name</span>
			{ u.Name }
		</td>
		<td class="col-span-2">
			<span class="block lg:hidden text-xs opacity-70 mb-1">Role</span>
			<span class="badge badge-outline">{ u.Role }</span>
		</td>
		<td class="min-w-0 break-words lg:truncate lg:whitespace-nowrap text-sm" title={ formatUnixTime(u.CreatedAt) }>
			<span class="block lg:hidden text-xs opacity-70 mb-1">Created</span>
			{ formatUnixTime(u.CreatedAt) }
		</td>
		<td class="min-w-0 break-words lg:truncate lg:whitespace-nowrap text-sm">
			<span class="block lg:hidden text-xs opacity-70 mb-1">Last login</span>
			if u.LastLoginAt.Valid {
				{ formatUnixTime(u.LastLoginAt.Int64) }
			} else {
				<span class="text-gray-500">never</span>
			}
		</td>
		<td class="col-span-2">
			if CanWrite(ctx) {
				<div class="flex flex-wrap lg:flex-nowrap gap-2">
					<a href={ fmt.Sprintf("/admin/users/%d/edit", u.ID) } hx-get={ fmt.Sprintf("/admin/users/%d/edit", u.ID) } hx-target="#project-edit-content" hx-select="[data-user-form]" hx-swap="innerHTML" hx-push-url="false" hx-boost="false" x-on:click="rememberOpener" class="btn btn-ghost btn-sm min-h-11 lg:btn-xs lg:min-h-0 whitespace-nowrap">Edit</a>
					if currentUser == nil || currentUser.ID != u.ID {
						<form
							method="post"
							action={ fmt.Sprintf("/admin/users/%d/mfa-reset", u.ID) }
							class="inline"
							data-mfa-reset-dialog={ fmt.Sprintf("mfa-reset-dialog-%d", u.ID) }
						>
							if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
								<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
							}
							<input type="hidden" name="reason" value="administrative_reset"/>
							<button
								type="submit"
								class="btn btn-warning btn-sm min-h-11 lg:btn-xs lg:min-h-0 whitespace-nowrap"
								data-mfa-reset-opener
							>
								Reset MFA
							</button>
						</form>
						<button
							class="btn btn-error btn-sm min-h-11 lg:btn-xs lg:min-h-0 whitespace-nowrap"
							hx-delete={ fmt.Sprintf("/admin/users/%d", u.ID) }
							hx-confirm={ fmt.Sprintf("Delete user %s? They will be unable to log in.", u.Email) }
							data-toast-success="User deleted"
							data-toast-error="Failed to delete user"
						>
							Delete
						</button>
					}
				</div>
			}
		</td>
	</tr>
}

templ MFAResetConfirmationDialog(u db.ListUsersRow) {
	<dialog
		id={ fmt.Sprintf("mfa-reset-dialog-%d", u.ID) }
		class="modal"
		aria-labelledby={ fmt.Sprintf("mfa-reset-title-%d", u.ID) }
		aria-describedby={ fmt.Sprintf("mfa-reset-description-%d", u.ID) }
		data-mfa-reset-confirmation-dialog
	>
		<div class="modal-box flex min-h-0 flex-col overflow-hidden w-11/12 max-w-lg bg-base-200">
			<h2 id={ fmt.Sprintf("mfa-reset-title-%d", u.ID) } class="shrink-0 text-lg font-bold break-all">
				Reset MFA
			</h2>
			<div class="min-h-0 overflow-y-auto" data-modal-scroll-body>
				<p id={ fmt.Sprintf("mfa-reset-description-%d", u.ID) } class="mt-2 text-sm opacity-70">
					<span class="block font-medium break-all mb-2">Reset MFA for { u.Name }</span>
					This removes the user's authenticator factors and recovery codes. They will need to enroll MFA again.
				</p>
				<p class="mt-4 text-sm">
					Target: <span class="font-mono break-all">{ u.Email }</span>
				</p>
				<form
					id={ fmt.Sprintf("mfa-reset-confirm-form-%d", u.ID) }
					method="post"
					action={ fmt.Sprintf("/admin/users/%d/mfa-reset", u.ID) }
					data-mfa-reset-confirmation
				>
					if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
						<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
					}
					<input type="hidden" name="reason" value="administrative_reset"/>
				</form>
			</div>
			<div class="modal-action shrink-0">
				<form method="dialog">
					<button type="submit" class="btn btn-ghost" autofocus>Cancel</button>
				</form>
				<button
					type="submit"
					form={ fmt.Sprintf("mfa-reset-confirm-form-%d", u.ID) }
					class="btn btn-error"
					data-mfa-reset-confirm
				>
					Confirm reset
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit" aria-label="Cancel MFA reset"></button>
		</form>
	</dialog>
}
