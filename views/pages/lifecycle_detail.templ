package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

func ternaryNext(current int64) string {
	if current == 0 {
		return "true"
	}
	return "false"
}

func lifecycleStageReorderLabel(s LifecycleStageView, direction string) string {
	if s.Environment.Name == "" {
		return fmt.Sprintf("Move stage ID %d %s", s.Stage.ID, direction)
	}
	return fmt.Sprintf(
		"Move stage %s (stage ID %d) %s",
		s.Environment.Name,
		s.Stage.ID,
		direction,
	)
}

templ LifecycleDetailPage(lc db.Lifecycle, stages []LifecycleStageView, availableEnvs []db.Environment, errorMsg string, currentPath string) {
	@layouts.Base("Lifecycle: "+lc.Name, currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Lifecycles", Href: "/lifecycles"},
			{Label: lc.Name},
		})
		@LifecycleDetail(lc, stages, availableEnvs, errorMsg)
	}
}

templ LifecycleDetail(lc db.Lifecycle, stages []LifecycleStageView, availableEnvs []db.Environment, errorMsg string) {
	<div class="space-y-6">
		<div class="flex justify-between items-start">
			<div>
				<h1 class="text-3xl font-bold">{ lc.Name }</h1>
				if lc.Description.Valid {
					<p class="text-gray-400 mt-1">{ lc.Description.String }</p>
				}
			</div>
			<div class="flex gap-2">
				if CanWrite(ctx) {
					<a href={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/edit") } class="btn btn-ghost btn-sm">Edit</a>
				}
				<a href="/lifecycles" class="btn btn-ghost btn-sm">Back</a>
			</div>
		</div>

		<div class="card bg-base-200 p-4">
			<h2 class="text-xl font-bold mb-4">Promotion Order</h2>
			if errorMsg != "" {
				<p class="text-error mb-2">{ errorMsg }</p>
			}
			<p class="text-sm text-gray-400 mb-4">Releases must deploy successfully to each stage before they can be promoted to the next.</p>
			@LifecycleStageList(lc, stages, availableEnvs)
		</div>
	</div>
}

templ LifecycleStageList(lc db.Lifecycle, stages []LifecycleStageView, availableEnvs []db.Environment) {
	<div
		id="lifecycle-stages"
		hx-get={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10)) }
		hx-trigger="mobile-stage-updated from:body"
		hx-target="this"
		hx-swap="outerHTML"
		hx-select="#lifecycle-stages"
	>
		if len(stages) == 0 {
			<p class="text-gray-500 italic">No stages yet. Add an environment below to begin.</p>
		} else {
			<table class="hidden md:table table-zebra table-fixed w-full">
				<thead>
					<tr>
						<th class="w-16">Order</th>
					<th class="w-auto whitespace-normal">Environment</th>
					<th class="w-1/4 md:w-1/3 whitespace-normal">Requires approval</th>
					<th class="w-1/3 md:w-96 whitespace-normal">Actions</th>
					</tr>
				</thead>
				<tbody>
					for i, s := range stages {
						@LifecycleStageRow(lc, i, len(stages), s)
					}
				</tbody>
			</table>
			<ol class="space-y-3 md:hidden" aria-label="Promotion stages" data-mobile-lifecycle-stage-list>
				for i, s := range stages {
					@LifecycleStageMobileRecord(lc, i, len(stages), s)
				}
			</ol>
		}
		if CanWrite(ctx) {
			if len(availableEnvs) > 0 {
				@LifecycleAddStageForm(lc, availableEnvs)
			} else {
				<p class="text-sm text-gray-400 mt-4">All environments are already in this lifecycle. Create more environments to extend the chain.</p>
			}
		}
	</div>
}

templ LifecycleStageRow(lc db.Lifecycle, index int, total int, s LifecycleStageView) {
	<tr id={ "lifecycle-stage-" + strconv.FormatInt(s.Stage.ID, 10) }>
		<td>{ strconv.Itoa(index + 1) }</td>
		<td class="font-medium truncate">{ s.Environment.Name }</td>
		<td>
			if CanWrite(ctx) {
				<label class="cursor-pointer flex flex-wrap items-center gap-1">
					<input
						type="checkbox"
						class="checkbox checkbox-sm"
						data-lifecycle-stage-action="approval"
						hx-patch={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/" + strconv.FormatInt(s.Stage.ID, 10)) }
						hx-vals={ fmt.Sprintf(`{"requires_approval":%q}`, ternaryNext(s.Stage.RequiresApproval)) }
						hx-target="closest tr"
						hx-swap="outerHTML"
						checked?={ s.Stage.RequiresApproval != 0 }
					/>
					<span class="text-sm">Required</span>
				</label>
			} else {
				<span class="text-sm">
					if s.Stage.RequiresApproval != 0 {
						Required
					} else {
						Not required
					}
				</span>
			}
		</td>
		<td class="flex flex-wrap gap-2 whitespace-nowrap">
			if CanWrite(ctx) {
				if index == 0 {
					<span class="btn btn-xs invisible" aria-hidden="true">↑</span>
				} else {
					<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/reorder") }>
						<input type="hidden" name="stage_id" value={ strconv.FormatInt(s.Stage.ID, 10) }/>
						<input type="hidden" name="direction" value="up"/>
						<button type="submit" class="btn btn-xs" data-lifecycle-stage-action="move-up" aria-label={ lifecycleStageReorderLabel(s, "up") }>↑</button>
					</form>
				}
				if index == total-1 {
					<span class="btn btn-xs invisible" aria-hidden="true">↓</span>
				} else {
					<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/reorder") }>
						<input type="hidden" name="stage_id" value={ strconv.FormatInt(s.Stage.ID, 10) }/>
						<input type="hidden" name="direction" value="down"/>
						<button type="submit" class="btn btn-xs" data-lifecycle-stage-action="move-down" aria-label={ lifecycleStageReorderLabel(s, "down") }>↓</button>
					</form>
				}
				<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/" + strconv.FormatInt(s.Stage.ID, 10) + "/delete") } onsubmit="return confirm('Remove this stage from the lifecycle?')">
					<button type="submit" class="btn btn-xs btn-error" data-lifecycle-stage-action="delete">Delete</button>
				</form>
			}
		</td>
	</tr>
}

templ LifecycleStageMobileRecord(lc db.Lifecycle, index int, total int, s LifecycleStageView) {
	<li
		class="card bg-base-100 p-4 space-y-3"
		data-mobile-lifecycle-stage={ strconv.FormatInt(s.Stage.ID, 10) }
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="text-sm text-gray-400">Stage { strconv.Itoa(index + 1) }</p>
				<h3 class="font-medium break-words">{ s.Environment.Name }</h3>
			</div>
			<div>
				if CanWrite(ctx) {
					<label class="cursor-pointer flex items-center gap-1">
						<input
							type="checkbox"
							class="checkbox checkbox-sm"
							data-lifecycle-stage-action="approval"
							hx-patch={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/" + strconv.FormatInt(s.Stage.ID, 10)) }
							hx-vals={ fmt.Sprintf(`{"requires_approval":%q}`, ternaryNext(s.Stage.RequiresApproval)) }
							hx-target="#lifecycle-stages"
							hx-swap="none"
							hx-on::after-request="if(event.detail.successful) htmx.trigger(document.body, 'mobile-stage-updated')"
							checked?={ s.Stage.RequiresApproval != 0 }
						/>
						<span class="text-sm">Approval</span>
					</label>
				} else if s.Stage.RequiresApproval != 0 {
					<span class="badge badge-warning badge-sm">Approval required</span>
				} else {
					<span class="badge badge-ghost badge-sm">No approval</span>
				}
			</div>
		</div>
		if CanWrite(ctx) {
			<div class="flex flex-wrap gap-2">
				if index > 0 {
					<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/reorder") }>
						<input type="hidden" name="stage_id" value={ strconv.FormatInt(s.Stage.ID, 10) }/>
						<input type="hidden" name="direction" value="up"/>
						<button type="submit" class="btn btn-xs" data-lifecycle-stage-action="move-up" aria-label={ lifecycleStageReorderLabel(s, "up") }>↑</button>
					</form>
				}
				if index < total-1 {
					<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/reorder") }>
						<input type="hidden" name="stage_id" value={ strconv.FormatInt(s.Stage.ID, 10) }/>
						<input type="hidden" name="direction" value="down"/>
						<button type="submit" class="btn btn-xs" data-lifecycle-stage-action="move-down" aria-label={ lifecycleStageReorderLabel(s, "down") }>↓</button>
					</form>
				}
				<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages/" + strconv.FormatInt(s.Stage.ID, 10) + "/delete") } onsubmit="return confirm('Remove this stage from the lifecycle?')">
					<button type="submit" class="btn btn-xs btn-error" data-lifecycle-stage-action="delete">Delete</button>
				</form>
			</div>
		}
	</li>
}

templ LifecycleAddStageForm(lc db.Lifecycle, availableEnvs []db.Environment) {
	<form
		method="post"
		action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10) + "/stages") }
		class="flex flex-wrap gap-4 items-end mt-4"
	>
		<div class="form-control flex-1 min-w-[200px]">
			<label class="label">
				<span class="label-text">Add environment to next stage</span>
			</label>
			<select name="environment_id" class="select select-bordered" required>
				<option value="">Select env</option>
				for _, env := range availableEnvs {
					<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
				}
			</select>
		</div>
		<button type="submit" class="btn btn-primary">Add Stage</button>
	</form>
}
