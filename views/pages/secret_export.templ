package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/internal/auth"
	"durpdeploy/views/layouts"
	"fmt"
)

templ SecretExportPage(row db.SecretExport, name, csrf string) {
	@layouts.Base("Export secrets", "/admin/secret-exports/"+row.ID) {
		<div class="w-full px-4 sm:px-6 lg:px-8 py-8">
			<section class="card bg-base-200 max-w-xl mx-auto p-6 space-y-4" aria-labelledby="export-title">
				<h1 id="export-title" class="text-2xl font-bold">Export secrets</h1>
				<p>Export secret variables from { row.Scope }: <strong class="break-all">{ name }</strong>.</p>
				<p>The JSON file contains plaintext secrets. Store it in a secure location.</p>
				if row.Approved == 0 {
					<p>Confirm your identity with your password or single sign-on. This request expires after five minutes.</p>
					<form method="post" action={ templ.SafeURL("/admin/secret-exports/"+row.ID+"/authorize") } hx-boost="false">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<button class="btn btn-primary" type="submit">Confirm identity</button>
					</form>
				} else if row.TokenID != "" {
					<p role="status">Export approved. Return to your API client to download it once before this request expires.</p>
				} else {
					<form method="post" action={ templ.SafeURL("/admin/secret-exports/"+row.ID+"/download") } hx-boost="false">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<button class="btn btn-primary" type="submit">Download JSON</button>
					</form>
				}
				<form method="post" action={ templ.SafeURL("/admin/secret-exports/"+row.ID+"/cancel") } hx-boost="false">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button class="btn btn-ghost" type="submit">Cancel export</button>
				</form>
			</section>
		</div>
	}
}

templ SecretExportButton(scope string, id int64) {
	if CanExportSecrets(ctx) {
		<form method="post" action="/admin/secret-exports" hx-boost="false">
			if session := auth.SessionFromContext(ctx); session != nil {
				<input type="hidden" name="csrf_token" value={ session.CsrfToken }/>
			}
			<input type="hidden" name="scope" value={ scope }/>
			<input type="hidden" name="scope_id" value={ fmt.Sprint(id) }/>
			<button class="btn btn-outline btn-sm" type="submit">Export secrets</button>
		</form>
	}
}
