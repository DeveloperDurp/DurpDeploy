package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

// projectFormID returns the form's id attribute. The submit button
// rendered below the form uses the same id so its `form=` attribute
// actually binds to the form — without this, clicking Save on the
// "new" page is a no-op (the button references "project-form-0" while
// the form is "project-form-new").
func projectFormID(project db.Project, isEdit bool) string {
	if isEdit {
		return fmt.Sprintf("project-form-%d", project.ID)
	}
	return "project-form-new"
}

templ ProjectForm(project db.Project, isEdit bool, errorMsg string, lifecycles []db.Lifecycle, members []db.ListProjectMembersRow, availableUsers []db.ListUsersRow, canManage bool) {
	<div id="project-settings-panel" data-project-form class="max-w-2xl mx-auto">
		<div class="page-header">
			<h1 class="text-3xl font-bold">
				if isEdit {
					Edit Project
				} else {
					New Project
				}
			</h1>
			if isEdit {
				<div class="flex flex-wrap gap-2">
					<button type="submit" form={ projectFormID(project, isEdit) } class="btn btn-primary md:btn-sm">Save</button>
					<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost md:btn-sm" x-data="backNavigation" @click="back">Back</a>
				</div>
			} else {
				<div class="flex gap-2">
					<button type="submit" form={ projectFormID(project, isEdit) } class="btn btn-primary md:btn-sm">Save</button>
					<a href="/projects" class="btn btn-ghost md:btn-sm" x-data="backNavigation" @click="back">Cancel</a>
				</div>
			}
		</div>
		<form
			if isEdit {
				id={ projectFormID(project, isEdit) }
				hx-put={ fmt.Sprintf("/projects/%d", project.ID) }
				hx-target="#project-settings-panel"
				hx-swap="outerHTML"
				data-toast-success="Project updated"
				data-toast-error="Failed to update project"
			} else {
				id={ projectFormID(project, isEdit) }
				method="post"
				action="/projects"
				hx-post="/projects"
				hx-target="#project-settings-panel"
				hx-swap="outerHTML"
				data-toast-success="Project created"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" class="input input-bordered" value={ project.Name } required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Description</span>
				</label>
				<textarea name="description" class="textarea textarea-bordered" rows="4">{ project.Description.String }</textarea>
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Lifecycle</span>
				</label>
				<p class="text-sm opacity-70 mb-2">Optional. Gates deployments to environments in order and grants access to shared variables.</p>
				if CanManageLifecycleVariables(ctx) {
					<select name="lifecycle_id" class="select select-bordered">
					<option value="">— No lifecycle —</option>
					for _, lc := range lifecycles {
						<option
							value={ strconv.FormatInt(lc.ID, 10) }
							if project.LifecycleID.Valid && project.LifecycleID.Int64 == lc.ID {
								selected
							}
						>
							{ lc.Name }
						</option>
					}
					</select>
				} else {
					if project.LifecycleID.Valid {
						if canManage {
							<select name="lifecycle_id" class="select select-bordered">
								for _, lc := range lifecycles {
									if lc.ID == project.LifecycleID.Int64 {
										<option value={ strconv.FormatInt(lc.ID, 10) } selected>{ lc.Name }</option>
									}
								}
								<option value="">— Remove lifecycle assignment —</option>
							</select>
						} else {
							<input type="hidden" name="lifecycle_id" value={ strconv.FormatInt(project.LifecycleID.Int64, 10) }/>
							for _, lc := range lifecycles {
								if lc.ID == project.LifecycleID.Int64 {
									<p>{ lc.Name }</p>
								}
							}
						}
					}
					<p class="text-sm opacity-70">A global admin manages lifecycle assignment.</p>
				}
			</div>
		</form>
		if isEdit {
			@ProjectMembersSection(project, members, availableUsers, canManage)
			<div class="mt-8 pt-6 border-t border-base-300 flex flex-wrap items-center justify-between gap-4">
				<div>
					<div class="font-medium">Delete this project</div>
					<div class="text-sm text-gray-500">Steps, variables, and releases will be deleted too.</div>
				</div>
				<button
					class="btn btn-error"
					hx-delete={ fmt.Sprintf("/projects/%d", project.ID) }
					hx-confirm="Delete this project? Steps, variables, and releases will also be deleted."
					data-toast-success="Project deleted"
					data-toast-error="Failed to delete project"
				>
					Delete project
				</button>
			</div>
		}
	</div>
}

templ ResourceFormDialog(title string, selector string) {
	<dialog x-ref="dialog" id="project-edit-dialog" class="modal" aria-label={ title } x-on:close="closed" x-on:click.capture="backClicked" hx-headers={ `{"X-Form-Dialog":"true"}` } hx-target="#project-edit-content" hx-select={ selector } hx-swap="innerHTML" hx-boost="false">
		<div class="modal-box w-full max-w-4xl">
			<div id="project-edit-content" x-ref="content" class="[&_.page-header]:sticky [&_.page-header]:-top-6 [&_.page-header]:z-10 [&_.page-header]:bg-base-100 [&_.page-header]:py-2 [&_.page-header]:-mx-6 [&_.page-header]:px-6"></div>
		</div>
		<form method="dialog" class="modal-backdrop"><button type="submit" aria-label={ "Close " + title }></button></form>
	</dialog>
}

templ ProjectFormPage(project db.Project, isEdit bool, errorMsg string, lifecycles []db.Lifecycle, members []db.ListProjectMembersRow, availableUsers []db.ListUsersRow, canManage bool, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			projectFormTitle(isEdit),
			projectFormAction(isEdit),
			"a project",
			projectFormBackHref(isEdit),
			currentPath,
		)
	} else {
		@layouts.Base("Project Form", currentPath) {
			@ProjectForm(project, isEdit, errorMsg, lifecycles, members, availableUsers, canManage)
		}
	}
}

func projectFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit project"
	}
	return "New project"
}

func projectFormAction(isEdit bool) string {
	if isEdit {
		return "edit"
	}
	return "create"
}

func projectFormBackHref(isEdit bool) string {
	// Both new and edit land back on the project list; on the new
	// path there's no project detail to return to.
	return "/projects"
}


templ NewResourceButton(path string, title string) {
	<a href={ templ.SafeURL(path) } hx-get={ path } hx-target="#project-edit-content" hx-select="[data-create-form], [data-project-form]" hx-swap="innerHTML" hx-push-url="false" hx-boost="false" x-ref="editButton" class="btn btn-primary">{ title }</a>
}
