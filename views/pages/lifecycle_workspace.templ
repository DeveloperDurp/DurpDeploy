package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"strconv"
)

type LifecycleWorkspace struct {
	Lifecycle             db.Lifecycle
	Stages                []LifecycleStageView
	AvailableEnvironments []db.Environment
	Shared                LifecycleVariables
	Error                 string
}

templ LifecycleDetailPage(workspace LifecycleWorkspace, currentPath string) {
	{{ lc := workspace.Lifecycle }}
	@layouts.Base("Lifecycle: "+lc.Name, currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Lifecycles", Href: "/lifecycles"},
			{Label: lc.Name},
		})
		@LifecycleDetail(workspace)
	}
}

templ LifecycleDetail(workspace LifecycleWorkspace) {
	{{ lc := workspace.Lifecycle }}
	{{ errorMsg := workspace.Error }}
	<div class="space-y-6" data-create-form>
		<div class="page-header">
			<div class="min-w-0">
				<h1 class="text-3xl font-bold break-all">{ lc.Name }</h1>
			</div>
			<div class="flex gap-2 shrink-0">
				if CanWrite(ctx) {
					<button type="submit" form="lifecycle-settings-form" class="btn btn-primary md:btn-sm">Save</button>
				}
				<a href="/lifecycles" class="btn btn-ghost md:btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
		</div>
		<div class="card bg-base-200 p-4">
			<h2 class="text-xl font-bold mb-4">Promotion order</h2>
			<p class="text-sm text-gray-400 mb-4">Releases must deploy successfully to each stage before they can be promoted to the next.</p>
			@LifecycleStageList(lc, workspace.Stages, workspace.AvailableEnvironments)
		</div>
		@SharedLifecycleVariables(workspace.Shared)
		if CanWrite(ctx) {
			<div class="card bg-base-200 p-4">
				<h2 class="text-xl font-bold mb-4">Lifecycle settings</h2>
				<form id="lifecycle-settings-form" method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10)) } hx-post={ "/lifecycles/" + strconv.FormatInt(lc.ID, 10) } class="space-y-4" data-lifecycle-settings>
					<input type="hidden" name="_method" value="put"/>
					<div class="form-control">
						<label class="label" for="lifecycle-name"><span class="label-text">Name</span></label>
						<input id="lifecycle-name" type="text" name="name" class="input input-bordered w-full" value={ lc.Name } required/>
						if errorMsg != "" {
							<span class="text-error text-sm mt-1">{ errorMsg }</span>
						}
					</div>
					<div class="form-control">
						<label class="label" for="lifecycle-description"><span class="label-text">Description</span></label>
						<textarea id="lifecycle-description" name="description" class="textarea textarea-bordered w-full" rows="3">{ lc.Description.String }</textarea>
					</div>
				</form>
				<div class="mt-6 pt-4 border-t border-base-300 flex flex-wrap items-center justify-between gap-4">
					<div>
						<div class="font-medium">Delete this lifecycle</div>
						<p class="text-sm opacity-70">Projects using it will be unset.</p>
					</div>
					<form
						method="post"
						action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10)) }
						hx-post={ "/lifecycles/" + strconv.FormatInt(lc.ID, 10) }
						hx-boost="true"
						hx-target="#page-content"
						hx-select="#page-content"
						hx-swap="outerHTML"
						hx-replace-url="/lifecycles"
						hx-confirm="Delete this lifecycle? Projects using it will be unset."
					>
						<input type="hidden" name="_method" value="delete"/>
						<button type="submit" class="btn btn-error">Delete lifecycle</button>
					</form>
				</div>
			</div>
		} else if lc.Description.Valid {
			<p class="text-gray-400">{ lc.Description.String }</p>
		}
	</div>
}
