package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"strconv"
)

templ EnvironmentsList(environments []db.Environment, currentPath string) {
	@layouts.Base("Environments", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Environments"},
		})
		@EnvironmentsListContent(environments)
	}
}

templ EnvironmentsListContent(environments []db.Environment) {
	<div id="environments-content" class="space-y-4">
		<div class="page-header">
			<h1 class="text-3xl font-bold">Environments</h1>
			if CanWrite(ctx) {
				<a href="/environments/new" class="btn btn-primary">New Environment</a>
			}
		</div>
		@EnvironmentsListFragment(environments)
	</div>
}

templ EnvironmentsListFragment(environments []db.Environment) {
	<div id="environments-list">
		if len(environments) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				if CanWrite(ctx) {
					<p class="text-gray-400 mb-4">No environments yet. Create your first environment to define deployment targets.</p>
					<a href="/environments/new" class="btn btn-primary">New Environment</a>
				} else {
					<p class="text-gray-400">No environments are available.</p>
				}
			</div>
		} else {
			<div class="space-y-3">
				for _, environment := range environments {
					@EnvironmentRow(environment)
				}
			</div>
		}
	</div>
}

templ EnvironmentRow(environment db.Environment) {
	if CanWrite(ctx) {
		@ResourceCard(environment.Name, "/environments/" + strconv.FormatInt(environment.ID, 10) + "/edit") {
			@EnvironmentCardDetails(environment)
		}
	} else {
		@ResourceCard(environment.Name, "") {
			@EnvironmentCardDetails(environment)
		}
	}
}

templ EnvironmentCardDetails(environment db.Environment) {
	<p class="opacity-70">{ environment.Description.String }</p>
	if environment.Tags.String != "" {
		<p><span class="opacity-70">Tags: </span>{ environment.Tags.String }</p>
	}
}
