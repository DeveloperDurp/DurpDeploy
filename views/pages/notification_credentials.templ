package pages

templ NotificationCredentialInput(name, label string, configured bool) {
	<input
		type="password"
		name={ name }
		aria-label={ label }
		autocomplete="new-password"
		if name == "gotify_token" {
			placeholder="Leave blank to keep the token for the same server URL"
		} else {
			placeholder="Leave blank to keep existing credential"
		}
		class="input input-bordered input-sm w-full"
	/>
	<p class="text-xs mt-2">
		if configured {
			configured
		} else {
			not configured
		}
	</p>
	<label class="label cursor-pointer justify-start gap-2">
		<input type="checkbox" name={ "clear_" + name } class="checkbox checkbox-sm"/>
		<span class="label-text">Clear credential</span>
	</label>
}
