package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"strconv"
)

templ TemplatesList(templates []db.StepTemplate, currentPath string) {
	@layouts.Base("Templates", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Templates"},
		})
		@TemplatesListContent(templates)
	}
}

templ TemplatesListContent(templates []db.StepTemplate) {
	<div id="templates-content" class="space-y-4" x-data="formDialogHost" x-on:htmx:after-settle.camel="afterSettle" x-on:htmx:before-swap.camel="beforeSwap" x-on:form-saved="saved">
		<div class="page-header">
			<h1 class="text-3xl font-bold">Templates</h1>
			if CanWrite(ctx) {
				@NewResourceButton("/templates/new", "New Template")
			}
		</div>
		@TemplatesListFragment(templates)
		if CanWrite(ctx) {
			@ResourceFormDialog("New Template", "[data-create-form]")
		}
	</div>
}

templ TemplatesListFragment(templates []db.StepTemplate) {
	<div id="templates-list">
		if len(templates) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				<p class="text-gray-400 mb-4">No templates yet. Create your first template to reuse deployment steps.</p>
				if CanWrite(ctx) {
					@NewResourceButton("/templates/new", "New Template")
				}
			</div>
		} else {
			<div class="space-y-3">
				for _, tpl := range templates {
					if CanWrite(ctx) {
						@ResourceDialogCard(tpl.Name, "/templates/" + strconv.FormatInt(tpl.ID, 10) + "/edit") {
							@TemplateCardDetails(tpl)
						}
					} else {
						@ResourceCard(tpl.Name, "/templates/" + strconv.FormatInt(tpl.ID, 10) + "/history") {
							@TemplateCardDetails(tpl)
						}
					}
				}
			</div>
		}
	</div>
}

templ TemplateCardDetails(tpl db.StepTemplate) {
	<p class="opacity-70">{ "Interpreter: " + tpl.Interpreter }</p>
	<pre class="line-clamp-2 whitespace-pre-wrap break-all font-mono text-xs opacity-70">{ tpl.ScriptBody }</pre>
}
