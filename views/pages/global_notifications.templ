package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
)

// GlobalNotificationCards renders the shared cards for global settings.
templ GlobalNotificationCards(global db.GlobalNotification) {
	<div class="mt-8">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			@SlackNotificationCard(global.SlackWebhookUrl.String != "")
			@EmailNotificationCard(global.NotifyEmails.String)
			@GotifyNotificationCard(global.GotifyUrl.String, global.GotifyToken.String != "")
			@DiscordNotificationCard(global.DiscordWebhookUrl.String != "")
		</div>
	</div>
}

// GlobalNotificationsPage is the admin-only page for configuring the
// global_notifications singleton used by project-less/system-wide events
// (e.g. litestream backup health). Mirrors ProjectNotificationsPage
// (project_detail.templ) — one form, one Save button next to Back.
templ GlobalNotificationsPage(global db.GlobalNotification, currentPath string) {
	@layouts.Base("Notification Settings", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Notification Settings"},
		})
		if CanWrite(ctx) {
			<form
				method="post"
				action="/admin/notifications/settings"
				hx-boost="true"
				hx-target="#page-content"
				hx-select="#page-content"
				hx-swap="outerHTML"
				data-toast-success="Notification settings saved"
			>
				<div class="page-header">
					<h1 class="text-3xl font-bold">Notification Settings</h1>
					<div class="flex gap-2">
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
						<a href="/admin/notifications" class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Back</a>
					</div>
				</div>
				@GlobalNotificationCards(global)
			</form>
		} else {
			<div class="page-header">
				<h1 class="text-3xl font-bold">Notification Settings</h1>
				<div class="flex gap-2">
					<a href="/admin/notifications" class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Back</a>
				</div>
			</div>
			@GlobalNotificationCards(global)
		}
	}
}
