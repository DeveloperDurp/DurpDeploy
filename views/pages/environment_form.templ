package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"strconv"
)

type EnvironmentFormData struct {
	Environment *db.Environment
}

templ EnvironmentForm(data EnvironmentFormData, isNew bool, errorMsg string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			envFormTitle(isNew),
			envFormAction(isNew),
			"an environment",
			"/environments",
			currentPath,
		)
	} else {
		@layouts.Base("Environment", currentPath) {
			@EnvironmentFormContent(data, isNew, errorMsg)
		}
	}
}

func envFormTitle(isNew bool) string {
	if isNew {
		return "New environment"
	}
	return "Edit environment"
}

func envFormAction(isNew bool) string {
	if isNew {
		return "create"
	}
	return "edit"
}

templ EnvironmentFormFragment(data EnvironmentFormData, isNew bool, errorMsg string) {
	@EnvironmentFormContent(data, isNew, errorMsg)
}

templ EnvironmentFormContent(data EnvironmentFormData, isNew bool, errorMsg string) {
	<div class="max-w-2xl mx-auto">
		<h1 class="text-3xl font-bold mb-6">
			if isNew {
				New Environment
			} else {
				Edit Environment
			}
		</h1>
		<form
			if isNew {
				method="post"
				action="/environments"
			} else {
				hx-put={ "/environments/" + strconv.FormatInt(data.Environment.ID, 10) }
				hx-target="#form-container"
				hx-swap="innerHTML"
				data-toast-success="Environment updated"
				data-toast-error="Failed to update environment"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label" for="environment-name">
					<span class="label-text">Name</span>
				</label>
				<input id="environment-name" type="text" name="name" value={ data.Environment.Name } class="input input-bordered" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label" for="environment-description">
					<span class="label-text">Description</span>
				</label>
				<textarea id="environment-description" name="description" class="textarea textarea-bordered">{ data.Environment.Description.String }</textarea>
			</div>
			<div class="form-control">
				<label class="label" for="environment-tags">
					<span class="label-text">Tags</span>
				</label>
				<input id="environment-tags" type="text" name="tags" value={ data.Environment.Tags.String } class="input input-bordered" placeholder="comma, separated, tags"/>
			</div>
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary">
					if isNew {
						Create
					} else {
						Update
					}
				</button>
				<a href="/environments" class="btn btn-ghost">Cancel</a>
			</div>
		</form>
	</div>
}
