package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/internal/interpreter"
	"durpdeploy/views/layouts"
	"strconv"
)

templ TemplateForm(tpl *db.StepTemplate, isNew bool, errorMsg string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			tplFormTitle(isNew),
			tplFormAction(isNew),
			"a template",
			"/templates",
			currentPath,
		)
	} else {
		@layouts.Base("Template", currentPath) {
			@TemplateFormContent(tpl, isNew, errorMsg)
		}
	}
}

func tplFormTitle(isNew bool) string {
	if isNew {
		return "New template"
	}
	return "Edit template"
}

func tplFormAction(isNew bool) string {
	if isNew {
		return "create"
	}
	return "edit"
}

templ TemplateFormFragment(tpl *db.StepTemplate, isNew bool, errorMsg string) {
	@TemplateFormContent(tpl, isNew, errorMsg)
}

templ TemplateFormContent(tpl *db.StepTemplate, isNew bool, errorMsg string) {
	<div class="max-w-2xl mx-auto">
		<h1 class="text-3xl font-bold mb-6">
			if isNew {
				New Template
			} else {
				Edit Template
			}
		</h1>
		<form
			if isNew {
				method="post"
				action="/templates"
			} else {
				hx-put={ "/templates/" + strconv.FormatInt(tpl.ID, 10) }
				hx-target="#form-container"
				hx-swap="innerHTML"
				data-toast-success="Template updated"
				data-toast-error="Failed to update template"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label" for="template-interpreter">
					<span class="label-text">Interpreter</span>
				</label>
				<select id="template-interpreter" name="interpreter" class="select select-bordered">
					<option value="bash" selected?={ tpl.Interpreter == "" || tpl.Interpreter == interpreter.Bash }>Bash</option>
					<option value="pwsh" selected?={ tpl.Interpreter == interpreter.PowerShell }>PowerShell</option>
					<option value="python3" selected?={ tpl.Interpreter == interpreter.Python }>Python</option>
				</select>
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" value={ tpl.Name } class="input input-bordered" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Script</span>
				</label>
				<textarea name="script_body" class="textarea textarea-bordered" rows="6">{ tpl.ScriptBody }</textarea>
			</div>
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary">
					if isNew {
						Create
					} else {
						Update
					}
				</button>
				<a href="/templates" class="btn btn-ghost">Cancel</a>
			</div>
		</form>
	</div>
}
