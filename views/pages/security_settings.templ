package pages

import (
	"encoding/base64"

	"durpdeploy/internal/auth"
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
)

func securityCredentialID(credentialID []byte) string {
	return base64.RawURLEncoding.EncodeToString(credentialID)
}

func securityPasskeyDeleteDialogID(credentialID []byte) string {
	return "passkey-delete-dialog-" + securityCredentialID(credentialID)
}

templ SecurityPage(
	credentials []db.WebauthnCredential,
	hasTOTP bool,
	hasPasskeys bool,
	factorCount int64,
	hasPassword bool,
	passwordError string,
	fresh bool,
	currentPath string,
) {
	@layouts.Base("Security", currentPath) {
		<div class="space-y-6">
			<div>
				<h1 class="text-[26px] font-bold leading-tight">Security</h1>
				<p class="mt-1.5 text-xs opacity-70">Manage your sign-in methods and recovery options.</p>
			</div>
			<section aria-label="Security status" class="flex items-center gap-3 rounded-[10px] border border-base-content/15 bg-base-200 px-4 py-3">
				<svg class={ "h-5 w-5 shrink-0", templ.KV("text-warning", factorCount == 0), templ.KV("text-success", factorCount > 0) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z"></path>
					<path d="m8 12 3 3 5-6"></path>
				</svg>
				<div class="min-w-0 flex-1">
					if factorCount == 0 {
						<p class="text-xs font-semibold leading-5">MFA is not enabled</p>
						<p class="text-xs leading-4 opacity-70">Add an authenticator or passkey to enable MFA.</p>
					} else {
						if factorCount == 1 {
							<p class="text-xs font-semibold leading-5">MFA enabled · 1 factor</p>
						} else {
							<p class="text-xs font-semibold leading-5">MFA enabled · { factorCount } factors</p>
						}
						<p class="text-xs leading-4 opacity-70">
							if hasTOTP {
								<span>Authenticator app enrolled</span>
								if hasPasskeys {
									<span> · </span>
								}
							}
							if hasPasskeys {
								<span>{ len(credentials) } passkey(s)</span>
							}
						</p>
					}
				</div>
				<span id="security-reauth-state" class="sr-only">
					if fresh {
						Your security session is fresh for the next few minutes.
					} else {
						Confirm your identity before changing security settings.
					}
				</span>
				<a href="/settings/security/reauth" class="btn btn-outline btn-sm h-8 min-h-8 shrink-0 text-xs" aria-describedby="security-reauth-state">Confirm identity</a>
			</section>
			<div class="grid items-start gap-4 sm:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
				<section aria-labelledby="security-signin-title" class="card min-w-0 rounded-[10px] border border-base-300 bg-base-200">
					<div class="border-b border-base-300 px-[18px] py-4">
						<h2 id="security-signin-title" class="text-sm font-semibold">Sign-in methods</h2>
					</div>
					@SecurityPasswordForm(hasPassword, passwordError)
					@SecurityPasskeys(credentials, hasPasskeys, factorCount)
				</section>
				<section aria-labelledby="security-mfa-title" class="card min-w-0 rounded-[10px] border border-base-300 bg-base-200">
					<div class="border-b border-base-300 px-[18px] py-4">
						<h2 id="security-mfa-title" class="text-sm font-semibold">MFA &amp; recovery</h2>
					</div>
					<div class="px-[18px] py-[17px]">
						<div class="flex flex-wrap items-center gap-2">
							<h3 class="text-sm font-semibold">Authenticator app</h3>
							if hasTOTP {
								<span class="badge badge-success badge-outline badge-xs">Enrolled</span>
							} else {
								<span class="badge badge-outline badge-xs">Not set up</span>
							}
						</div>
						<p class="mb-3 mt-1.5 text-xs leading-relaxed opacity-70">Use a six-digit code from your authenticator app.</p>
						if hasTOTP {
							<p id="totp-enrollment-state" class="sr-only">Authenticator already configured.</p>
						}
						<form method="post" action="/settings/security/totp/begin">
							if hasTOTP {
								<button type="submit" class="btn btn-outline btn-sm h-9 min-h-9 text-xs" disabled aria-describedby="totp-enrollment-state">Configured</button>
							} else {
								<button type="submit" class="btn btn-primary btn-sm h-9 min-h-9 text-xs">Set up authenticator</button>
							}
						</form>
					</div>
					if factorCount > 0 {
						<div class="border-t border-base-300 px-[18px] py-[17px]">
							<h3 class="text-sm font-semibold">Recovery codes</h3>
							<p class="mb-3 mt-1.5 text-xs leading-relaxed opacity-70">Replace your unused recovery codes and save the new set.</p>
							<form method="post" action="/settings/security/recovery/regenerate">
								<button type="submit" class="btn btn-outline btn-sm h-9 min-h-9 text-xs" aria-label="Regenerate recovery codes">Regenerate codes</button>
							</form>
						</div>
					}
				</section>
			</div>
			if factorCount > 0 {
				<section aria-labelledby="security-disable-title" class="flex flex-col items-start justify-between gap-4 border-t border-base-300 pt-5 sm:flex-row sm:items-center">
					<div class="space-y-1">
						<h2 id="security-disable-title" class="text-sm font-semibold">Disable MFA</h2>
						<p class="text-xs opacity-70">This removes all of your factors and recovery codes.</p>
					</div>
					<form method="post" action="/settings/security/disable" data-security-disable-dialog="security-disable-mfa-dialog">
						if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
							<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
						}
						<button type="submit" class="btn btn-outline btn-error btn-sm h-9 min-h-9 text-xs" data-security-disable-opener>Disable MFA</button>
					</form>
					@SecurityDisableConfirmationDialog()
				</section>
			}
		</div>
	}
}

templ SecurityPasskeys(credentials []db.WebauthnCredential, hasPasskeys bool, factorCount int64) {
	<div class="space-y-4 p-5" data-webauthn-container>
		<h3 class="font-semibold">Passkeys</h3>
		if hasPasskeys {
			<p id="passkey-enrollment-state" class="text-sm opacity-70">Passkey already configured.</p>
		} else {
			<p class="text-sm opacity-70">No passkeys enrolled.</p>
			<p class="text-sm opacity-70">Name this device so you can manage it later.</p>
		}
		<form method="post" action="/settings/security/passkeys/begin" data-webauthn-register data-webauthn-finish="/settings/security/passkeys/finish" class="flex flex-wrap items-end gap-2">
			if !hasPasskeys {
				<div class="form-control min-w-0 flex-1">
					<label class="label" for="passkey-name"><span class="label-text">Passkey name</span></label>
					<input id="passkey-name" type="text" name="name" maxlength="255" class="input input-bordered w-full" placeholder="e.g. Work laptop" required/>
				</div>
			}
			if hasPasskeys {
				<button type="submit" class="btn btn-primary btn-sm" disabled aria-describedby="passkey-enrollment-state">Add passkey</button>
			} else {
				<button type="submit" class="btn btn-primary btn-sm">Add passkey</button>
			}
		</form>
		<p data-webauthn-status role="status" aria-live="polite" class="text-sm empty:hidden"></p>
		<div data-webauthn-recovery class="space-y-2 empty:hidden"></div>
		if len(credentials) > 0 {
			<div class="space-y-4">
				for _, credential := range credentials {
					<div class="flex flex-wrap items-end gap-2 rounded-box border border-base-300 p-4">
						<form method="post" action="/settings/security/passkeys/rename" class="flex min-w-0 flex-1 flex-wrap items-end gap-2">
							<input type="hidden" name="credential_id" value={ securityCredentialID(credential.CredentialID) }/>
							<div class="form-control min-w-0 flex-1">
								<label class="label" for={ "passkey-name-" + securityCredentialID(credential.CredentialID) }><span class="label-text">Passkey name</span></label>
								<input id={ "passkey-name-" + securityCredentialID(credential.CredentialID) } type="text" name="name" value={ credential.Name } maxlength="255" class="input input-bordered input-sm w-full" required/>
							</div>
							<button type="submit" class="btn btn-ghost btn-sm">Rename</button>
						</form>
						<form method="post" action="/settings/security/passkeys/delete" data-passkey-delete-dialog={ securityPasskeyDeleteDialogID(credential.CredentialID) }>
							if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
								<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
							}
							<input type="hidden" name="credential_id" value={ securityCredentialID(credential.CredentialID) }/>
							if factorCount == 1 {
								<button type="submit" class="btn btn-error btn-sm" disabled aria-describedby="last-passkey-delete-help" data-passkey-delete-opener>Delete</button>
								<p id="last-passkey-delete-help" class="text-sm opacity-70">Keep another factor configured before deleting this passkey.</p>
							} else {
								<button type="submit" class="btn btn-error btn-sm" data-passkey-delete-opener>Delete</button>
							}
						</form>
						if factorCount > 1 {
							@PasskeyDeleteConfirmationDialog(credential)
						}
					</div>
				}
			</div>
		}
	</div>
}

templ PasskeyDeleteConfirmationDialog(credential db.WebauthnCredential) {
	<dialog
		id={ securityPasskeyDeleteDialogID(credential.CredentialID) }
		class="modal"
		aria-labelledby={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-title" }
		aria-describedby={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-description" }
		data-passkey-delete-confirmation-dialog
	>
		<div class="modal-box flex min-h-0 flex-col overflow-hidden w-11/12 max-w-lg bg-base-200">
			<h2 id={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-title" } class="shrink-0 text-lg font-bold">
				Delete passkey
			</h2>
			<div class="min-h-0 overflow-y-auto" data-modal-scroll-body>
				<p id={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-description" } class="mt-2 text-sm opacity-70">
					This permanently removes the passkey named { credential.Name } from your account.
				</p>
				<form
					id={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-form" }
					method="post"
					action="/settings/security/passkeys/delete"
					data-passkey-delete-confirmation
				>
					if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
						<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
					}
					<input type="hidden" name="credential_id" value={ securityCredentialID(credential.CredentialID) }/>
				</form>
			</div>
			<div class="modal-action shrink-0">
				<form method="dialog">
					<button type="submit" class="btn btn-ghost" autofocus>Cancel</button>
				</form>
				<button
					type="submit"
					form={ securityPasskeyDeleteDialogID(credential.CredentialID) + "-form" }
					class="btn btn-error"
					data-passkey-delete-confirm
				>
					Confirm delete
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit" aria-label="Cancel passkey deletion"></button>
		</form>
	</dialog>
}

templ SecurityDisableConfirmationDialog() {
	<dialog
		id="security-disable-mfa-dialog"
		class="modal"
		aria-labelledby="security-disable-mfa-dialog-title"
		aria-describedby="security-disable-mfa-dialog-description"
		data-security-disable-confirmation-dialog
	>
		<div class="modal-box flex min-h-0 flex-col overflow-hidden w-11/12 max-w-lg bg-base-200">
			<h2 id="security-disable-mfa-dialog-title" class="shrink-0 text-lg font-bold">
				Disable MFA
			</h2>
			<div class="min-h-0 overflow-y-auto" data-modal-scroll-body>
				<p id="security-disable-mfa-dialog-description" class="mt-2 text-sm opacity-70">
					This permanently removes all of your factors and recovery codes. You will need to enroll MFA again.
				</p>
				<form
					id="security-disable-mfa-form"
					method="post"
					action="/settings/security/disable"
					data-security-disable-confirmation
				>
					if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
						<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
					}
				</form>
			</div>
			<div class="modal-action shrink-0">
				<form method="dialog">
					<button type="submit" class="btn btn-ghost" autofocus>Cancel</button>
				</form>
				<button
					type="submit"
					form="security-disable-mfa-form"
					class="btn btn-error"
					data-security-disable-confirm
				>
					Confirm disable
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit" aria-label="Cancel MFA disable"></button>
		</form>
	</dialog>
}
