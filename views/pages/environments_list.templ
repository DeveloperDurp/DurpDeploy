package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"strconv"
)

templ EnvironmentsList(environments []db.Environment, currentPath string) {
	@layouts.Base("Environments", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Environments"},
		})
		@EnvironmentsListContent(environments)
	}
}

templ EnvironmentsListContent(environments []db.Environment) {
	<div id="environments-content" class="space-y-4">
		<div class="page-header">
			<h1 class="text-3xl font-bold">Environments</h1>
			if CanWrite(ctx) {
				<a href="/environments/new" class="btn btn-primary">New Environment</a>
			}
		</div>
		@EnvironmentsListFragment(environments)
	</div>
}

templ EnvironmentsListFragment(environments []db.Environment) {
	<div id="environments-list">
		if len(environments) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				if CanWrite(ctx) {
					<p class="text-gray-400 mb-4">No environments yet. Create your first environment to define deployment targets.</p>
					<a href="/environments/new" class="btn btn-primary">New Environment</a>
				} else {
					<p class="text-gray-400">No environments are available.</p>
				}
			</div>
		} else {
			<table class="table table-zebra table-fixed w-full block md:table">
				<thead class="hidden md:table-header-group">
					<tr>
						<th class="w-1/4">Name</th>
						<th class="w-2/5">Description</th>
						<th class="w-1/5">Tags</th>
						if CanWrite(ctx) {
							<th class="w-24">Actions</th>
						}
					</tr>
				</thead>
				<tbody class="block md:table-row-group">
					for _, environment := range environments {
						@EnvironmentRow(environment)
					}
				</tbody>
			</table>
		}
	</div>
}

templ EnvironmentRow(environment db.Environment) {
	<tr class="grid grid-cols-2 gap-3 md:table-row max-md:rounded-box max-md:bg-base-200 max-md:p-4 max-md:mb-3">
		<td class="col-span-2 min-w-0 break-all md:truncate">
			<span class="block md:hidden text-xs opacity-70 mb-1">Name</span>
			{ environment.Name }
		</td>
		<td class="col-span-2 min-w-0 break-all md:truncate">
			<span class="block md:hidden text-xs opacity-70 mb-1">Description</span>
			{ environment.Description.String }
		</td>
		<td class="col-span-2 min-w-0 break-all md:truncate">
			<span class="block md:hidden text-xs opacity-70 mb-1">Tags</span>
			{ environment.Tags.String }
		</td>
		if CanWrite(ctx) {
			<td class="col-span-2">
				<a href={ templ.SafeURL("/environments/" + strconv.FormatInt(environment.ID, 10) + "/edit") } class="btn md:btn-sm btn-ghost">Edit</a>
			</td>
		}
	</tr>
}
