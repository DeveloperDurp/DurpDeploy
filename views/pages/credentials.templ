package pages

import (
	"fmt"
	"strconv"
	"time"
	"durpdeploy/internal/repository"
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
)

type CredentialProject struct { ID int64; Name string }

type CredentialsData struct {
	Mode string
	Candidates []repository.Credential
	Environments []db.Environment
	OwnerID int64
	Lifecycle bool
	Name string
	Credentials []repository.Credential
	Projects []CredentialProject
	Error string
	Saved bool
}

func credentialOwnerPath(data CredentialsData) string {
	if data.Lifecycle { return fmt.Sprintf("/lifecycles/%d", data.OwnerID) }
	return fmt.Sprintf("/projects/%d", data.OwnerID)
}

func credentialDate(value int64) string {
	if value == 0 { return "" }
	return time.Unix(value, 0).UTC().Format("2006-01-02T15:04")
}

templ CredentialsPage(data CredentialsData, currentPath string) {
	if data.Mode != "" && !CanWrite(ctx) {
		@ViewerForbiddenMessage("Manage credentials", "manage", "credentials", credentialOwnerPath(data) + "/credentials", currentPath)
	} else {
	@layouts.Base("Credentials — " + data.Name, currentPath) {
		<div class="space-y-6">
			<div class="page-header">
				<h1 class="text-3xl font-bold break-words">Credentials — { data.Name }</h1>
				<a class="btn btn-ghost" href={ credentialOwnerPath(data) }>Back</a>
			</div>
			<p>Track expiry dates and replace credentials manually. Dates use UTC. Due soon means within 30 days.</p>
			if data.Lifecycle {
				<p>Replacements apply to new deployments of every release and runbook in these projects. Project overrides keep their own values.</p>
				<ul aria-label="Affected projects">
					for _, project := range data.Projects {
						<li><a class="link" href={ fmt.Sprintf("/projects/%d/releases", project.ID) }>{ project.Name }</a></li>
					}
				</ul>
			} else {
				<p>Rotating a project secret updates every release and runbook version with the same secret name and environment scope.</p>
				<p>Package replacements apply at the next download, including downloads from retained sources. Package versions and checksums stay pinned.</p>
				<a class="link" href={ credentialOwnerPath(data) + "/releases" }>View affected releases</a>
			}
			<p>Existing deployments keep captured variables. Re-runs capture the replacement. Saving confirms storage, not provider validity.</p>
			if data.Error != "" {
				<div class="alert alert-error" role="alert">{ data.Error }</div>
			}
			if data.Saved {
				<div class="alert alert-success" role="status">Credential changes saved.</div>
			}
			if data.Mode == "" && CanWrite(ctx) {
				<a class="btn btn-primary" href={ credentialOwnerPath(data) + "/credentials/new" }>New credential or enroll secret</a>
			}
			<p>Only explicitly enrolled variables are credentials. Ordinary secrets stay on the Variables page.</p>
			if data.Mode == "new" {
				@CredentialCreateForm(data)
			} else {
					if len(data.Credentials) == 0 {
						<p>No credentials are configured.</p>
					}
					for _, credential := range data.Credentials {
						@CredentialCard(data, credential)
					}
			}
		</div>
	}
	}
}

templ CredentialCard(data CredentialsData, credential repository.Credential) {
	<section class="card bg-base-200 shadow" data-credential-kind={ credential.Kind } data-credential-id={ strconv.FormatInt(credential.ID, 10) }>
		<div class="card-body space-y-3">
			<h2 class="card-title break-all">{ credential.Name }</h2>
			<p>Type: { credential.Kind }. Status: <strong data-credential-status>{ credential.Status }</strong>.</p>
			if credential.EnvironmentID != nil {
				<p>Environment ID: { strconv.FormatInt(*credential.EnvironmentID, 10) }</p>
			} else if credential.Kind != "package" {
				<p>Environment: all environments</p>
			}
			if credential.Kind == "package" && !credential.Active {
				<p>Retained package source. Rotation does not activate this source.</p>
			}
			if credential.RotatedAt != 0 {
				<p>Last rotated (UTC): { credentialDate(credential.RotatedAt) }</p>
			}
			if credential.Inherited {
				<p>Inherited from the shared lifecycle. A lifecycle administrator manages this credential.</p>
				if CanManageLifecycleVariables(ctx) {
					<a class="link" href={ fmt.Sprintf("/lifecycles/%d/credentials", credential.LifecycleID) }>Manage shared credentials</a>
				}
			}
			if CanWrite(ctx) && !credential.Inherited && data.Mode == "edit" {
				<form method="post" action={ fmt.Sprintf("%s/credentials/%s/%d", credentialOwnerPath(data), credential.Kind, credential.ID) } class="space-y-4" data-credential-form>
					<input type="hidden" name="revision" value={ strconv.FormatInt(credential.Revision, 10) }/>
					<label class="form-control"><span class="label-text">Expires at (UTC)</span><input type="datetime-local" name="expires_at" class="input input-bordered w-full" value={ credentialDate(credential.ExpiresAt) }/></label>
					<label class="form-control"><span class="label-text">Rotate by (UTC)</span><input type="datetime-local" name="rotation_due_at" class="input input-bordered w-full" value={ credentialDate(credential.RotationDueAt) }/></label>
					<label class="form-control"><span class="label-text">Replacement credential</span><input type="password" name="value" class="input input-bordered w-full" autocomplete="new-password"/></label>
					<p class="text-sm">Leave the replacement blank to keep the current credential. A replacement updates the credential and dates together.</p>
					<button class="btn btn-primary" type="submit">Save</button>
				</form>
			} else if data.Mode == "delete" && CanWrite(ctx) && credential.Kind != "package" {
				<p>Delete this credential source? Existing release snapshots and deployment history remain available.</p>
				<form method="post" action={ fmt.Sprintf("%s/credentials/%s/%d/delete", credentialOwnerPath(data), credential.Kind, credential.ID) }>
					<input type="hidden" name="revision" value={ strconv.FormatInt(credential.Revision, 10) }/>
					<button class="btn btn-error" type="submit">Delete credential</button>
				</form>
			} else {
				<p>Expires at (UTC): { credentialDate(credential.ExpiresAt) }</p>
				<p>Rotate by (UTC): { credentialDate(credential.RotationDueAt) }</p>
				if CanWrite(ctx) && !credential.Inherited {
					<div class="flex flex-wrap gap-2"><a class="btn btn-sm" href={ fmt.Sprintf("%s/credentials/%s/%d/edit", credentialOwnerPath(data), credential.Kind, credential.ID) }>Edit credential</a>
					if credential.Kind != "package" {
						<a class="btn btn-sm btn-outline" href={ fmt.Sprintf("%s/credentials/%s/%d/delete", credentialOwnerPath(data), credential.Kind, credential.ID) }>Delete credential</a>
					}
					</div>
				}
			}
		</div>
	</section>
}

templ CredentialCreateForm(data CredentialsData) {
	<section class="card bg-base-200"><div class="card-body">
		<h2 class="card-title">New credential variable</h2>
		<form method="post" action={ credentialOwnerPath(data) + "/credentials" } class="space-y-4" data-credential-create>
			<label class="form-control"><span class="label-text">Name</span><input class="input input-bordered w-full" name="name" required maxlength="255" pattern="[A-Za-z_][A-Za-z0-9_]*"/></label>
			@VariableNameHelp()
			<label class="form-control"><span class="label-text">Credential value</span><input class="input input-bordered w-full" name="value" type="password" autocomplete="new-password" required/></label>
			<label class="form-control"><span class="label-text">Environment</span><select class="select select-bordered w-full" name="environment_id"><option value="">All environments</option>
				for _, environment := range data.Environments {
					<option value={ strconv.FormatInt(environment.ID, 10) }>{ environment.Name }</option>
				}
			</select></label>
			<label class="form-control"><span class="label-text">Expires at (UTC)</span><input class="input input-bordered w-full" name="expires_at" type="datetime-local"/></label>
			<label class="form-control"><span class="label-text">Rotate by (UTC)</span><input class="input input-bordered w-full" name="rotation_due_at" type="datetime-local"/></label>
			<p>Credential variables are secret. The name and environment stay fixed after creation. Use rotation to replace the value.</p>
			<button type="submit" class="btn btn-primary">Create credential</button>
		</form>
	</div></section>
	<section class="space-y-4" data-credential-enrollment>
		<h2 class="text-xl font-bold">Enroll an existing secret</h2><p>Select each secret explicitly. Enrollment preserves its value and dates.</p>
		if len(data.Candidates) == 0 {
			<p>No ordinary secrets are available for enrollment.</p>
		}
		for _, candidate := range data.Candidates {
			<form class="card bg-base-200 p-4 space-y-2" method="post" action={ credentialOwnerPath(data) + "/credentials/enroll" } data-enrollment-id={ strconv.FormatInt(candidate.ID, 10) }>
				<p class="font-mono break-all">{ candidate.Name }</p>
				if candidate.EnvironmentID != nil {
					<p>Environment ID: { strconv.FormatInt(*candidate.EnvironmentID, 10) }</p>
				} else {
					<p>All environments</p>
				}
				<input type="hidden" name="variable_id" value={ strconv.FormatInt(candidate.ID, 10) }/><input type="hidden" name="revision" value={ strconv.FormatInt(candidate.Revision, 10) }/>
				<button type="submit" class="btn btn-outline btn-sm">Enroll as credential</button>
			</form>
		}
	</section>
}
