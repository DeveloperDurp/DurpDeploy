package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

templ ArtifactRepositoriesPage(project db.Project, repositories []db.PackageRepository, selectedID int64, currentPath string) {
	@layouts.Base("Package repositories", currentPath) {
		@components.Breadcrumbs([]components.Crumb{{Label:"Projects",Href:"/projects"},{Label:project.Name,Href:fmt.Sprintf("/projects/%d",project.ID)},{Label:"Package repositories"}})
		<div class="space-y-6">
			<div class="flex flex-wrap justify-between items-center gap-2">
				<h1 class="text-3xl font-bold">Package repositories — { project.Name }</h1>
				if CanWrite(ctx) {
					<a class="btn btn-primary btn-sm" href={ fmt.Sprintf("/projects/%d/package-repositories/new", project.ID) }>New repository</a>
				}
			</div>
			<div class="card bg-base-200 shadow"><div class="card-body">
				<h2 class="card-title">Release package</h2>
				<p>Release creation and refresh use the release version in the selected HTTPS ZIP template and pin its SHA-256. Every step receives <code class="font-mono">ARTIFACT_PATH</code>. Files are read-only and direct execution is blocked.</p>
				if CanWrite(ctx) {
					<form method="post" action={ fmt.Sprintf("/projects/%d/artifact-repository",project.ID) } class="space-y-4">
						<label class="form-control"><span class="label-text">Repository for new snapshots</span><select name="repository_id" class="select select-bordered"><option value="0" selected?={ selectedID==0 }>No package</option>
						for _, repository := range repositories {
							<option value={ strconv.FormatInt(repository.ID,10) } selected?={ selectedID==repository.ID }>{ repository.Name }</option>
						}
						</select></label>
						<button class="btn btn-primary" type="submit">Save selection</button>
					</form>
				} else {
					if selectedID==0 {
						<p class="text-sm opacity-70">No package selected.</p>
					}
					for _, repository := range repositories {
						if repository.ID==selectedID {
							<p>Selected: { repository.Name }</p>
						}
					}
				}
			</div></div>
			<div class="overflow-x-auto"><table class="table table-zebra table-fixed w-full">
				<thead><tr><th class="w-1/4">Name</th><th class="w-auto">HTTPS ZIP template</th><th class="w-48">Actions</th></tr></thead>
				<tbody>
				for _, repository := range repositories {
					<tr><td class="truncate">{ repository.Name }</td><td class="truncate" title={ repository.UrlTemplate }>{ repository.UrlTemplate }</td><td>
						if CanWrite(ctx) {
							<div class="flex gap-2 whitespace-nowrap"><a class="btn btn-xs" href={ fmt.Sprintf("/projects/%d/package-repositories/%d/edit",project.ID,repository.ID) }>Edit</a><form method="post" action={ fmt.Sprintf("/projects/%d/package-repositories/%d/delete",project.ID,repository.ID) }><button class="btn btn-xs btn-error" type="submit">Delete</button></form></div>
						}
					</td></tr>
				}
				</tbody>
			</table></div>
			if len(repositories)==0 {
				<p class="text-sm opacity-70">No package repositories configured.</p>
			}
		</div>
	}
}

templ ArtifactRepositoryForm(project db.Project, repository db.PackageRepository, errorMessage string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage("Package repository","edit","a package repository",fmt.Sprintf("/projects/%d/package-repositories",project.ID),currentPath)
	} else {
		@layouts.Base("Package repository",currentPath) {
			<div class="space-y-6">
				<h1 class="text-3xl font-bold">Package repository</h1>
				<div class="card bg-base-200 shadow"><div class="card-body">
					if errorMessage!="" {
						<div class="alert alert-error" role="alert">{ errorMessage }</div>
					}
					<form method="post" action={ artifactRepositorySaveURL(project.ID,repository.ID) } class="space-y-4">
						<label class="form-control"><span class="label-text">Name</span><input name="name" value={ repository.Name } class="input input-bordered" maxlength="255" required/></label>
						<label class="form-control"><span class="label-text">HTTPS ZIP URL template</span><input name="url_template" value={ repository.UrlTemplate } class="input input-bordered" placeholder="https://repo.example/app/{version}/package.zip" required/></label>
						<p class="text-sm opacity-70">Use exactly one {"{version}"} in the URL path. Query strings and credentials in URLs are not allowed.</p>
						<label class="form-control"><span class="label-text">Authentication</span><select name="auth_type" class="select select-bordered"><option value="noauth" selected?={ repository.AuthType=="noauth" }>None</option><option value="bearer" selected?={ repository.AuthType=="bearer" }>Bearer token</option><option value="basic" selected?={ repository.AuthType=="basic" }>Basic authentication</option></select></label>
						<label class="form-control"><span class="label-text">Username (basic authentication only)</span><input name="username" value={ repository.Username } class="input input-bordered" autocomplete="off"/></label>
						<label class="form-control"><span class="label-text">Token or password</span><input name="credential" type="password" class="input input-bordered" autocomplete="new-password"/></label>
						<p class="text-sm opacity-70">Credentials are encrypted and never displayed. Leave blank when editing to retain the current credential. Pinned repositories allow only name and credential changes.</p>
						<div class="flex gap-2"><button class="btn btn-primary" type="submit">Save repository</button><a class="btn btn-ghost" href={ fmt.Sprintf("/projects/%d/package-repositories",project.ID) }>Cancel</a></div>
					</form>
				</div></div>
			</div>
		}
	}
}

func artifactRepositorySaveURL(projectID,repositoryID int64) string {
	if repositoryID==0 { return fmt.Sprintf("/projects/%d/package-repositories",projectID) }
	return fmt.Sprintf("/projects/%d/package-repositories/%d",projectID,repositoryID)
}
