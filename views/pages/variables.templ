package pages

import (
	"cmp"
	"durpdeploy/internal/db"
	"fmt"
	"slices"
	"strconv"
)

const variableNameGuidance = "Use 1–255 ASCII letters, digits, or underscores. Start with a letter or underscore. ARTIFACT_PATH, DURPDEPLOY_STAGE_DIR, and DURPDEPLOY_APPROVED_DIR are reserved."

templ VariableNameHelp() {
	<p class="text-sm opacity-70 mt-1 break-words" data-variable-name-help>{ variableNameGuidance }</p>
	<p class="hidden text-error text-sm mt-1 peer-user-invalid:block" role="alert" data-variable-name-error>Invalid variable name. Follow the format above.</p>
}

func filterUnscoped(vars []db.Variable) []db.Variable {
	result := make([]db.Variable, 0)
	for _, v := range vars {
		if !v.EnvironmentID.Valid && v.IsCredential == 0 {
			result = append(result, v)
		}
	}
	return result
}

func filterScoped(vars []db.Variable) []db.Variable {
	result := make([]db.Variable, 0)
	for _, v := range vars {
		if v.EnvironmentID.Valid && v.IsCredential == 0 {
			result = append(result, v)
		}
	}
	return result
}

func scopedVariableGroups(variables []db.Variable) [][]db.Variable {
	scoped := filterScoped(variables)
	slices.SortStableFunc(scoped, func(a, b db.Variable) int {
		if byName := cmp.Compare(a.Name, b.Name); byName != 0 {
			return byName
		}
		return cmp.Compare(a.EnvironmentID.Int64, b.EnvironmentID.Int64)
	})
	var groups [][]db.Variable
	for start := 0; start < len(scoped); {
		end := start + 1
		for end < len(scoped) && scoped[end].Name == scoped[start].Name {
			end++
		}
		groups = append(groups, scoped[start:end])
		start = end
	}
	return groups
}

func envNameForID(environments []db.Environment, id int64) string {
	for _, env := range environments {
		if env.ID == id {
			return env.Name
		}
	}
	return ""
}

func variableEditValue(variable db.Variable) string {
	if variable.Secret != 0 {
		return ""
	}
	return variable.Value.String
}

func variableScopeAvailable(variable db.Variable, environments []db.Environment) bool {
	if !variable.EnvironmentID.Valid {
		return true
	}
	for _, environment := range environments {
		if environment.ID == variable.EnvironmentID.Int64 {
			return true
		}
	}
	return false
}

templ VariableForm(projectID int64, environments VariableEnvironments, errorMsg string) {
	<details class="mb-4" data-variable-create open?={ errorMsg != "" }>
		<summary class="btn btn-primary min-h-11 md:btn-sm cursor-pointer" x-on:click="focusCreate($el)">
			Add variable <span aria-hidden="true">▾</span>
		</summary>
		<form
			hx-post={ fmt.Sprintf("/projects/%d/variables", projectID) }
			hx-target="#variables-content"
			hx-swap="outerHTML"
			data-toast-success="Variable created"
			data-toast-error="Failed to create variable"
			class="mt-3 rounded-box bg-base-200 border border-base-content/20 p-4 flex flex-wrap gap-4 items-end"
		>
			<div class="form-control flex-1 min-w-0 basis-48">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" class="peer input input-bordered" required pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="255" title={ variableNameGuidance } aria-label="Name" aria-description={ variableNameGuidance }/>
				@VariableNameHelp()
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
		<div class="flex flex-wrap gap-4 items-end w-full min-w-0" x-data="{ secret: false }">
 			<div class="form-control flex-1 min-w-[200px]">
 				<label class="label">
 					<span class="label-text">Value</span>
 				</label>
				<input :type="secret ? 'password' : 'text'" name="value" aria-label="Value" :placeholder="secret ? '••••••••' : ''" class="input input-bordered w-full min-w-0"/>
 			</div>
			<div class="form-control flex-1 min-w-0 basis-48">
 				<label class="label">
 					<span class="label-text">Environment</span>
 				</label>
				<select name="environment_id" aria-label="Environment" class="select select-bordered w-full min-w-0">
 					<option value="">Unscoped</option>
				for _, env := range environments.Options {
 						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
 					}
 				</select>
 			</div>
  		<div class="form-control justify-end pb-1">
 			<label class="cursor-pointer flex items-center gap-1">
 				<input type="checkbox" name="secret" class="checkbox checkbox-sm" x-model="secret"/>
 				<span class="text-sm">Secret</span>
 				</label>
 			</div>
 			<button type="submit" class="btn btn-primary">Add Variable</button>
 		</div>
		</form>
	</details>
}

templ VariablesTable(project db.Project, variables []db.Variable, environments VariableEnvironments) {
	{{ unscoped := filterUnscoped(variables) }}
	{{ groups := scopedVariableGroups(variables) }}
	<table class="hidden md:table table-zebra table-fixed w-full">
		<thead>
			<tr>
				<th class="w-1/5">Name</th>
				<th class="w-1/4">Value</th>
				<th class="w-1/6">Environment</th>
				<th class="hidden md:table-cell w-1/6">Secret</th>
				<th class="w-1/5">Actions</th>
			</tr>
		</thead>
		<tbody>
			<tr class="bg-base-300">
				<td colspan="5" class="font-bold">Global Defaults</td>
			</tr>
			if len(unscoped) == 0 {
				<tr>
					<td colspan="5" class="text-gray-500 italic text-center py-4">No unscoped variables.</td>
				</tr>
			} else {
				for _, v := range unscoped {
					@VariableRow(project.ID, v, environments, "")
				}
			}
		</tbody>
		<tbody>
			<tr class="bg-base-300">
				<td colspan="5" class="font-bold">Per-Environment Overrides</td>
			</tr>
			if len(groups) == 0 {
				<tr>
					<td colspan="5" class="text-gray-500 italic text-center py-4">No environment-scoped variables.</td>
				</tr>
			}
		</tbody>
		for _, group := range groups {
			@VariableDesktopGroup(project.ID, group, environments, variableGroupView{})
		}
	</table>
	<div class="space-y-6 md:hidden" data-mobile-variable-list>
		<section class="space-y-3" aria-labelledby="mobile-global-variables">
			<h2 id="mobile-global-variables" class="font-bold">Global Defaults</h2>
			if len(unscoped) == 0 {
				<p class="text-gray-500 italic text-center py-4">No unscoped variables.</p>
			} else {
				<ul class="space-y-3" aria-label="Global variables">
					for _, variable := range unscoped {
						@VariableMobileRecord(project.ID, variable, environments, "")
					}
				</ul>
			}
		</section>
		<section class="space-y-3" aria-labelledby="mobile-scoped-variables">
			<h2 id="mobile-scoped-variables" class="font-bold">Per-Environment Overrides</h2>
			if len(groups) == 0 {
				<p class="text-gray-500 italic text-center py-4">No environment-scoped variables.</p>
			} else {
				<ul class="space-y-3" aria-label="Environment-scoped variables">
					for _, group := range groups {
						@VariableMobileGroup(project.ID, group, environments, variableGroupView{})
					}
				</ul>
			}
		</section>
	</div>
}

templ VariableRow(projectID int64, variable db.Variable, environments VariableEnvironments, formID string) {
	{{ scope := envNameForID(environments.All, variable.EnvironmentID.Int64) }}
	<tr
		id={ fmt.Sprintf("variable-row-%d", variable.ID) }
		x-data={ fmt.Sprintf("{ editing: false, secret: %v }", variable.Secret != 0) }
	>
		<td class="font-medium truncate">
			if !variable.EnvironmentID.Valid {
				{ variable.Name }
			}
		</td>
		<td class={ templ.KV("truncate", formID == "") } data-variable-value>
			if formID == "" {
				@ProjectVariableValue(variable)
			} else {
				@VariableGroupField(variable, environments, formID, scope)
			}
		</td>
		<td class="truncate">
			if variable.EnvironmentID.Valid {
				{ scope }
			} else {
				<span class="badge badge-ghost badge-sm">Global</span>
			}
		</td>
		<td class="hidden md:table-cell truncate">
			if variable.Secret != 0 {
				<span class="badge badge-warning badge-sm">secret</span>
			}
		</td>
		<td>
			if formID == "" && CanWrite(ctx) {
				<div
					if variable.EnvironmentID.Valid {
						x-cloak
						x-show="managing"
					}
				>
					@VariableActions(projectID, variable, scope)
					<div x-cloak x-show="editing" x-ref="variableEditor" tabindex="-1" data-desktop-variable-edit={ strconv.FormatInt(variable.ID, 10) } class="min-w-0 mt-2">
						@VariableQuickEditForm(projectID, variable, environments)
					</div>
				</div>
			}
		</td>
	</tr>
}

templ ProjectVariableValue(variable db.Variable) {
	if variable.Secret != 0 {
		<span class="text-base-content/75">••••••••</span>
	} else if variable.Value.Valid {
		{ variable.Value.String }
	} else {
		<span class="text-base-content/75 italic">(empty)</span>
	}
}

templ VariableActions(projectID int64, variable db.Variable, scope string) {
	{{ label := "Actions for " + variable.Name }}
	if scope != "" {
		{{ label += " in " + scope }}
	}
	@VariableMenu(label) {
		if !variable.EnvironmentID.Valid {
			<li><button type="button" class="min-h-11 md:min-h-0" data-variable-action="override" data-override-for={ variable.Name }>Override</button></li>
		}
		<li>
			<button
				type="button"
				class="min-h-11 md:min-h-0"
				data-variable-action="edit"
				x-on:click.capture="$event.stopImmediatePropagation(); $refs.variableMenu.open = false; editing = true; $nextTick(() => $refs.variableEditor.focus())"
				hx-get={ fmt.Sprintf("/projects/%d/variables/%d/edit", projectID, variable.ID) }
				hx-target={ fmt.Sprintf("#variable-row-%d", variable.ID) }
				hx-swap="outerHTML"
			>
				Edit
			</button>
		</li>
		<li>
			<button
				type="button"
				class="min-h-11 md:min-h-0"
				data-variable-action="delete"
				hx-delete={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
				hx-target="#variables-content"
				hx-swap="outerHTML"
				hx-confirm="Delete this variable?"
				data-toast-success="Variable deleted"
				data-toast-error="Failed to delete variable"
			>
				Delete
			</button>
		</li>
	}
}

templ VariableGroupActions(projectID, anchorID int64, name, layout string) {
	<div data-variable-group-actions={ strconv.FormatInt(anchorID, 10) } x-ref="groupActions">
		@VariableMenu("Actions for " + name) {
			<li>
				<button
					type="button"
					class="min-h-11 md:min-h-0"
					hx-get={ VariableGroupPath(projectID, anchorID) + "?layout=" + layout }
					hx-target="closest [data-variable-group]"
					hx-swap="none"
					hx-sync="closest [data-variable-group]:drop"
					data-toast-error="Could not open the variable editor"
					data-variable-group-edit
				>Edit</button>
			</li>
			<li><button type="button" class="min-h-11 md:min-h-0" data-variable-group-manage x-on:click="managing = !managing" x-text="managing ? 'Done managing' : 'Manage individually'">Manage individually</button></li>
		}
	</div>
}

templ VariableMenu(label string) {
	<details
		class="group relative inline-block shrink-0"
		data-variable-menu
		x-ref="variableMenu"
		x-on:click.outside="$el.open = false"
		x-on:focusout="if (!$el.contains($event.relatedTarget)) $el.open = false"
		x-on:keydown.escape="if ($el.open) { $event.stopPropagation(); $el.open = false; $refs.variableActions.focus() }"
	>
		<summary class="btn btn-ghost min-h-11 md:min-h-0 md:btn-sm list-none" aria-label={ label } x-ref="variableActions" data-variable-action="menu">
			Actions <span aria-hidden="true">▾</span>
		</summary>
		<ul class="absolute end-0 top-full z-30 hidden group-open:flex menu min-w-36 rounded-lg border border-base-content/20 bg-base-100 p-1 shadow-lg"
			x-on:click="if ($event.target.closest('button, a')) { $refs.variableMenu.open = false; $refs.variableActions.focus() }"
		>
			{ children... }
		</ul>
	</details>
}

templ VariableQuickEditForm(projectID int64, variable db.Variable, environments VariableEnvironments) {
	<form
		hx-put={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
		hx-target="#variables-content"
		hx-swap="outerHTML"
		data-toast-success="Variable updated"
		data-toast-error="Failed to update variable"
		class="space-y-3"
	>
		<div class="form-control">
			<label class="label"><span class="label-text">Name</span></label>
			<input type="text" name="name" value={ variable.Name } class="peer input input-bordered input-sm w-full" required pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="255" title={ variableNameGuidance } aria-label="Name" aria-description={ variableNameGuidance }/>
			@VariableNameHelp()
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">Value</span></label>
			<input :type="secret ? 'password' : 'text'" name="value" aria-label="Value" value={ variableEditValue(variable) } :placeholder="secret ? 'Leave blank to keep existing secret' : ''" class="input input-bordered input-sm w-full"/>
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">Environment</span></label>
			<select name="environment_id" aria-label="Environment" class="select select-bordered select-sm w-full">
				<option value="">Unscoped</option>
				if !variableScopeAvailable(variable, environments.Options) {
					<option value={ strconv.FormatInt(variable.EnvironmentID.Int64, 10) } selected hidden>Choose a new scope (current scope is outside lifecycle)</option>
				}
				for _, env := range environments.Options {
					if variable.EnvironmentID.Valid && env.ID == variable.EnvironmentID.Int64 {
						<option value={ strconv.FormatInt(env.ID, 10) } selected>{ env.Name }</option>
					} else {
						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
					}
				}
			</select>
		</div>
		<label class="cursor-pointer flex items-center gap-2">
			<input type="checkbox" name="secret" checked?={ variable.Secret != 0 } class="checkbox checkbox-sm" x-model="secret"/>
			<span class="text-sm">Secret</span>
		</label>
		<div class="flex flex-wrap gap-2">
			<button type="reset" class="btn btn-ghost min-h-11 md:min-h-0 md:btn-sm" x-on:click="editing = false; $refs.variableActions.focus()">Cancel</button>
			<button type="submit" class="btn btn-primary min-h-11 md:min-h-0 md:btn-sm">Save</button>
		</div>
	</form>
}

templ VariableMobileRecord(projectID int64, variable db.Variable, environments VariableEnvironments, formID string) {
	{{ scope := envNameForID(environments.All, variable.EnvironmentID.Int64) }}
	<li
		class={ "p-3", templ.KV("rounded-lg border border-base-content/20 bg-base-200", !variable.EnvironmentID.Valid) }
		data-mobile-variable={ strconv.FormatInt(variable.ID, 10) }
		x-data={ fmt.Sprintf("{ editing: false, secret: %v }", variable.Secret != 0) }
	>
		<div class="flex items-start justify-between gap-2">
			<div class={ "min-w-0", templ.KV("w-full", formID != "") }>
				if variable.EnvironmentID.Valid {
					<h4 class="text-sm font-semibold break-words">{ scope }</h4>
				} else {
					<h3 class="text-sm font-semibold font-mono break-all">{ variable.Name }</h3>
				}
				<div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-variable-value>
					if formID == "" {
						<span class="sr-only">Value</span>
						<span class="min-w-0 font-mono break-all">@ProjectVariableValue(variable)</span>
					} else {
						@VariableGroupField(variable, environments, formID, scope)
					}
					if variable.Secret != 0 {
						<span class="badge badge-warning badge-sm">Secret</span>
					}
				</div>
			</div>
			if formID == "" && CanWrite(ctx) {
				<div
					if variable.EnvironmentID.Valid {
						x-cloak
						x-show="managing"
					}
				>
					@VariableActions(projectID, variable, scope)
				</div>
			}
		</div>
		if formID == "" && CanWrite(ctx) {
			<div x-cloak x-show="editing && (typeof managing === 'undefined' || managing)" x-ref="variableEditor" tabindex="-1" data-mobile-variable-edit={ strconv.FormatInt(variable.ID, 10) } class="mt-3 rounded-lg border border-base-content/20 bg-base-100 p-3">
				@VariableQuickEditForm(projectID, variable, environments)
			</div>
		}
	</li>
}

templ VariableEditRow(projectID int64, variable db.Variable, environments VariableEnvironments, errorMsg string) {
	<tr
		id={ fmt.Sprintf("variable-row-%d", variable.ID) }
		x-data={ fmt.Sprintf("{ secret: %v }", variable.Secret != 0) }
	>
		<td class="font-medium">
			<form
				id={ fmt.Sprintf("variable-edit-form-%d", variable.ID) }
				hx-put={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
				hx-target="#variables-content"
				hx-swap="outerHTML"
				data-toast-success="Variable updated"
				data-toast-error="Failed to update variable"
			></form>
			<input type="text" name="name" value={ variable.Name } form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="peer input input-bordered input-sm w-full" required pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="255" title={ variableNameGuidance } aria-label="Name" aria-description={ variableNameGuidance }/>
			@VariableNameHelp()
			if errorMsg != "" {
				<span class="text-error text-sm mt-1">{ errorMsg }</span>
			}
		</td>
		<td>
			<input :type="secret ? 'password' : 'text'" name="value" value={ variableEditValue(variable) } :placeholder="secret ? 'Leave blank to keep existing secret' : ''" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="input input-bordered input-sm w-full"/>
		</td>
		<td>
			<select name="environment_id" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="select select-bordered select-sm w-full">
				<option value="">Unscoped</option>
				if !variableScopeAvailable(variable, environments.Options) {
					<option value={ strconv.FormatInt(variable.EnvironmentID.Int64, 10) } selected hidden>Choose a new scope (current scope is outside lifecycle)</option>
				}
				for _, env := range environments.Options {
					if variable.EnvironmentID.Valid && env.ID == variable.EnvironmentID.Int64 {
						<option value={ strconv.FormatInt(env.ID, 10) } selected>{ env.Name }</option>
					} else {
						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
					}
				}
			</select>
		</td>
		<td>
			<label class="cursor-pointer flex items-center gap-1">
				<input type="checkbox" name="secret" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="checkbox checkbox-sm" x-model="secret"/>
				<span class="text-sm">Secret</span>
			</label>
		</td>
		<td class="flex flex-wrap gap-2 min-w-0">
			<button type="button" class="btn btn-ghost btn-sm whitespace-nowrap" hx-get={ fmt.Sprintf("/projects/%d/variables", projectID) } hx-target="#variables-content" hx-swap="outerHTML">Cancel</button>
			<button type="submit" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="btn btn-primary btn-sm whitespace-nowrap">Save</button>
		</td>
	</tr>
}
