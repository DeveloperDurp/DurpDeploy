# DurpDeploy reverse proxy — AIO container config.
#
# The site address is read from the DURPDEPLOY_URL env var (default
# `http://localhost`). The scheme matters: `http://` means Caddy serves
# plain HTTP on port 80; `https://` means Caddy serves TLS on port 443
# with auto-issued Let's Encrypt certs (host must have DNS A record +
# open 80/443 inbound).
#
# Examples:
#   dev:    DURPDEPLOY_URL=http://localhost
#   prod:   DURPDEPLOY_URL=https://durpdeploy.example.com
#
# DurpDeploy applies authentication rate limits in the Go server, so the stock
# Caddy image needs no custom rate-limit module. Add edge limits only as an
# optional second layer for unusually exposed deployments.

{$DURPDEPLOY_URL:http://localhost} {
	# Proxy to the Go server. The Go process listens on port 8080
	# (HTTP, no TLS — Caddy terminates TLS here). The default backend is
	# `localhost:8080`, which matches the systemd deploy (Go binary on
	# the same host as Caddy). In the Docker Compose stack, the Caddy
	# service sets `BACKEND=app:8080` so the reverse proxy reaches the
	# app over the compose network rather than its own loopback.
	reverse_proxy {$BACKEND:localhost:8080} {
		# Pass the original client IP through so the audit log records the
		# real requester, not Caddy's loopback address.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Access log to stdout so `docker logs` captures it (no in-container
	# log file that would grow without rotation).
	log {
		output stdout
		level INFO
	}
}
