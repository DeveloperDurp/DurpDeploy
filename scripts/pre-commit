#!/usr/bin/env bash
# Pre-commit hook: re-run golines on staged Go files so commits can't
# land with lines > 80 chars. Stays in sync with `make golines-check` (same
# flags). Only checks staged files, so a partial-stage of a dirty file
# doesn't trip the hook on lines you didn't touch.
#
# Install: `make install-hooks` (copies this to .git/hooks/pre-commit).
set -euo pipefail

if ! command -v golines >/dev/null 2>&1; then
	echo "golines not found in PATH. Install: go install github.com/segmentio/golines@v0.13.0" >&2
	exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failed=0
git diff --cached --name-only --diff-filter=ACMRT -z -- '*.go' >"$tmp/files"
while IFS= read -r -d '' file; do
	# Read the index, not the working tree: partial staging must be safe.
	git show ":$file" >"$tmp/staged.go"
	formatted=$(golines -m 80 --ignore-generated -l "$tmp/staged.go")
	if [ -n "$formatted" ]; then
		printf 'golines: staged file needs formatting: %s\n' "$file" >&2
		failed=1
	fi
done <"$tmp/files"
exit "$failed"
