package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/internal/repository"
	"durpdeploy/views/layouts"
	"net/url"
	"strconv"
)

templ AuditLogPage(entries []repository.AuditLogEntry, currentPath string, currentUser *db.User, filters url.Values) {
	@layouts.Base("Audit Log", currentPath) {
		<div class="flex justify-between items-center mb-4">
			<h1 class="text-3xl font-bold">Audit Log</h1>
		</div>
		<form method="get" action="/admin/audit" class="flex flex-wrap gap-2 mb-4 items-end">
			<div class="form-control min-w-0 max-w-full">
				<label class="label" for="audit-user"><span class="label-text">User name or email</span></label>
				<input id="audit-user" type="text" name="user" value={ filters.Get("user") } class="input input-bordered input-sm w-64 max-w-full" aria-describedby="audit-user-help"/>
				<p id="audit-user-help" class="text-xs mt-1">Enter the current name or email exactly.</p>
			</div>
			<div class="form-control">
				<label class="label" for="audit-user-id">
					<span class="label-text">User ID</span>
				</label>
				<input id="audit-user-id" type="number" name="user_id" value={ filters.Get("user_id") } class="input input-bordered input-sm w-32"/>
			</div>
			<div class="form-control">
				<label class="label" for="audit-action">
					<span class="label-text">Action</span>
				</label>
				<input id="audit-action" type="text" name="action" value={ filters.Get("action") } class="input input-bordered input-sm w-40"/>
			</div>
			<div class="form-control">
				<label class="label" for="audit-entity-type">
					<span class="label-text">Entity Type</span>
				</label>
				<input id="audit-entity-type" type="text" name="entity_type" value={ filters.Get("entity_type") } class="input input-bordered input-sm w-40"/>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Filter</button>
			<a href="/admin/audit" class="btn btn-ghost btn-sm">Clear</a>
		</form>
		if len(entries) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				<p class="text-gray-400">No audit entries match the filter.</p>
			</div>
		} else {
			<div class="hidden lg:block" data-audit-desktop>
				<table class="table table-zebra table-fixed w-full" data-audit-table>
					<thead>
						<tr>
							<th class="w-1/6">Time</th>
							<th class="w-1/4">User</th>
							<th class="w-1/6">Action</th>
							<th class="w-1/6">Target</th>
							<th class="w-1/4">Details</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range entries {
							@AuditLogRow(entry)
						}
					</tbody>
				</table>
			</div>
			<ol class="space-y-3 lg:hidden" data-mobile-audit-list>
				for _, entry := range entries {
					@AuditLogMobileRecord(entry)
				}
			</ol>
		}
	}
}

templ AuditLogRow(entry repository.AuditLogEntry) {
	<tr>
		<td class="whitespace-nowrap">{ formatUnixTime(entry.CreatedAt) }</td>
		<td class="min-w-0">@AuditActor(entry)</td>
		<td class="truncate">{ entry.Action }</td>
		<td class="break-words">@AuditTarget(entry)</td>
		<td class="align-top p-4">
			@AuditDetails(entry.AuditLog)
		</td>
	</tr>
}

templ AuditLogMobileRecord(entry repository.AuditLogEntry) {
	<li class="card bg-base-200 p-4 space-y-3">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<p class="font-medium break-words">{ entry.Action }</p>
				<p class="text-sm">@AuditTarget(entry)</p>
			</div>
			<time class="shrink-0 text-xs whitespace-nowrap">{ formatUnixTime(entry.CreatedAt) }</time>
		</div>
		<div class="min-w-0 text-sm">@AuditActor(entry)</div>
		@AuditDetails(entry.AuditLog)
	</li>
}

templ AuditActor(entry repository.AuditLogEntry) {
	<div data-audit-actor class="space-y-1 break-words">
		if entry.ActorName != "" {
			<p class="font-medium">{ entry.ActorName }</p>
		}
		if entry.ActorEmail != "" {
			<p class="text-sm break-all">{ entry.ActorEmail }</p>
		}
		if entry.UserID.Valid {
			<p class="text-xs">User ID { strconv.FormatInt(entry.UserID.Int64, 10) }</p>
		} else {
			<p class="text-xs">No user ID</p>
		}
	</div>
}

templ AuditTarget(entry repository.AuditLogEntry) {
	if entry.TargetURL != "" {
		<a href={ templ.SafeURL(entry.TargetURL) } class="link link-primary" data-audit-target>{ entry.EntityType } { strconv.FormatInt(entry.EntityID.Int64, 10) }</a>
	} else {
		<span>
			{ entry.EntityType }
			if entry.EntityID.Valid {
				{ strconv.FormatInt(entry.EntityID.Int64, 10) }
			}
		</span>
	}
}

templ AuditDetails(entry db.AuditLog) {
	<details class="block w-full min-w-0 text-sm leading-relaxed" data-disclosure="audit-details">
		<summary class="cursor-pointer text-primary">View details</summary>
		<pre class="mt-4 block w-full max-w-full min-w-0 overflow-x-auto whitespace-pre-wrap break-words rounded bg-base-100 p-4 text-xs leading-relaxed"><code>{ entry.Details.String }</code></pre>
	</details>
}
