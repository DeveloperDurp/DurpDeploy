package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

type AgentPoolsView struct {
	Pools       []db.AgentPool
	CurrentPath string
}

type AgentPoolFormView struct {
	Pool        *db.AgentPool
	CurrentPath string
}

type AgentPoolDetailView struct {
	Pool        db.AgentPool
	Members     []db.Agent
	Candidates  []db.Agent
	CurrentPath string
}

templ AgentPoolsPage(view AgentPoolsView) {
	@layouts.Base("Agent pools", view.CurrentPath) {
		<div class="space-y-4">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<h1 class="text-3xl font-bold">Agent pools</h1>
					<p class="text-sm opacity-70">Group remote agents for environment policies.</p>
				</div>
				if CanWrite(ctx) {
					<a href="/admin/pools/new" class="btn btn-primary btn-sm">New pool</a>
				}
			</div>
			if len(view.Pools) == 0 {
				<div class="card bg-base-200 p-8 text-center">
					<p class="text-gray-400">No agent pools yet.</p>
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-zebra table-fixed w-full">
						<caption class="sr-only">Agent pools</caption>
						<thead>
							<tr>
								<th class="w-1/3 sm:w-1/5">Name</th>
								<th class="hidden sm:table-cell sm:w-2/5">Description</th>
								<th class="w-20 sm:w-1/5">Status</th>
								<th class="w-36 sm:w-48">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, pool := range view.Pools {
								<tr>
									<td class="truncate font-medium">{ pool.Name }</td>
									<td class="hidden truncate sm:table-cell">{ pool.Description.String }</td>
									<td>
										if pool.Enabled == 1 {
											<span class="badge badge-success badge-outline">Enabled</span>
										} else {
											<span class="badge badge-error badge-outline">Disabled</span>
										}
									</td>
									<td class="whitespace-normal sm:whitespace-nowrap">
										<a href={ templ.SafeURL("/admin/pools/" + strconv.FormatInt(pool.ID, 10)) } class="btn btn-ghost btn-xs">Details</a>
										if CanWrite(ctx) {
											<a href={ templ.SafeURL("/admin/pools/" + strconv.FormatInt(pool.ID, 10) + "/edit") } class="btn btn-ghost btn-xs">Edit</a>
											if pool.Enabled == 1 {
												<form method="post" action={ templ.SafeURL("/admin/pools/" + strconv.FormatInt(pool.ID, 10) + "/disable") } class="inline">
													<button type="submit" class="btn btn-error btn-xs">Disable</button>
												</form>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ AgentPoolFormPage(view AgentPoolFormView) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(agentPoolFormTitle(view.Pool), agentPoolFormAction(view.Pool), "an agent pool", "/admin/pools", view.CurrentPath)
	} else {
		@layouts.Base(agentPoolFormTitle(view.Pool), view.CurrentPath) {
			<div class="max-w-2xl">
				<h1 class="mb-4 text-3xl font-bold">{ agentPoolFormTitle(view.Pool) }</h1>
				<div class="card bg-base-200 shadow">
					<div class="card-body">
						<form method="post" action={ agentPoolFormActionURL(view.Pool) } class="space-y-4">
							<div class="form-control">
								<label class="label" for="pool-name"><span class="label-text">Name</span></label>
								<input id="pool-name" type="text" name="name" value={ agentPoolName(view.Pool) } class="input input-bordered" required/>
							</div>
							<div class="form-control">
								<label class="label" for="pool-description"><span class="label-text">Description</span></label>
								<textarea id="pool-description" name="description" class="textarea textarea-bordered">{ agentPoolDescription(view.Pool) }</textarea>
							</div>
							if view.Pool != nil {
								<label class="label cursor-pointer justify-start gap-3" for="pool-enabled">
									<input id="pool-enabled" type="checkbox" name="enabled" class="toggle toggle-primary" checked?={ view.Pool.Enabled == 1 }/>
									<span class="label-text">Pool enabled</span>
								</label>
							}
							<div class="flex gap-2">
								<button type="submit" class="btn btn-primary">{ agentPoolSubmitLabel(view.Pool) }</button>
								<a href="/admin/pools" class="btn btn-ghost">Cancel</a>
							</div>
						</form>
					</div>
				</div>
			</div>
		}
	}
}

templ AgentPoolDetailsPage(view AgentPoolDetailView) {
	@layouts.Base(view.Pool.Name+" agent pool", view.CurrentPath) {
		<div class="space-y-6">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<h1 class="text-3xl font-bold">{ view.Pool.Name }</h1>
					if view.Pool.Description.Valid {
						<p class="text-sm opacity-70">{ view.Pool.Description.String }</p>
					}
				</div>
				<a href="/admin/pools" class="btn btn-ghost btn-sm">Back to pools</a>
			</div>
			<div class="card bg-base-200 shadow">
				<div class="card-body">
					<h2 class="card-title">Members</h2>
					if len(view.Members) == 0 {
						<p class="text-sm opacity-70">No agents belong to this pool.</p>
					} else {
						<div class="overflow-x-auto">
							<table class="table table-zebra table-fixed w-full">
								<caption class="sr-only">Agents in { view.Pool.Name }</caption>
								<thead><tr><th class="w-1/4">Agent</th><th class="w-1/4">Name</th><th class="w-1/4">Status</th><th class="w-48">Actions</th></tr></thead>
								<tbody>
									for _, agent := range view.Members {
										<tr>
											<td class="truncate font-mono text-sm">{ agent.ID }</td>
											<td class="truncate">{ agent.Name }</td>
											<td><span class="badge badge-outline">{ agent.Status }</span></td>
											<td class="whitespace-nowrap">
												<a href={ templ.SafeURL("/admin/agents/" + agent.ID) } class="btn btn-ghost btn-xs">Details</a>
												if CanWrite(ctx) {
													<form method="post" action={ templ.SafeURL("/admin/pools/" + strconv.FormatInt(view.Pool.ID, 10) + "/members") } class="inline">
														<input type="hidden" name="agent_id" value={ agent.ID }/>
														<button type="submit" class="btn btn-error btn-xs">Remove</button>
													</form>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
					if CanWrite(ctx) && len(view.Candidates) > 0 {
						<form method="post" action={ fmt.Sprintf("/admin/pools/%d/members", view.Pool.ID) } class="mt-4 flex flex-wrap items-end gap-2">
							<div class="form-control flex-1">
								<label class="label" for="pool-agent"><span class="label-text">Add agent</span></label>
								<select id="pool-agent" name="agent_id" class="select select-bordered" required>
									<option value="" disabled selected>Select an agent</option>
									for _, agent := range view.Candidates {
										<option value={ agent.ID }>{ agent.Name } ({ agent.ID })</option>
									}
								</select>
							</div>
							<button type="submit" class="btn btn-primary">Add member</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
}

func agentPoolFormTitle(pool *db.AgentPool) string {
	if pool == nil {
		return "New agent pool"
	}
	return "Edit agent pool"
}

func agentPoolFormAction(pool *db.AgentPool) string {
	if pool == nil {
		return "create"
	}
	return "edit"
}

func agentPoolFormActionURL(pool *db.AgentPool) templ.SafeURL {
	if pool == nil {
		return "/admin/pools"
	}
	return templ.SafeURL("/admin/pools/" + strconv.FormatInt(pool.ID, 10))
}

func agentPoolName(pool *db.AgentPool) string {
	if pool == nil {
		return ""
	}
	return pool.Name
}

func agentPoolDescription(pool *db.AgentPool) string {
	if pool == nil {
		return ""
	}
	return pool.Description.String
}

func agentPoolSubmitLabel(pool *db.AgentPool) string {
	if pool == nil {
		return "Create pool"
	}
	return "Save changes"
}
