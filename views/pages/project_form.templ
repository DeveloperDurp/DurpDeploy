package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

type ProjectExecutionPolicyView struct {
	Legacy     bool
	TargetMode string
	LabelID    int64
	LabelName  string
	Strategy   string
}

// projectFormID returns the form's id attribute. The submit button
// rendered below the form uses the same id so its `form=` attribute
// actually binds to the form — without this, clicking Create on the
// "new" page is a no-op (the button references "project-form-0" while
// the form is "project-form-new").
func projectFormID(project db.Project, isEdit bool) string {
	if isEdit {
		return fmt.Sprintf("project-form-%d", project.ID)
	}
	return "project-form-new"
}

templ ProjectForm(project db.Project, isEdit bool, errorMsg string, lifecycles []db.Lifecycle, policy ProjectExecutionPolicyView, labels []db.AgentLabel, members []db.ListProjectMembersRow, availableUsers []db.ListUsersRow, canManage bool) {
	<div class="max-w-2xl mx-auto">
		<h1 class="text-3xl font-bold mb-6">
			if isEdit {
				Edit Project
			} else {
				New Project
			}
		</h1>
		<form
			if isEdit {
				id={ projectFormID(project, isEdit) }
				hx-put={ fmt.Sprintf("/projects/%d", project.ID) }
				hx-target="#form-container"
				hx-swap="innerHTML"
				data-toast-success="Project updated"
				data-toast-error="Failed to update project"
			} else {
				id={ projectFormID(project, isEdit) }
				method="post"
				action="/projects"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" class="input input-bordered" value={ project.Name } required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Description</span>
				</label>
				<textarea name="description" class="textarea textarea-bordered" rows="4">{ project.Description.String }</textarea>
			</div>
			<div class="form-control">
				<label class="label flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:justify-between">
					<span class="label-text">Lifecycle</span>
					<span class="label-text-alt text-gray-500">Optional. Gates deployments to environments in order.</span>
				</label>
				<select name="lifecycle_id" class="select select-bordered">
					<option value="">— No lifecycle —</option>
					for _, lc := range lifecycles {
						<option
							value={ strconv.FormatInt(lc.ID, 10) }
							if project.LifecycleID.Valid && project.LifecycleID.Int64 == lc.ID {
								selected
							}
						>
							{ lc.Name }
						</option>
					}
				</select>
			</div>
			@ProjectExecutionPolicyFields(policy, labels)
		</form>
		// Both action rows live below the form tag: the destructive Delete
		// section first, then the primary Update + Cancel. This puts the
		// safe action at the very bottom where the eye lands after editing
		// a field, with the danger zone visually separated above it.
		if isEdit {
			<div class="mt-8 pt-6 border-t border-base-300 flex items-center justify-between">
				<div>
					<div class="font-medium">Delete this project</div>
					<div class="text-sm text-gray-500">Steps, variables, and releases will be deleted too.</div>
				</div>
				<button
					class="btn btn-error"
					hx-delete={ fmt.Sprintf("/projects/%d", project.ID) }
					hx-confirm="Delete this project? Steps, variables, and releases will also be deleted."
					data-toast-success="Project deleted"
					data-toast-error="Failed to delete project"
				>
					Delete project
				</button>
			</div>
			@ProjectMembersSection(project, members, availableUsers, canManage)
		}
		<div class="mt-8 pt-6 border-t border-base-300 flex gap-2 justify-end">
			<button type="submit" form={ projectFormID(project, isEdit) } class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
			if isEdit {
				<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost">Cancel</a>
			} else {
				<a href="/projects" class="btn btn-ghost">Cancel</a>
			}
		</div>
	</div>
}

templ ProjectFormPage(project db.Project, isEdit bool, errorMsg string, lifecycles []db.Lifecycle, policy ProjectExecutionPolicyView, labels []db.AgentLabel, members []db.ListProjectMembersRow, availableUsers []db.ListUsersRow, canManage bool, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			projectFormTitle(isEdit),
			projectFormAction(isEdit),
			"a project",
			projectFormBackHref(isEdit),
			currentPath,
		)
	} else {
		@layouts.Base("Project Form", currentPath) {
			@ProjectForm(project, isEdit, errorMsg, lifecycles, policy, labels, members, availableUsers, canManage)
		}
	}
}

templ ProjectExecutionPolicyFields(policy ProjectExecutionPolicyView, labels []db.AgentLabel) {
	<fieldset class="form-control" aria-describedby="execution-policy-help">
		<legend class="label"><span class="label-text">Execution default</span></legend>
		if policy.Legacy {
			<div class="alert alert-warning text-sm mb-3" role="status">
				<span><strong>Legacy execution behavior.</strong> This project uses environment assignments when present, otherwise local execution. Choose a default to save this project.</span>
			</div>
		}
		<p id="execution-policy-help" class="label-text-alt text-gray-500 mb-2">Choose where new deployments run unless they explicitly override this project default.</p>
		<label class="label cursor-pointer justify-start gap-3">
			<input type="radio" name="target_mode" value="local" class="radio radio-primary" required if policy.TargetMode == "local" { checked }/>
			<span class="label-text">Local execution</span>
		</label>
		<label class="label cursor-pointer justify-start gap-3">
			<input type="radio" name="target_mode" value="label" class="radio radio-primary" if policy.TargetMode == "label" { checked }/>
			<span class="label-text">Agent label</span>
		</label>
		<div class="grid gap-4 sm:grid-cols-2 mt-2">
			<div class="form-control">
				<label class="label" for="agent-label-id"><span class="label-text">Agent label</span></label>
				<select id="agent-label-id" name="agent_label_id" class="select select-bordered">
					<option value="">— Select a label —</option>
					for _, label := range labels {
						<option value={ strconv.FormatInt(label.ID, 10) } if policy.LabelID == label.ID { selected }>{ label.Name }</option>
					}
				</select>
			</div>
			<div class="form-control">
				<span class="label"><span class="label-text">Label strategy</span></span>
				<label class="label cursor-pointer justify-start gap-3 py-1">
					<input type="radio" name="agent_strategy" value="round_robin" class="radio radio-sm" if policy.Strategy == "round_robin" { checked }/>
					<span class="label-text">Round robin</span>
				</label>
				<label class="label cursor-pointer justify-start gap-3 py-1">
					<input type="radio" name="agent_strategy" value="all" class="radio radio-sm" if policy.Strategy == "all" { checked }/>
					<span class="label-text">All eligible agents</span>
				</label>
			</div>
		</div>
	</fieldset>
}

func projectFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit project"
	}
	return "New project"
}

func projectFormAction(isEdit bool) string {
	if isEdit {
		return "edit"
	}
	return "create"
}

func projectFormBackHref(isEdit bool) string {
	// Both new and edit land back on the project list; on the new
	// path there's no project detail to return to.
	return "/projects"
}
