package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"strconv"
)

type LifecycleRow struct {
	Lifecycle  db.Lifecycle
	StageCount int64
}

type LifecycleStageView struct {
	Stage       db.LifecycleStage
	Environment db.Environment
}

templ LifecyclesListPage(rows []LifecycleRow, currentPath string) {
	@layouts.Base("Lifecycles", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Lifecycles"},
		})
		@LifecyclesListContent(rows)
	}
}

templ LifecyclesListContent(rows []LifecycleRow) {
	<div class="space-y-4">
		<div class="flex flex-wrap justify-between items-center gap-2">
			<h1 class="text-3xl font-bold">Lifecycles</h1>
			if CanWrite(ctx) {
				<a href="/lifecycles/new" class="btn btn-primary">New Lifecycle</a>
			}
		</div>
		@LifecyclesListFragment(rows)
	</div>
}

templ LifecyclesListFragment(rows []LifecycleRow) {
	<div id="lifecycles-list">
		if len(rows) == 0 {
			<div class="card bg-base-200 p-8 text-center">
				<p class="text-gray-400 mb-4">No lifecycles yet. A lifecycle defines the order in which releases can be promoted across environments (e.g. dev → test → prod).</p>
				if CanWrite(ctx) {
					<a href="/lifecycles/new" class="btn btn-primary">New Lifecycle</a>
				}
			</div>
		} else {
			<table class="table table-zebra table-fixed w-full block md:table">
				<thead class="hidden md:table-header-group">
					<tr>
						<th class="w-1/5">Name</th>
						<th class="w-2/5">Description</th>
						<th class="w-1/5">Stages</th>
						<th class="w-48">Actions</th>
					</tr>
				</thead>
				<tbody class="block md:table-row-group">
					for _, row := range rows {
						@LifecycleListRow(row)
					}
				</tbody>
			</table>
		}
	</div>
}

templ LifecycleListRow(row LifecycleRow) {
	<tr class="grid grid-cols-2 gap-3 md:table-row max-md:rounded-box max-md:bg-base-200 max-md:p-4 max-md:mb-3">
		<td class="col-span-2 min-w-0 break-all md:truncate font-medium">
			<span class="block md:hidden text-xs opacity-70 mb-1">Name</span>
			{ row.Lifecycle.Name }
		</td>
		<td class="col-span-2 min-w-0 break-all md:truncate">
			<span class="block md:hidden text-xs opacity-70 mb-1">Description</span>
			if row.Lifecycle.Description.Valid {
				{ row.Lifecycle.Description.String }
			} else {
				<span class="text-gray-500">-</span>
			}
		</td>
		<td class="col-span-2 md:whitespace-nowrap">
			<span class="block md:hidden text-xs opacity-70 mb-1">Stages</span>
			{ strconv.FormatInt(row.StageCount, 10) }
		</td>
		<td class="col-span-2">
			if CanWrite(ctx) {
				<div class="flex flex-wrap gap-2">
				<a href={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(row.Lifecycle.ID, 10)) } class="btn md:btn-sm btn-ghost">Edit</a>
				<form method="post" action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(row.Lifecycle.ID, 10)) }>
					<input type="hidden" name="_method" value="delete"/>
					<button type="submit" class="btn md:btn-sm btn-error" hx-confirm="Delete this lifecycle? Projects using it will be unset.">Delete</button>
				</form>
				</div>
			}
		</td>
	</tr>
}

	templ LifecycleForm(lc db.Lifecycle, isEdit bool, errorMsg string) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<h1 class="text-3xl font-bold">
				if isEdit {
					Edit Lifecycle
				} else {
					New Lifecycle
				}
			</h1>
			<div class="flex gap-2">
				<a href="/lifecycles" class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
		</div>
		<div class="card bg-base-200 p-4 mt-4">
		<form
			if isEdit {
				method="post"
				action={ templ.SafeURL("/lifecycles/" + strconv.FormatInt(lc.ID, 10)) }
			} else {
				method="post"
				action="/lifecycles"
			}
			class="space-y-4"
		>
			if isEdit {
				<input type="hidden" name="_method" value="put"/>
			}
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" class="input input-bordered" value={ lc.Name } required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Description</span>
				</label>
				<textarea name="description" class="textarea textarea-bordered" rows="3">{ lc.Description.String }</textarea>
			</div>
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary">
					if isEdit {
						Update
					} else {
						Create
					}
				</button>
 			<a href="/lifecycles" class="btn btn-ghost">Cancel</a>
			</div>
		</form>
		</div>
	</div>
}

templ LifecycleFormPage(lc db.Lifecycle, isEdit bool, errorMsg string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			lcFormTitle(isEdit),
			lcFormAction(isEdit),
			"a lifecycle",
			"/lifecycles",
			currentPath,
		)
	} else {
		@layouts.Base("Lifecycle", currentPath) {
			{{ lastCrumb := "New Lifecycle" }}
			if isEdit {
				{{ lastCrumb = "Edit Lifecycle" }}
			}
			@components.Breadcrumbs([]components.Crumb{
				{Label: "Home", Href: "/"},
				{Label: "Lifecycles", Href: "/lifecycles"},
				{Label: lastCrumb},
			})
			@LifecycleForm(lc, isEdit, errorMsg)
		}
	}
}

func lcFormTitle(isEdit bool) string {
	if isEdit {
		return "Edit lifecycle"
	}
	return "New lifecycle"
}

func lcFormAction(isEdit bool) string {
	if isEdit {
		return "edit"
	}
	return "create"
}
