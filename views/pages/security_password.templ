package pages

import "durpdeploy/internal/auth"

templ SecurityPasswordForm(hasPassword bool, message string) {
	<div id="change-password" class="border-b border-base-300">
		if !hasPassword {
			<div class="space-y-2 p-5">
				<h3 class="font-semibold">Password</h3>
				<p>Your account has no local password. Manage your password with your SSO identity provider.</p>
			</div>
		} else {
			<details class="group" open?={ message != "" }>
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5">
					<span>
						<span class="block font-semibold">Password</span>
						<span class="mt-1 block text-sm opacity-70">Change your current password.</span>
					</span>
					<span class="flex shrink-0 items-center gap-2 text-sm text-primary">
						Change
						<svg class="h-4 w-4 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
					</span>
				</summary>
				<form method="post" action="/settings/security/password" hx-boost="false" class="max-w-lg space-y-4 p-5 pt-0">
					<p class="text-sm opacity-70">Use at least 8 characters. Changing your password signs out all browser sessions. API tokens remain valid.</p>
					if session := auth.SessionFromContext(ctx); session != nil {
						<input type="hidden" name="csrf_token" value={ session.CsrfToken }/>
					}
					if message != "" {
						<div id="password-error" class="alert alert-error" role="alert" tabindex="-1" autofocus>{ message }</div>
					}
					<div class="form-control">
						<label class="label" for="current-password">Current password</label>
						<input id="current-password" name="current_password" type="password" autocomplete="current-password" class="input input-bordered w-full" required/>
					</div>
					<div class="form-control">
						<label class="label" for="new-password">New password</label>
						<input id="new-password" name="new_password" type="password" autocomplete="new-password" minlength="8" class="input input-bordered w-full" required/>
					</div>
					<div class="form-control">
						<label class="label" for="confirm-password">Confirm new password</label>
						<input id="confirm-password" name="password_confirmation" type="password" autocomplete="new-password" minlength="8" class="input input-bordered w-full" required/>
					</div>
					<div class="flex flex-wrap gap-2">
						<button type="submit" class="btn btn-primary">Change password</button>
						<a href="/settings/security" hx-boost="false" class="btn btn-ghost">Cancel</a>
					</div>
				</form>
			</details>
		}
	</div>
}
