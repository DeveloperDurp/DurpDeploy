package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
)

// StepsPage is the dedicated full page for a project's step list. The
// underlying StepList component is unchanged; this just wraps it in a
// layout with breadcrumbs and the "Add Step" / "Insert from Template"
// buttons that used to live on the project overview.
templ StepsPage(project db.Project, steps []db.Step, currentPath string) {
	@layouts.Base("Steps - "+project.Name, currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
			{Label: "Steps"},
		})
		@StepsContent(project, steps)
	}
}

templ StepsContent(project db.Project, steps []db.Step) {
	<div
		class="space-y-6"
		x-data="stepFormHost"
		x-on:step-form-add="handleEvent"
		x-on:step-form-cancel="handleEvent"
		x-on:step-form-edit="handleEvent"
		x-on:htmx:after-settle.camel="afterSettle"
		x-on:htmx:after-swap.camel="afterSwap"
		x-on:htmx:before-swap.camel="beforeSwap"
	>
		<div class="page-header">
			<h1 class="min-w-0 w-full break-words sm:w-auto sm:flex-1 text-3xl font-bold">Steps for { project.Name }</h1>
			<div class="flex gap-2">
				<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
		</div>
		<div class="card bg-base-200 p-4">
			<div class="flex justify-between items-center mb-2">
				<h2 class="text-lg font-bold">Deployment Process</h2>
				<span class="text-xs text-gray-500">
					if len(steps) == 0 {
						no steps yet
					} else {
						{ fmt.Sprintf("%d step(s)", len(steps)) }
					}
				</span>
			</div>
			@components.StepList(steps, project.ID)
			if CanWrite(ctx) {
				<div class="mt-4 flex gap-2">
					<button
						x-ref="addStepButton"
						x-on:click="$dispatch('step-form-edit')"
						class="btn btn-primary btn-sm"
						hx-get={ fmt.Sprintf("/projects/%d/steps/new", project.ID) }
						hx-target="#step-edit-content"
						hx-swap="innerHTML"
					>
						Add Step
					</button>
					<button
						class="btn btn-secondary btn-sm"
						hx-get={ fmt.Sprintf("/projects/%d/templates-picker", project.ID) }
						hx-target="#template-picker"
						hx-swap="innerHTML"
					>
						Insert from Template
					</button>
				</div>
			}
			<div id="template-picker" class="mt-4"></div>
		</div>
		if CanWrite(ctx) {
			<dialog id="step-edit-dialog" x-ref="stepEditDialog" class="modal" aria-labelledby="step-edit-title" x-on:close="editClosed">
				<div class="modal-box w-full max-w-5xl">
					<div id="step-edit-content" x-ref="stepEditContent"></div>
				</div>
				<form method="dialog" class="modal-backdrop"><button type="submit" aria-label="Cancel step form"></button></form>
			</dialog>
		}
	</div>
}
