package layouts

import (
	"strings"

	"durpdeploy/internal/auth"
)

func isActive(currentPath, prefix string) bool {
	return currentPath == prefix || strings.HasPrefix(currentPath, prefix+"/")
}

func activeClass(currentPath, prefix string) string {
	if isActive(currentPath, prefix) {
		return "active"
	}
	return ""
}

templ Base(title string, currentPath string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" sizes="64x64" href="/static/icons/favicon-64.png"/>
			<link rel="stylesheet" href="/static/css/tailwind.min.css"/>
			<style>[data-theme="mocha"] .theme-light{display:none}[data-theme="light"] .theme-dark{display:none}</style>
			<script>document.documentElement.setAttribute('data-theme',localStorage.getItem('theme')||'mocha')</script>
			if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
				<meta name="csrf-token" content={ sess.CsrfToken }/>
			}
			<script>
				// htmx:configRequest bubbles up to document, so listen there
				// (the script runs in <head> where document.body is null).
				document.addEventListener('htmx:configRequest', function(evt) {
					var meta = document.querySelector('meta[name="csrf-token"]');
					if (meta) { evt.detail.headers['X-CSRF-Token'] = meta.content; }
				});
				// Inject a hidden csrf_token input into any form that
				// doesn't already have one. Capture phase so the input is
				// appended before HTMX or the browser reads the form.
				document.addEventListener('submit', function(evt) {
					var form = evt.target;
					if (!form || form.tagName !== 'FORM') return;
					if (form.querySelector('input[name="csrf_token"]')) return;
					var meta = document.querySelector('meta[name="csrf-token"]');
					if (!meta) return;
					var input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'csrf_token';
					input.value = meta.content;
					form.appendChild(input);
				}, true);
			</script>
			<script src="/static/js/app.bundle.js" defer></script>
		</head>
		<body class="bg-base-100 text-base-content min-h-screen">
			<div class="navbar bg-base-200 border-b border-base-300" x-data="navbar" @keydown.escape.window="closeFocusedMenu($event)" @click.window="closeOutsideMenu($event)">
				<div class="w-full px-4 sm:px-6 lg:px-8 flex flex-nowrap items-center gap-2">
					<div class="min-w-0 shrink-0">
						<a href="/" class="btn btn-ghost text-xl whitespace-nowrap">DurpDeploy</a>
					</div>
					<div class="flex min-w-0 flex-1 items-center gap-2">
						<details data-mobile-nav="true" data-focus-menu class="dropdown dropdown-end ml-auto shrink-0 md:hidden">
							<summary class="btn btn-ghost btn-sm" aria-label="Open navigation">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
								</svg>
							</summary>
							<ul class="dropdown-content menu bg-base-200 rounded-box z-[1] w-52 p-2 shadow">
								<li><a href="/projects" class={ activeClass(currentPath, "/projects") }>Projects</a></li>
								<li><a href="/environments" class={ activeClass(currentPath, "/environments") }>Environments</a></li>
								<li><a href="/lifecycles" class={ activeClass(currentPath, "/lifecycles") }>Lifecycles</a></li>
								<li><a href="/deployments" class={ activeClass(currentPath, "/deployments") }>Deployments</a></li>
								<li><a href="/templates" class={ activeClass(currentPath, "/templates") }>Templates</a></li>
								if user := auth.UserFromContext(ctx); user != nil && user.Role == "admin" {
									<li>
										<details data-focus-menu>
											<summary>Admin</summary>
											<ul>
												<li><a href="/admin/audit">Audit log</a></li>
												<li><a href="/admin/notifications">Notifications</a></li>
												<li><a href="/admin/tokens">API tokens</a></li>
												<li><a href="/admin/users">Users</a></li>
											</ul>
										</details>
									</li>
								}
								<li>
									<button class="btn btn-ghost btn-sm w-full justify-start" @click="theme = theme === 'mocha' ? 'light' : 'mocha'">
										<span class="theme-dark">☀️</span>
										<span class="theme-light">🌙</span>
									</button>
								</li>
								if user := auth.UserFromContext(ctx); user != nil {
									<li>
									<details data-account-menu data-focus-menu class="dropdown dropdown-end w-full min-w-0">
										<summary class={ "btn btn-ghost btn-sm w-full min-w-0 justify-start truncate " + activeClass(currentPath, "/settings") } title={ user.Name + " (" + user.Role + ")" } aria-label={ user.Name + " (" + user.Role + ")" }>{ user.Name } ({ user.Role })</summary>
											<ul class="menu bg-base-200 rounded-box p-2">
												<li><a href="/settings/security" class={ activeClass(currentPath, "/settings/security") }>Security</a></li>
												if user.Role != "viewer" {
													<li><a href="/settings/tokens" class={ activeClass(currentPath, "/settings/tokens") }>Tokens</a></li>
												}
												<li class="menu-title"><hr/></li>
												<li>
													<form method="post" action="/logout">
														if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
															<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
														}
														<button type="submit" class="btn btn-ghost btn-sm w-full justify-start">Logout</button>
													</form>
												</li>
											</ul>
										</details>
									</li>
								} else {
									<li><a href="/login">Sign in</a></li>
								}
							</ul>
						</details>
						<div class="hidden min-w-0 flex-1 overflow-x-auto md:flex">
							<ul class="menu menu-horizontal flex-nowrap whitespace-nowrap px-1">
								<li><a href="/projects" class={ activeClass(currentPath, "/projects") }>Projects</a></li>
								<li><a href="/environments" class={ activeClass(currentPath, "/environments") }>Environments</a></li>
								<li><a href="/lifecycles" class={ activeClass(currentPath, "/lifecycles") }>Lifecycles</a></li>
								<li><a href="/deployments" class={ activeClass(currentPath, "/deployments") }>Deployments</a></li>
								<li><a href="/templates" class={ activeClass(currentPath, "/templates") }>Templates</a></li>
							</ul>
						</div>
						if user := auth.UserFromContext(ctx); user != nil && user.Role == "admin" {
							<details data-focus-menu class="dropdown dropdown-end hidden shrink-0 md:block">
								<summary class="btn btn-ghost btn-sm">Admin</summary>
								<ul class="dropdown-content menu bg-base-200 rounded-box z-[1] w-44 p-2 shadow">
									<li><a href="/admin/audit">Audit log</a></li>
									<li><a href="/admin/notifications">Notifications</a></li>
									<li><a href="/admin/tokens">API tokens</a></li>
									<li><a href="/admin/users">Users</a></li>
								</ul>
							</details>
						}
						<div class="hidden shrink-0 items-center gap-2 md:flex">
							<button class="btn btn-ghost btn-sm" @click="theme = theme === 'mocha' ? 'light' : 'mocha'">
								<span class="theme-dark">☀️</span>
								<span class="theme-light">🌙</span>
							</button>
							if user := auth.UserFromContext(ctx); user != nil {
								<details data-account-menu data-focus-menu class="dropdown dropdown-end shrink-0">
									<summary class={ "btn btn-ghost btn-sm w-40 min-w-0 truncate whitespace-nowrap " + activeClass(currentPath, "/settings") } title={ user.Name + " (" + user.Role + ")" } aria-label={ user.Name + " (" + user.Role + ")" }>{ user.Name } ({ user.Role })</summary>
									<ul class="dropdown-content menu bg-base-200 rounded-box z-[1] w-52 p-2 shadow">
										<li><a href="/settings/security" class={ activeClass(currentPath, "/settings/security") }>Security</a></li>
										if user.Role != "viewer" {
											<li><a href="/settings/tokens" class={ activeClass(currentPath, "/settings/tokens") }>Tokens</a></li>
										}
										<li class="menu-title"><hr/></li>
										<li>
											<form method="post" action="/logout">
												if sess := auth.SessionFromContext(ctx); sess != nil && sess.CsrfToken != "" {
													<input type="hidden" name="csrf_token" value={ sess.CsrfToken }/>
												}
												<button type="submit" class="btn btn-ghost btn-sm w-full justify-start">Logout</button>
											</form>
										</li>
									</ul>
								</details>
							} else {
								<a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
							}
						</div>
					</div>
				</div>
			</div>
			<div class="w-full px-4 sm:px-6 lg:px-8 py-4">
				<div id="form-container">
					{ children... }
				</div>
			</div>
			<div
				x-data="toast"
				x-show="visible"
				x-transition.opacity.duration.300ms
				class="toast toast-end toast-top z-[9999]"
			>
<div :class="fullAlertClass">
				<span x-text="message"></span>
			</div>
			</div>
		</body>
	</html>
}
