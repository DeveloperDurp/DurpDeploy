package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/components"
	"durpdeploy/views/layouts"
	"fmt"
	"strconv"
)

func filterUnscoped(vars []db.Variable) []db.Variable {
	result := make([]db.Variable, 0)
	for _, v := range vars {
		if !v.EnvironmentID.Valid {
			result = append(result, v)
		}
	}
	return result
}

func filterScoped(vars []db.Variable) []db.Variable {
	result := make([]db.Variable, 0)
	for _, v := range vars {
		if v.EnvironmentID.Valid {
			result = append(result, v)
		}
	}
	return result
}

func envNameForID(environments []db.Environment, id int64) string {
	for _, env := range environments {
		if env.ID == id {
			return env.Name
		}
	}
	return ""
}

func variableEditValue(variable db.Variable) string {
	if variable.Secret != 0 {
		return ""
	}
	return variable.Value.String
}

templ VariablesPage(project db.Project, variables []db.Variable, environments []db.Environment, errorMsg string, currentPath string) {
	@layouts.Base("Variables", currentPath) {
		@components.Breadcrumbs([]components.Crumb{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/projects"},
			{Label: project.Name, Href: fmt.Sprintf("/projects/%d", project.ID)},
			{Label: "Variables"},
		})
		@VariablesContent(project, variables, environments, errorMsg)
		@VariablesPageScript()
	}
}

templ VariablesContent(project db.Project, variables []db.Variable, environments []db.Environment, errorMsg string) {
	<div class="space-y-6">
		<div class="flex justify-between items-center">
			<h1 class="text-3xl font-bold">Variables — { project.Name }</h1>
			<div class="flex gap-2">
				<a href={ fmt.Sprintf("/projects/%d", project.ID) } class="btn btn-ghost btn-sm">Back</a>
			</div>
		</div>
		@VariablesFragment(project, variables, environments, errorMsg)
	</div>
}

templ VariablesFragment(project db.Project, variables []db.Variable, environments []db.Environment, errorMsg string) {
	<div id="variables-content">
		if CanWrite(ctx) {
			@VariableForm(project.ID, environments, errorMsg)
		}
		@VariablesTable(project, variables, environments)
	</div>
}

templ VariableForm(projectID int64, environments []db.Environment, errorMsg string) {
	<div class="card bg-base-200 p-4 mb-6">
		<h3 class="text-lg font-bold mb-4">New Variable</h3>
		<form
			hx-post={ fmt.Sprintf("/projects/%d/variables", projectID) }
			hx-target="#variables-content"
			hx-swap="outerHTML"
			data-toast-success="Variable created"
			data-toast-error="Failed to create variable"
			class="flex flex-wrap gap-4 items-end"
		>
			<div class="form-control flex-1 min-w-0 basis-48">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" class="input input-bordered" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
		<div class="flex flex-wrap gap-4 items-end w-full min-w-0" x-data="{ secret: false }">
 			<div class="form-control flex-1 min-w-[200px]">
 				<label class="label">
 					<span class="label-text">Value</span>
 				</label>
				<input :type="secret ? 'password' : 'text'" name="value" :placeholder="secret ? '••••••••' : ''" class="input input-bordered w-full min-w-0"/>
 			</div>
			<div class="form-control flex-1 min-w-0 basis-48">
 				<label class="label">
 					<span class="label-text">Environment</span>
 				</label>
				<select name="environment_id" class="select select-bordered w-full min-w-0">
 					<option value="">Unscoped</option>
 					for _, env := range environments {
 						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
 					}
 				</select>
 			</div>
  		<div class="form-control justify-end pb-1">
 			<label class="cursor-pointer flex items-center gap-1">
 				<input type="checkbox" name="secret" class="checkbox checkbox-sm" x-model="secret"/>
 				<span class="text-sm">Secret</span>
 				</label>
 			</div>
 			<button type="submit" class="btn btn-primary">Add Variable</button>
 		</div>
		</form>
	</div>
}

templ VariablesTable(project db.Project, variables []db.Variable, environments []db.Environment) {
	<table class="hidden md:table table-zebra table-fixed w-full">
		<thead>
			<tr>
				<th class="w-1/5">Name</th>
				<th class="w-1/4">Value</th>
				<th class="w-1/6">Environment</th>
				<th class="hidden md:table-cell w-1/6">Secret</th>
				<th class="w-1/5">Actions</th>
			</tr>
		</thead>
		<tbody>
			<tr class="bg-base-300">
				<td colspan="5" class="font-bold">Global Defaults</td>
			</tr>
			if len(filterUnscoped(variables)) == 0 {
				<tr>
					<td colspan="5" class="text-gray-500 italic text-center py-4">No unscoped variables.</td>
				</tr>
			} else {
				for _, v := range filterUnscoped(variables) {
					@VariableRow(project.ID, v, environments)
				}
			}
			<tr class="bg-base-300">
				<td colspan="5" class="font-bold">Per-Environment Overrides</td>
			</tr>
			if len(filterScoped(variables)) == 0 {
				<tr>
					<td colspan="5" class="text-gray-500 italic text-center py-4">No environment-scoped variables.</td>
				</tr>
			} else {
				for _, v := range filterScoped(variables) {
					@VariableRow(project.ID, v, environments)
				}
			}
		</tbody>
	</table>
	<div class="space-y-6 md:hidden" data-mobile-variable-list>
		<section class="space-y-3" aria-labelledby="mobile-global-variables">
			<h2 id="mobile-global-variables" class="font-bold">Global Defaults</h2>
			if len(filterUnscoped(variables)) == 0 {
				<p class="text-gray-500 italic text-center py-4">No unscoped variables.</p>
			} else {
				<ul class="space-y-3" aria-label="Global variables">
					for _, variable := range filterUnscoped(variables) {
						@VariableMobileRecord(project.ID, variable, environments)
					}
				</ul>
			}
		</section>
		<section class="space-y-3" aria-labelledby="mobile-scoped-variables">
			<h2 id="mobile-scoped-variables" class="font-bold">Per-Environment Overrides</h2>
			if len(filterScoped(variables)) == 0 {
				<p class="text-gray-500 italic text-center py-4">No environment-scoped variables.</p>
			} else {
				<ul class="space-y-3" aria-label="Environment-scoped variables">
					for _, variable := range filterScoped(variables) {
						@VariableMobileRecord(project.ID, variable, environments)
					}
				</ul>
			}
		</section>
	</div>
}

templ VariableRow(projectID int64, variable db.Variable, environments []db.Environment) {
	<tr id={ fmt.Sprintf("variable-row-%d", variable.ID) } x-data={ fmt.Sprintf("{ editing: false, secret: %v }", variable.Secret != 0) }>
		<td class="font-medium truncate">{ variable.Name }</td>
 	<td class="truncate">
			if variable.Secret != 0 {
				<span class="text-gray-500 italic">••••••••</span>
			} else if variable.Value.Valid {
				{ variable.Value.String }
			} else {
				<span class="text-gray-500 italic">(empty)</span>
			}
		</td>
<td class="truncate">
		if variable.EnvironmentID.Valid {
			{ envNameForID(environments, variable.EnvironmentID.Int64) }
		} else {
			<span class="badge badge-ghost badge-sm">Global</span>
		}
	</td>
		<td class="hidden md:table-cell truncate">
			if variable.Secret != 0 {
				<span class="badge badge-warning badge-sm">secret</span>
			}
		</td>
		<td class="flex flex-wrap gap-2 min-w-0">
			if CanWrite(ctx) {
				if !variable.EnvironmentID.Valid {
					<button
						type="button"
						class="btn btn-sm btn-ghost"
						data-variable-action="override"
						data-override-for={ variable.Name }
					>
						Override
					</button>
				}
				<button
					class="btn btn-sm btn-ghost"
					data-variable-action="edit"
					x-on:click.capture="editing = true; $event.stopImmediatePropagation()"
					hx-get={ fmt.Sprintf("/projects/%d/variables/%d/edit", projectID, variable.ID) }
					hx-target={ fmt.Sprintf("#variable-row-%d", variable.ID) }
					hx-swap="outerHTML"
				>
					Edit
				</button>
				<button
					class="btn btn-sm btn-error"
					data-variable-action="delete"
					hx-delete={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
					hx-target="#variables-content"
					hx-swap="outerHTML"
					hx-confirm="Delete this variable?"
					data-toast-success="Variable deleted"
					data-toast-error="Failed to delete variable"
				>
					Delete
				</button>
			}
			if CanWrite(ctx) {
				<div x-show="editing" data-desktop-variable-edit={ strconv.FormatInt(variable.ID, 10) } class="basis-full mt-2">
					@VariableQuickEditForm(projectID, variable, environments)
				</div>
			}
		</td>
	</tr>
}

templ VariableQuickEditForm(projectID int64, variable db.Variable, environments []db.Environment) {
	<form
		hx-put={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
		hx-target="#variables-content"
		hx-swap="outerHTML"
		data-toast-success="Variable updated"
		data-toast-error="Failed to update variable"
		class="space-y-3"
	>
		<div class="form-control">
			<label class="label"><span class="label-text">Name</span></label>
			<input type="text" name="name" value={ variable.Name } class="input input-bordered input-sm w-full" required/>
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">Value</span></label>
			<input :type="secret ? 'password' : 'text'" name="value" value={ variableEditValue(variable) } :placeholder="secret ? 'Leave blank to keep existing secret' : ''" class="input input-bordered input-sm w-full"/>
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">Environment</span></label>
			<select name="environment_id" class="select select-bordered select-sm w-full">
				<option value="">Unscoped</option>
				for _, env := range environments {
					if variable.EnvironmentID.Valid && env.ID == variable.EnvironmentID.Int64 {
						<option value={ strconv.FormatInt(env.ID, 10) } selected>{ env.Name }</option>
					} else {
						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
					}
				}
			</select>
		</div>
		<label class="cursor-pointer flex items-center gap-2">
			<input type="checkbox" name="secret" class="checkbox checkbox-sm" x-model="secret"/>
			<span class="text-sm">Secret</span>
		</label>
		<div class="flex flex-wrap gap-2">
			<button type="button" class="btn btn-ghost btn-sm" x-on:click="editing = false">Cancel</button>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</div>
	</form>
}

templ VariableMobileRecord(projectID int64, variable db.Variable, environments []db.Environment) {
	<li class="card bg-base-200 p-4 space-y-3" data-mobile-variable={ strconv.FormatInt(variable.ID, 10) } x-data={ fmt.Sprintf("{ editing: false, secret: %v }", variable.Secret != 0) }>
		<div class="min-w-0">
			<p class="text-sm text-gray-400">Variable</p>
			<h3 class="font-medium break-words">{ variable.Name }</h3>
		</div>
		<dl class="space-y-2 text-sm">
			<div>
				<dt class="text-gray-400">Value</dt>
				<dd class="font-mono break-all">
					if variable.Secret != 0 {
						<span class="text-gray-500 italic">••••••••</span>
					} else if variable.Value.Valid {
						{ variable.Value.String }
					} else {
						<span class="text-gray-500 italic">(empty)</span>
					}
				</dd>
			</div>
			<div>
				<dt class="text-gray-400">Environment</dt>
				<dd class="break-words">
					if variable.EnvironmentID.Valid {
						{ envNameForID(environments, variable.EnvironmentID.Int64) }
					} else {
						<span class="badge badge-ghost badge-sm">Global</span>
					}
				</dd>
			</div>
			if variable.Secret != 0 {
				<div>
					<dt class="text-gray-400">Secret</dt>
					<dd><span class="badge badge-warning badge-sm">secret</span></dd>
				</div>
			}
		</dl>
		if CanWrite(ctx) {
			<div class="flex flex-wrap gap-2">
				if !variable.EnvironmentID.Valid {
					<button
						type="button"
						class="btn btn-sm btn-ghost"
						data-variable-action="override"
						data-override-for={ variable.Name }
					>
						Override
					</button>
				}
				<button
					type="button"
					class="btn btn-sm btn-ghost"
					data-variable-action="edit"
					x-on:click.capture="editing = true; $event.stopImmediatePropagation()"
					hx-get={ fmt.Sprintf("/projects/%d/variables/%d/edit", projectID, variable.ID) }
					hx-target={ fmt.Sprintf("#variable-row-%d", variable.ID) }
					hx-swap="outerHTML"
				>
					Edit
				</button>
				<button
					class="btn btn-sm btn-error"
					data-variable-action="delete"
					hx-delete={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
					hx-target="#variables-content"
					hx-swap="outerHTML"
					hx-confirm="Delete this variable?"
					data-toast-success="Variable deleted"
					data-toast-error="Failed to delete variable"
				>
					Delete
				</button>
			</div>
			<div x-show="editing" data-mobile-variable-edit={ strconv.FormatInt(variable.ID, 10) } class="card bg-base-100 p-3">
				@VariableQuickEditForm(projectID, variable, environments)
			</div>
		}
	</li>
}

templ VariableEditRow(projectID int64, variable db.Variable, environments []db.Environment, errorMsg string) {
	<tr id={ fmt.Sprintf("variable-row-%d", variable.ID) } x-data={ fmt.Sprintf("{ secret: %v }", variable.Secret != 0) }>
		<td class="font-medium">
			<form
				id={ fmt.Sprintf("variable-edit-form-%d", variable.ID) }
				hx-put={ fmt.Sprintf("/projects/%d/variables/%d", projectID, variable.ID) }
				hx-target="#variables-content"
				hx-swap="outerHTML"
				data-toast-success="Variable updated"
				data-toast-error="Failed to update variable"
			></form>
			<input type="text" name="name" value={ variable.Name } form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="input input-bordered input-sm w-full" required/>
			if errorMsg != "" {
				<span class="text-error text-sm mt-1">{ errorMsg }</span>
			}
		</td>
		<td>
			<input :type="secret ? 'password' : 'text'" name="value" value={ variableEditValue(variable) } :placeholder="secret ? 'Leave blank to keep existing secret' : ''" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="input input-bordered input-sm w-full"/>
		</td>
		<td>
			<select name="environment_id" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="select select-bordered select-sm w-full">
				<option value="">Unscoped</option>
				for _, env := range environments {
					if variable.EnvironmentID.Valid && env.ID == variable.EnvironmentID.Int64 {
						<option value={ strconv.FormatInt(env.ID, 10) } selected>{ env.Name }</option>
					} else {
						<option value={ strconv.FormatInt(env.ID, 10) }>{ env.Name }</option>
					}
				}
			</select>
		</td>
		<td>
			<label class="cursor-pointer flex items-center gap-1">
				<input type="checkbox" name="secret" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="checkbox checkbox-sm" x-model="secret"/>
				<span class="text-sm">Secret</span>
			</label>
		</td>
		<td class="flex flex-wrap gap-2 min-w-0">
			<button type="button" class="btn btn-ghost btn-sm whitespace-nowrap" hx-get={ fmt.Sprintf("/projects/%d/variables", projectID) } hx-target="#variables-content" hx-swap="outerHTML">Cancel</button>
			<button type="submit" form={ fmt.Sprintf("variable-edit-form-%d", variable.ID) } class="btn btn-primary btn-sm whitespace-nowrap">Save</button>
		</td>
	</tr>
}

templ VariablesPageScript() {
	<script>
		document.addEventListener('click', function(e) {
			var btn = e.target.closest('[data-override-for]');
			if (!btn) return;
			var name = btn.getAttribute('data-override-for');
			var form = document.querySelector('#variables-content form');
			if (!form) return;
			var nameInput = form.querySelector('input[name="name"]');
			var envSelect = form.querySelector('select[name="environment_id"]');
			if (nameInput) {
				nameInput.value = name;
				nameInput.focus();
			}
			if (envSelect) {
				envSelect.focus();
			}
			form.scrollIntoView({behavior: 'smooth', block: 'start'});
		});
	</script>
}
