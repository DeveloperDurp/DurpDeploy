# syntax=harbor.durp.info/dockerhub/docker/dockerfile:1
# Go 1.26.10 is copied into Playwright's pinned runtime image so its bundled
# Chromium and Linux dependencies match package-lock.json's Playwright 1.61.1.
FROM harbor.durp.info/dockerhub/library/golang@sha256:ee3901c61e423732605a51f1b8157c849ec01194ea0a274213b5202b2c11e7bf AS go

# Node.js 24.22.1 uses the official glibc distribution.
FROM harbor.durp.info/dockerhub/library/node@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node

FROM harbor.durp.info/microsoft/playwright:v1.61.1-noble

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

ARG CI_RUNTIME_CACHE_EPOCH=0
# hadolint ignore=DL3008
RUN apt-get purge -y nodejs && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        make \
        sqlite3 && \
    rm -rf /var/lib/apt/lists/*

# Remove the older Node package before copying the patched distribution.
# Keep its Node and npm dependency license notices with the tools.
COPY --from=node /usr/local/ /usr/local/
RUN node --version && npm --version

COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/go/bin:/usr/local/go/bin:${PATH}

COPY go.mod go.sum /opt/go-tools/
RUN go -C /opt/go-tools build -mod=readonly -o /usr/local/bin/templ github.com/a-h/templ/cmd/templ

WORKDIR /opt/mobile-browser
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY scripts/mobile-browser-container.sh /usr/local/bin/mobile-browser-container
COPY scripts/agent_smoke_container.sh /usr/local/bin/agent-smoke-container
RUN chmod 0755 /usr/local/bin/mobile-browser-container \
    /usr/local/bin/agent-smoke-container

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/mobile-browser-container"]
