package pages

import (
	"durpdeploy/internal/auth"
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"durpdeploy/views/components"
	"strconv"
)

templ EnvironmentForm(env *db.Environment, isNew bool, errorMsg string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			envFormTitle(isNew),
			envFormAction(isNew),
			"an environment",
			"/environments",
			currentPath,
		)
	} else {
		@layouts.Base("Environment", currentPath) {
			@EnvironmentFormContent(env, isNew, errorMsg)
		}
	}
}

func envFormTitle(isNew bool) string {
	if isNew {
		return "New environment"
	}
	return "Edit environment"
}

func envFormAction(isNew bool) string {
	if isNew {
		return "create"
	}
	return "edit"
}

templ EnvironmentFormFragment(env *db.Environment, isNew bool, errorMsg string) {
	@EnvironmentFormContent(env, isNew, errorMsg)
}

templ EnvironmentFormContent(env *db.Environment, isNew bool, errorMsg string) {
	@components.Breadcrumbs([]components.Crumb{
		{Label: "Home", Href: "/"},
		{Label: "Environments", Href: "/environments"},
		{Label: envFormTitle(isNew)},
	})
	<div class="w-full" data-create-form>
		<div class="page-header">
			<h1 class="text-3xl font-bold">
				if isNew {
					New Environment
				} else {
					Edit Environment
				}
			</h1>
			<div class="flex gap-2 shrink-0">
				if CanWrite(ctx) {
					<button type="submit" form="environment-settings-form" class="btn btn-primary md:btn-sm">Save</button>
				}
				<a href="/environments" class="btn btn-ghost md:btn-sm" x-data="backNavigation" @click="back">Back</a>
			</div>
		</div>
		<form
			id="environment-settings-form"
			if isNew {
				method="post"
				action="/environments"
				hx-post="/environments"
			} else {
				hx-put={ "/environments/" + strconv.FormatInt(env.ID, 10) }
				hx-target="closest [data-create-form]"
				hx-select="[data-create-form]"
				hx-swap="outerHTML"
				data-toast-success="Environment updated"
				data-toast-error="Failed to update environment"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" value={ env.Name } class="input input-bordered" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Description</span>
				</label>
				<textarea name="description" class="textarea textarea-bordered">{ env.Description.String }</textarea>
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Tags</span>
				</label>
				<input type="text" name="tags" value={ env.Tags.String } class="input input-bordered" placeholder="comma, separated, tags"/>
			</div>
			<div class="flex gap-2">
				if auth.RoleFromContext(ctx) == "admin" {
					@EnvironmentVerificationFields(env)
				} else {
					<p class="text-sm opacity-70">Only admins can configure post-deployment verification.</p>
				}
			</div>
		</form>
		if !isNew && CanWrite(ctx) {
			<div class="mt-6 pt-4 border-t border-base-300 flex flex-wrap items-center justify-between gap-4">
				<div class="font-medium">Delete this environment</div>
				<button
					type="button"
					hx-delete={ "/environments/" + strconv.FormatInt(env.ID, 10) }
					hx-target="#form-container"
					hx-swap="innerHTML"
					hx-replace-url="/environments"
					hx-confirm="Delete this environment?"
					class="btn btn-error"
					data-toast-success="Environment deleted"
					data-toast-error="Failed to delete environment"
				>
					Delete environment
				</button>
			</div>
		}
	</div>
}
