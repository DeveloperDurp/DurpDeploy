package pages

import "durpdeploy/internal/repository"
import "strconv"

templ LogFollowControl() {
	if logHistoryPage(ctx).Before == 0 {
		<button type="button" class="btn btn-ghost sm:btn-sm" x-cloak data-follow-logs @click="resumeLogFollow" x-bind:aria-pressed="followingLogs">
			Follow logs
			<span class="badge badge-outline" x-text="followingLogs ? 'On' : 'Paused'"></span>
		</button>
	}
}

templ LogHistoryNavigation(base, exportURL string) {
	{{ page := logHistoryPage(ctx) }}
	<div class="flex flex-wrap items-center gap-2" aria-label="Log history">
		<p class="text-sm opacity-70 grow">
			if page.Before != 0 {
				Older log page. Live updates are paused.
			} else {
				Showing up to { strconv.FormatInt(repository.LogPageLimit, 10) } recent entries and 1 MiB of previews.
			}
			Lines over 16 KiB are shortened. Export all logs includes complete output.
		</p>
		if page.NextBefore != 0 || page.Before == 0 {
			<a
				class="btn btn-ghost sm:btn-sm"
				href={ logHistoryURL(base, page.NextBefore) }
				data-older-logs
				hx-boost="false"
				if page.Before == 0 {
					x-show="olderBefore !== '0'"
					x-bind:href="olderLogsURL()"
					if page.NextBefore == 0 {
						style="display:none"
					}
				}
			>Older logs</a>
		}
		if page.Before != 0 {
			<a class="btn btn-ghost sm:btn-sm" href={ base } data-latest-logs>Latest logs</a>
		}
		<a class="btn btn-ghost sm:btn-sm" href={ exportURL } hx-boost="false">Export all logs</a>
	</div>
}
