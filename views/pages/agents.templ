package pages

import (
	"durpdeploy/internal/db"
	"durpdeploy/views/layouts"
	"strconv"
)

type AgentsView struct {
	Agents      []db.Agent
	CurrentPath string
}

type AgentDetailView struct {
	Agent       db.Agent
	Pools       []db.AgentPool
	Tags        []db.ListAgentTagsByAgentRow
	Events      []db.ListRedactedAgentEventsByAgentRow
	CurrentPath string
}

type AgentEnrollmentView struct {
	Agent       db.Agent
	Token       string
	ExpiresAt   int64
	CurrentPath string
}

templ AgentsPage(view AgentsView) {
	@layouts.Base("Agents", view.CurrentPath) {
		<div class="space-y-4">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<h1 class="text-3xl font-bold">Agents</h1>
					<p class="text-sm opacity-70">Remote workers available to receive deployments.</p>
				</div>
				if CanWrite(ctx) {
					<a href="/admin/agents/new" class="btn btn-primary btn-sm">New agent</a>
				}
			</div>
			if len(view.Agents) == 0 {
				<div class="card bg-base-200 p-8 text-center">
					<p class="text-gray-400">No agents yet.</p>
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-zebra table-fixed w-full">
						<caption class="sr-only">Remote agents</caption>
						<thead><tr><th class="w-1/3 sm:w-1/5">Agent</th><th class="hidden sm:table-cell sm:w-1/5">Name</th><th class="w-1/4 sm:w-1/6">Status</th><th class="hidden w-1/6 md:table-cell">Last heartbeat</th><th class="w-32 sm:w-48">Actions</th></tr></thead>
						<tbody>
							for _, agent := range view.Agents {
								<tr>
									<td class="truncate font-mono text-sm">{ agent.ID }</td>
									<td class="hidden truncate sm:table-cell">{ agent.Name }</td>
									<td><span class="badge badge-outline">{ agent.Status }</span></td>
									<td class="hidden whitespace-nowrap text-sm md:table-cell">
										if agent.LastHeartbeatAt.Valid {
											{ formatUnixTime(agent.LastHeartbeatAt.Int64) }
										} else {
											<span class="text-gray-500">never</span>
										}
									</td>
									<td class="whitespace-nowrap">
										<a href={ templ.SafeURL("/admin/agents/" + agent.ID) } class="btn btn-ghost btn-xs">Details</a>
										if CanWrite(ctx) {
											if agent.Status == "pending" || agent.Status == "revoked" {
												<a href={ templ.SafeURL("/admin/agents/" + agent.ID + "/enrollment") } class="btn btn-primary btn-xs">Enroll</a>
											}
											if agent.Status == "active" {
												<form method="post" action={ templ.SafeURL("/admin/agents/" + agent.ID + "/disable") } class="inline"><button type="submit" class="btn btn-error btn-xs">Disable</button></form>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ AgentFormPage(currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage("New agent", "create", "an agent", "/admin/agents", currentPath)
	} else {
		@layouts.Base("New agent", currentPath) {
			<div class="max-w-2xl">
				<h1 class="mb-4 text-3xl font-bold">New agent</h1>
				<div class="card bg-base-200 shadow"><div class="card-body">
					<form method="post" action="/admin/agents" class="space-y-4">
						<div class="form-control"><label class="label" for="agent-id"><span class="label-text">Agent ID</span></label><input id="agent-id" type="text" name="id" class="input input-bordered" autocomplete="off" required/></div>
						<div class="form-control"><label class="label" for="agent-name"><span class="label-text">Name</span></label><input id="agent-name" type="text" name="name" class="input input-bordered" required/></div>
						<div class="form-control"><label class="label" for="agent-version"><span class="label-text">Agent version <span class="text-xs opacity-70">(optional)</span></span></label><input id="agent-version" type="text" name="agent_version" class="input input-bordered"/></div>
						<div class="flex gap-2"><button type="submit" class="btn btn-primary">Create agent</button><a href="/admin/agents" class="btn btn-ghost">Cancel</a></div>
					</form>
				</div></div>
			</div>
		}
	}
}

templ AgentDetailsPage(view AgentDetailView) {
	@layouts.Base(agentDetailTitle(view.Agent), view.CurrentPath) {
		<div class="space-y-6">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<h1 class="text-3xl font-bold">{ view.Agent.Name }</h1>
					<p class="font-mono text-sm opacity-70">{ view.Agent.ID }</p>
				</div>
				<a href="/admin/agents" class="btn btn-ghost btn-sm">Back to agents</a>
			</div>
			<div class="grid gap-4 lg:grid-cols-2">
				<div class="card bg-base-200 shadow">
					<div class="card-body">
						<h2 class="card-title">Identity</h2>
						<dl class="space-y-2 text-sm">
							<div><dt class="opacity-70">Status</dt><dd><span class="badge badge-outline">{ view.Agent.Status }</span></dd></div>
							<div><dt class="opacity-70">Version</dt><dd>{ view.Agent.AgentVersion.String }</dd></div>
							<div>
								<dt class="opacity-70">Certificate fingerprint</dt>
								<dd>
									if view.Agent.CertificateFingerprint.Valid {
										<button type="button" class="btn btn-ghost btn-xs font-mono" aria-label="Copy certificate fingerprint" data-copy-value={ view.Agent.CertificateFingerprint.String } onclick="navigator.clipboard.writeText(this.dataset.copyValue)">{ abbreviatedFingerprint(view.Agent.CertificateFingerprint.String) }</button>
									} else {
										<span class="text-gray-500">Not enrolled</span>
									}
								</dd>
							</div>
						</dl>
					</div>
				</div>
				<div class="card bg-base-200 shadow">
					<div class="card-body">
						<h2 class="card-title">Pool membership</h2>
						if len(view.Pools) == 0 {
							<p class="text-sm opacity-70">This agent is not in a pool.</p>
						} else {
							<ul class="list-disc pl-5 text-sm">
								for _, pool := range view.Pools {
									<li>{ pool.Name }</li>
								}
							</ul>
						}
					</div>
				</div>
			</div>
			<div class="card bg-base-200 shadow"><div class="card-body"><h2 class="card-title">Tags</h2>
				if len(view.Tags) == 0 {
					<p class="text-sm opacity-70">No tags configured.</p>
				} else {
					<div class="flex flex-wrap gap-2">
						for _, tag := range view.Tags {
							<span class="badge badge-outline font-mono">{ tag.TagKey }={ tag.TagValue }</span>
						}
					</div>
				}
				if CanWrite(ctx) {
					<form method="post" action={ templ.SafeURL("/admin/agents/" + view.Agent.ID + "/tags") } class="mt-4 flex flex-wrap items-end gap-2"><div class="form-control"><label class="label" for="agent-tag-key"><span class="label-text">Tag key</span></label><input id="agent-tag-key" type="text" name="key" class="input input-bordered input-sm" required/></div><div class="form-control"><label class="label" for="agent-tag-value"><span class="label-text">Tag value</span></label><input id="agent-tag-value" type="text" name="value" class="input input-bordered input-sm" required/></div><button type="submit" class="btn btn-primary btn-sm">Add tag</button></form>
				}
			</div></div>
			<div class="card bg-base-200 shadow"><div class="card-body"><h2 class="card-title">Events</h2><p class="text-sm opacity-70">Event details are redacted to avoid exposing enrollment secrets.</p>
				if len(view.Events) == 0 {
					<p class="text-sm opacity-70">No events recorded.</p>
				} else {
					<div class="overflow-x-auto"><table class="table table-zebra table-fixed w-full"><caption class="sr-only">Agent events</caption><thead><tr><th class="w-1/4">Time</th><th class="w-1/4">Event</th><th class="w-1/4">Dispatch state</th><th class="w-1/4">Deployment</th></tr></thead><tbody>
						for _, event := range view.Events {
							<tr><td class="whitespace-nowrap text-sm">{ formatUnixTime(event.CreatedAt) }</td><td class="truncate">{ event.EventType }</td><td class="truncate">{ event.DispatchState.String }</td><td class="whitespace-nowrap text-sm">{ strconv.FormatInt(event.DeploymentID.Int64, 10) }</td></tr>
						}
					</tbody></table></div>
				}
			</div></div>
		</div>
	}
}

templ AgentEnrollmentPage(view AgentEnrollmentView) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage("Agent enrollment", "create", "an enrollment token", "/admin/agents", view.CurrentPath)
	} else {
		@layouts.Base("Agent enrollment", view.CurrentPath) {
			<div class="max-w-2xl space-y-4">
				<h1 class="text-3xl font-bold">Enroll { view.Agent.Name }</h1>
				if view.Token == "" {
					<div class="alert alert-warning" role="alert"><span>Generate an enrollment token only when the agent is ready. It is shown once and cannot be retrieved later.</span></div>
					<div class="card bg-base-200 shadow"><div class="card-body"><form method="post" action={ templ.SafeURL("/admin/agents/" + view.Agent.ID + "/enrollment") }><button type="submit" class="btn btn-primary">Generate enrollment token</button></form></div></div>
				} else {
					<div class="alert alert-warning" role="alert"><span>Copy this enrollment token now. It is shown only once and cannot be retrieved later.</span></div>
					<div class="card bg-base-200 shadow"><div class="card-body"><label class="label" for="enrollment-token"><span class="label-text">Enrollment token</span></label><div class="flex gap-2"><code id="enrollment-token" class="block flex-1 break-all rounded bg-base-300 p-2 font-mono select-all">{ view.Token }</code><button type="button" class="btn btn-ghost btn-sm" aria-label="Copy enrollment token" data-copy-value={ view.Token } onclick="navigator.clipboard.writeText(this.dataset.copyValue)">Copy</button></div>
						if view.ExpiresAt > 0 {
							<p class="mt-2 text-sm opacity-70">Expires { formatUnixTime(view.ExpiresAt) }.</p>
						}
						<div class="mt-4"><a href="/admin/agents" class="btn btn-primary btn-sm">Got it — don't show this again</a></div>
					</div></div>
				}
			</div>
		}
	}
}

func abbreviatedFingerprint(fingerprint string) string {
	const visible = 15
	if len(fingerprint) <= visible {
		return fingerprint
	}
	return fingerprint[:visible] + "..."
}

func agentDetailTitle(agent db.Agent) string {
	return agent.Name + " agent"
}
