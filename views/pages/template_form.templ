package pages

import (
	"encoding/json"
	"strings"

	"durpdeploy/internal/db"
	"durpdeploy/internal/interpreter"
	"durpdeploy/views/layouts"
	"durpdeploy/views/components"
	"strconv"
)

// tplVariableNamesCSV turns the stored JSON-array column into the
// comma-separated form the user edits. An empty column stays empty.
func tplVariableNamesCSV(tpl *db.StepTemplate) string {
	if tpl == nil || tpl.VariableNames == "" {
		return ""
	}
	var names []string
	if err := json.Unmarshal([]byte(tpl.VariableNames), &names); err != nil {
		return ""
	}
	return strings.Join(names, ", ")
}

// tplContainerImageShown reports whether the web form should render
// container_image. Agent templates dispatch to a remote host and must
// not carry an image, but both targets can select variables.
func tplContainerImageShown(tpl *db.StepTemplate) bool {
	if tpl == nil {
		return true
	}
	return tpl.ExecutionTarget != "agent"
}

templ TemplateForm(tpl *db.StepTemplate, isNew bool, errorMsg string, currentPath string) {
	if !CanWrite(ctx) {
		@ViewerForbiddenMessage(
			tplFormTitle(isNew),
			tplFormAction(isNew),
			"a template",
			"/templates",
			currentPath,
		)
	} else {
		@layouts.Base("Template", currentPath) {
			@TemplateFormContent(tpl, isNew, errorMsg)
		}
	}
}

func tplFormTitle(isNew bool) string {
	if isNew {
		return "New template"
	}
	return "Edit template"
}

func tplFormAction(isNew bool) string {
	if isNew {
		return "create"
	}
	return "edit"
}

templ TemplateFormFragment(tpl *db.StepTemplate, isNew bool, errorMsg string) {
	@TemplateFormContent(tpl, isNew, errorMsg)
}

templ TemplateFormContent(tpl *db.StepTemplate, isNew bool, errorMsg string) {
	@components.Breadcrumbs([]components.Crumb{
		{Label: "Home", Href: "/"},
		{Label: "Templates", Href: "/templates"},
		{Label: tplFormTitle(isNew)},
	})
	<div class="w-full">
		<div class="page-header">
			<h1 class="text-3xl font-bold">
				if isNew {
					New Template
				} else {
					Edit Template
				}
			</h1>
			if !isNew {
				<div class="flex flex-wrap gap-2">
					<button type="submit" form="template-settings-form" class="btn btn-primary md:btn-sm">Save</button>
					<a href="/templates" class="btn btn-ghost md:btn-sm" x-data="backNavigation" @click="back">Back</a>
				</div>
			}
		</div>
		<form
			if isNew {
				method="post"
				action="/templates"
			} else {
				id="template-settings-form"
				hx-put={ "/templates/" + strconv.FormatInt(tpl.ID, 10) }
				hx-target="#form-container"
				hx-swap="innerHTML"
				data-toast-success="Template updated"
				data-toast-error="Failed to update template"
			}
			class="space-y-4"
		>
			<div class="form-control">
				<label class="label" for="template-interpreter">
					<span class="label-text">Interpreter</span>
				</label>
				<select id="template-interpreter" name="interpreter" class="select select-bordered">
					<option value="bash" selected?={ tpl.Interpreter == "" || tpl.Interpreter == interpreter.Bash }>Bash</option>
					<option value="pwsh" selected?={ tpl.Interpreter == interpreter.PowerShell }>PowerShell</option>
					<option value="python3" selected?={ tpl.Interpreter == interpreter.Python }>Python</option>
				</select>
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Name</span>
				</label>
				<input type="text" name="name" value={ tpl.Name } class="input input-bordered" required/>
				if errorMsg != "" {
					<span class="text-error text-sm mt-1">{ errorMsg }</span>
				}
			</div>
			if tplContainerImageShown(tpl) {
				<div class="form-control">
					<label class="label" for="template-container-image">
						<span class="label-text">Container image</span>
					</label>
					<input
						id="template-container-image"
						type="text"
						name="container_image"
						value={ tpl.ContainerImage }
						placeholder="e.g. alpine:3.20 or registry.example.com/build:1"
						required
						class="input input-bordered"
					/>
					<label class="label"><span class="label-text-alt">Required. The web form only creates local templates that run inside a server-side container.</span></label>
				</div>
			}
			<div class="form-control">
				<label class="label" for="template-variable-names">
					<span class="label-text">Limit variables (optional)</span>
				</label>
				<input
					id="template-variable-names"
					type="text"
					name="variable_names"
					value={ tplVariableNamesCSV(tpl) }
					placeholder="comma-separated, e.g. DEPLOY_ENV, API_KEY"
					class="input input-bordered"
				/>
				<label class="label"><span class="label-text-alt">Leave empty to pass all project variables. Enter names to restrict this step.</span></label>
			</div>
			<div class="form-control">
				<label class="label">
					<span class="label-text">Script</span>
				</label>
				<textarea name="script_body" class="textarea textarea-bordered" rows="6">{ tpl.ScriptBody }</textarea>
			</div>
			if isNew {
				<div class="flex gap-2">
					<button type="submit" class="btn btn-primary">
						Create
					</button>
					<a href="/templates" class="btn btn-ghost">Cancel</a>
				</div>
			}
		</form>
	</div>
}
